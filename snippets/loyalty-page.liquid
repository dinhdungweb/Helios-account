{% comment %}
Custom code: auto customer discount
{% endcomment %}

{% assign discount_customer_tag_gold = 'GOLD' %}
{% assign discount_customer_tag_silver = 'SILVER' %}
{% assign discount_customer_tag_bronze = 'BRONZE' %}
{% assign discount_code_gold = 'LOYALTY30' %}
{% assign discount_code_silver = 'LOYALTY20' %}
{% assign discount_code_bronze = 'LOYALTY10' %}

{% if customer %}
  
  {% if customer.tags contains discount_customer_tag_gold %}
    <h2>{{ 'helios.welcome_member' | t }} {{ customer.last_name }} {{ discount_customer_tag_gold }} {{ customer.email }} {{ customer.has_avatar? }}</h2>
    <script>
      window.addEventListener('load', function() {
        var currentUrl = window.location.pathname;
        
        // Chỉ áp dụng mã giảm giá trên các trang custom discount hoặc cart, không trên checkout
        if (currentUrl === '/cart' || currentUrl === '/pages/member-club') {
          fetch("/discount/{{ discount_code_gold }}")
            .then(response => {
              if (response.ok) {
                alert(window.theme.t('discount_applied', { code: {{ discount_code_gold | json }} }));
              } else {
                alert(window.theme.t('discount_failed', { code: {{ discount_code_gold | json }} }));
              }
            })
            .catch(error => {
              console.error('Error:', error);
            });
        }
      });
      
    </script>
  {% elsif customer.tags contains discount_customer_tag_silver %}
    <h2>{{ 'helios.welcome_member' | t }} {{ discount_customer_tag_silver }}</h2>
    <script>
      window.addEventListener('load', function() {
        var currentUrl = window.location.pathname;
        
        // Chỉ áp dụng mã giảm giá trên các trang custom discount hoặc cart, không trên checkout
        if (currentUrl === '/cart' || currentUrl === '/pages/member-club') {
          fetch("/discount/{{ discount_code_silver }}")
            .then(response => {
              if (response.ok) {
                alert(window.theme.t('discount_applied', { code: {{ discount_code_silver | json }} }));
              } else {
                alert(window.theme.t('discount_failed', { code: {{ discount_code_silver | json }} }));
              }
            })
            .catch(error => {
              console.error('Error:', error);
            });
        }
      });
    </script>
  {% elsif customer.tags contains discount_customer_tag_bronze %}
    <h2>{{ 'helios.welcome_member' | t }} {{ discount_customer_tag_bronze }}</h2>{{ customer.email }}
    <script>
      window.addEventListener('load', function() {
        var currentUrl = window.location.pathname; 
        
        // Chỉ áp dụng mã giảm giá trên các trang custom discount hoặc cart, không trên checkout
        if (currentUrl === '/cart' || currentUrl === '/pages/member-club') {
          fetch("/discount/{{ discount_code_bronze }}")
            .then(response => {
              if (response.ok) {
                alert(window.theme.t('discount_applied', { code: {{ discount_code_bronze | json }} }));
              } else {
                alert(window.theme.t('discount_failed', { code: {{ discount_code_bronze | json }} }));
              }
            })
            .catch(error => {
              console.error('Error:', error);
            });
        }
      });
    </script>
  {% else %}
    <p>{{ 'helios.you_have_no_available_discount_codes' | t }}</p>
  {% endif %}
{% else %}
  <p>{{ 'helios.please_sign_in_to_use_this_feature' | t }}</p>
{% endif %}
