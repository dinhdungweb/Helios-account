<script>
  (() => {
    const sectionId = 'danang-event-{{ section.id }}';

    const initializeDanangEvent = (scope = document) => {
      const sectionElement = scope.id === sectionId ? scope : scope.querySelector(`#${sectionId}`);
      if (!sectionElement || sectionElement.dataset.scheduleInitialized === 'true') return;

      sectionElement.dataset.scheduleInitialized = 'true';
      const sliderShell = sectionElement.querySelector('[data-story-slider]');
      let sliderAutoplayId;

      if (sliderShell) {
        const slider = sliderShell.querySelector('.danang-event__gallery');
        const slides = Array.from(sliderShell.querySelectorAll('[data-story-slide]'));
        const previousButton = sliderShell.querySelector('[data-story-prev]');
        const nextButton = sliderShell.querySelector('[data-story-next]');
        const currentLabel = sliderShell.querySelector('[data-story-current]');
        const totalLabel = sliderShell.querySelector('[data-story-total]');
        const autoplayEnabled = sliderShell.dataset.autoplay === 'true';
        const autoplayDelay = Math.max(3, Number(sliderShell.dataset.autoplaySeconds) || 5) * 1000;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let scrollUpdateId;

        if (totalLabel) totalLabel.textContent = String(slides.length);

        const getCurrentIndex = () => {
          if (!slider || slides.length === 0) return 0;
          return slides.reduce((closestIndex, slide, index) => {
            const closestDistance = Math.abs(slides[closestIndex].offsetLeft - slider.scrollLeft);
            const currentDistance = Math.abs(slide.offsetLeft - slider.scrollLeft);
            return currentDistance < closestDistance ? index : closestIndex;
          }, 0);
        };

        const updateSlider = () => {
          if (currentLabel) currentLabel.textContent = String(getCurrentIndex() + 1);
        };

        const goToSlide = (index) => {
          if (!slider || slides.length === 0) return;
          const normalizedIndex = (index + slides.length) % slides.length;
          slider.scrollTo({
            left: slides[normalizedIndex].offsetLeft,
            behavior: reduceMotion.matches ? 'auto' : 'smooth'
          });
        };

        const stopAutoplay = () => window.clearInterval(sliderAutoplayId);
        const startAutoplay = () => {
          stopAutoplay();
          if (!autoplayEnabled || reduceMotion.matches || slides.length < 2) return;
          sliderAutoplayId = window.setInterval(() => goToSlide(getCurrentIndex() + 1), autoplayDelay);
        };

        previousButton?.addEventListener('click', () => {
          goToSlide(getCurrentIndex() - 1);
          startAutoplay();
        });
        nextButton?.addEventListener('click', () => {
          goToSlide(getCurrentIndex() + 1);
          startAutoplay();
        });
        slider?.addEventListener('scroll', () => {
          window.cancelAnimationFrame(scrollUpdateId);
          scrollUpdateId = window.requestAnimationFrame(updateSlider);
        }, { passive: true });
        slider?.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          goToSlide(getCurrentIndex() + (event.key === 'ArrowLeft' ? -1 : 1));
          startAutoplay();
        });
        sliderShell.addEventListener('mouseenter', stopAutoplay);
        sliderShell.addEventListener('mouseleave', startAutoplay);
        sliderShell.addEventListener('focusin', stopAutoplay);
        sliderShell.addEventListener('focusout', startAutoplay);
        sliderShell.addEventListener('pointerdown', stopAutoplay, { passive: true });
        sliderShell.addEventListener('pointerup', startAutoplay, { passive: true });

        if ('ResizeObserver' in window && slider) {
          const sliderResizeObserver = new ResizeObserver(updateSlider);
          sliderResizeObserver.observe(slider);
        }

        updateSlider();
        startAutoplay();
      }

      const cards = Array.from(sectionElement.querySelectorAll('[data-clue-card]'));
      const refreshMilliseconds = Math.max(10, Number(sectionElement.dataset.refreshSeconds) || 30) * 1000;
      const mobileMedia = window.matchMedia('(max-width: 749px)');
      let previousRevealedIds = new Set();
      let nextRevealTimeoutId;

      const getScheduledTime = (card) => {
        const timestamp = Date.parse(card.dataset.revealAt || '');
        return Number.isNaN(timestamp) ? Number.POSITIVE_INFINITY : timestamp;
      };

      const isRevealed = (card, now) => {
        if (card.dataset.previewState === 'revealed') return true;
        if (card.dataset.previewState === 'locked') return false;
        return now >= getScheduledTime(card);
      };

      const setOpen = (card, open) => {
        const button = card.querySelector('.danang-event__clue-button');
        card.classList.toggle('is-open', open);
        button?.setAttribute('aria-expanded', open ? 'true' : 'false');
      };

      const updateSchedule = () => {
        const now = Date.now();
        const revealedCards = cards.filter((card) => isRevealed(card, now));
        const revealedIds = new Set(revealedCards.map((card) => card.dataset.blockIndex));
        const newlyRevealed = revealedCards.filter((card) => !previousRevealedIds.has(card.dataset.blockIndex));

        cards.forEach((card) => {
          const revealed = revealedIds.has(card.dataset.blockIndex);
          const button = card.querySelector('.danang-event__clue-button');
          const status = card.querySelector('.danang-event__clue-status');

          card.classList.toggle('is-revealed', revealed);
          if (button) button.disabled = !revealed;
          if (status) status.textContent = revealed ? 'Nội dung đã được mở' : 'Nội dung chưa đến thời gian mở';

          if (!revealed) setOpen(card, false);
        });

        if (mobileMedia.matches) {
          const newestRevealed = revealedCards[revealedCards.length - 1];
          const target = newlyRevealed[newlyRevealed.length - 1] || (previousRevealedIds.size === 0 ? newestRevealed : null);
          if (target) {
            revealedCards.forEach((card) => setOpen(card, card === target));
          }
        } else {
          revealedCards.forEach((card) => setOpen(card, true));
        }

        previousRevealedIds = revealedIds;
      };

      const scheduleNextReveal = () => {
        window.clearTimeout(nextRevealTimeoutId);
        const now = Date.now();
        const nextTime = cards
          .filter((card) => card.dataset.previewState === 'automatic')
          .map(getScheduledTime)
          .filter((time) => Number.isFinite(time) && time > now)
          .sort((first, second) => first - second)[0];

        if (!nextTime) return;
        const maximumTimeout = 2147483647;
        nextRevealTimeoutId = window.setTimeout(() => {
          updateSchedule();
          scheduleNextReveal();
        }, Math.min(maximumTimeout, Math.max(0, nextTime - now) + 50));
      };

      cards.forEach((card) => {
        const button = card.querySelector('.danang-event__clue-button');
        button?.addEventListener('click', () => {
          if (!card.classList.contains('is-revealed')) return;

          if (mobileMedia.matches) {
            const shouldOpen = !card.classList.contains('is-open');
            cards.forEach((item) => setOpen(item, shouldOpen && item === card));
          } else {
            setOpen(card, !card.classList.contains('is-open'));
          }
        });
      });

      const handleBreakpointChange = () => {
        previousRevealedIds = new Set();
        updateSchedule();
      };

      if (typeof mobileMedia.addEventListener === 'function') {
        mobileMedia.addEventListener('change', handleBreakpointChange);
      } else {
        mobileMedia.addListener(handleBreakpointChange);
      }

      updateSchedule();
      scheduleNextReveal();
      const intervalId = window.setInterval(updateSchedule, refreshMilliseconds);

      sectionElement.addEventListener('shopify:block:select', (event) => {
        const selectedCard = event.target.closest('[data-clue-card]');
        if (!selectedCard) return;
        selectedCard.classList.add('is-revealed');
        selectedCard.querySelector('.danang-event__clue-button')?.removeAttribute('disabled');
        setOpen(selectedCard, true);
      });

      const handleSectionUnload = (event) => {
        if (event.target.id !== sectionId) return;
        window.clearInterval(intervalId);
        window.clearTimeout(nextRevealTimeoutId);
        window.clearInterval(sliderAutoplayId);
        document.removeEventListener('shopify:section:unload', handleSectionUnload);
      };

      document.addEventListener('shopify:section:unload', handleSectionUnload);
    };

    initializeDanangEvent();
    document.addEventListener('shopify:section:load', (event) => initializeDanangEvent(event.target));
  })();
</script>

