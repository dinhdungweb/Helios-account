{%- liquid
  assign hero_fallback = 'https://framerusercontent.com/images/jY718SKNEa7XnH54wYOrDdEaLbY.jpg?scale-down-to=2048&width=5922&height=2961'
  assign venue_fallback = 'https://framerusercontent.com/images/FA26GRdcEnE742dTLtZpPvsGawQ.jpg?width=1280&height=1920'
  assign map_fallback = 'https://framerusercontent.com/images/6XRMrWs5vrIBXxhcEvGRBb2Gx8.png?scale-down-to=512&width=1668&height=1086'
-%}

<section
  id="danang-event-{{ section.id }}"
  class="danang-event"
  data-danang-event
  data-refresh-seconds="{{ section.settings.refresh_seconds }}"
  style="
    --de-bg: {{ section.settings.background_color }};
    --de-text: {{ section.settings.text_color }};
    --de-accent: {{ section.settings.accent_color }};
    --de-card-radius: {{ section.settings.card_radius }}px;
    --de-max-width: {{ section.settings.max_width }}px;
  "
>
  <div class="danang-event__hero">
    {%- if section.settings.hero_image != blank -%}
      {{-
        section.settings.hero_image
        | image_url: width: 2600
        | image_tag:
          class: 'danang-event__hero-image',
          widths: '750, 1100, 1500, 2000, 2600',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.hero_title
      -}}
    {%- else -%}
      <img
        class="danang-event__hero-image"
        src="{{ hero_fallback }}"
        alt="{{ section.settings.hero_title | escape }}"
        width="2400"
        height="1200"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="danang-event__content">
    {%- if section.settings.hero_title != blank -%}
      <h1 class="danang-event__title">{{ section.settings.hero_title | escape }}</h1>
    {%- endif -%}

    <div class="danang-event__story">
      <div class="danang-event__story-copy">
        <div class="danang-event__product-copy">
          {%- if section.settings.product_title != blank or section.settings.product_subtitle != blank -%}
            <h2 class="danang-event__product-heading">
              {%- if section.settings.product_title != blank -%}
                <span class="danang-event__product-title">{{ section.settings.product_title | escape }}</span>
              {%- endif -%}
              {%- if section.settings.product_subtitle != blank -%}
                <span class="danang-event__product-subtitle">{{ section.settings.product_subtitle | escape }}</span>
              {%- endif -%}
            </h2>
          {%- endif -%}
          {%- if section.settings.product_description != blank -%}
            <div class="danang-event__small-copy rte">{{ section.settings.product_description }}</div>
          {%- endif -%}
        </div>

        <div class="danang-event__date-copy">
          <p class="danang-event__event-date">{{ section.settings.event_date | escape }}</p>
          <p class="danang-event__event-time">{{ section.settings.event_time | escape }}</p>
        </div>

        <div class="danang-event__location-copy">
          {%- if section.settings.location_intro != blank -%}
            <p>{{ section.settings.location_intro | escape }}</p>
          {%- endif -%}
          {%- if section.settings.location_address != blank -%}
            <p>{{ section.settings.location_address | newline_to_br }}</p>
          {%- endif -%}
        </div>

        <div class="danang-event__meeting-copy">
          {%- if section.settings.meeting_title != blank -%}
            <h2 class="danang-event__meeting-title">{{ section.settings.meeting_title | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.meeting_description != blank -%}
            <div class="danang-event__small-copy rte">{{ section.settings.meeting_description }}</div>
          {%- endif -%}
        </div>
      </div>

      <div
        class="danang-event__gallery-shell"
        data-story-slider
        data-autoplay="{{ section.settings.story_autoplay }}"
        data-autoplay-seconds="{{ section.settings.story_autoplay_seconds }}"
      >
        <div
          id="danang-story-slider-{{ section.id }}"
          class="danang-event__gallery"
          aria-label="Hình ảnh hành trình"
          role="region"
          tabindex="0"
        >
          {%- for image_index in (1..4) -%}
            {%- liquid
              assign image_key = 'story_image_' | append: image_index
              assign story_image = section.settings[image_key]
              case image_index
                when 1
                  assign story_fallback = 'https://framerusercontent.com/images/VvOiW84uaBUDv1cuLOoZyD0ik.jpg?scale-down-to=512&width=2368&height=2961'
                when 2
                  assign story_fallback = 'https://framerusercontent.com/images/qlgbbNxkZIJzUVB2B1pRQ9kiHs.jpg?scale-down-to=512&width=1014&height=1014'
                when 3
                  assign story_fallback = 'https://framerusercontent.com/images/BOEl7KUaTgOI9TbjAExt0RKbI.jpg?scale-down-to=512&width=2961&height=4441'
                else
                  assign story_fallback = 'https://framerusercontent.com/images/85DyDHWeAHx4Dj19UZ0HLXdlucU.jpg?scale-down-to=512&width=3899&height=4874'
              endcase
            -%}
            <div class="danang-event__gallery-item" data-story-slide>
              {%- if story_image != blank -%}
                {{-
                  story_image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'danang-event__gallery-image',
                    widths: '360, 540, 720, 1000',
                    sizes: '(min-width: 750px) 36vw, 82vw',
                    loading: 'lazy',
                    alt: story_image.alt
                -}}
              {%- else -%}
                <img
                  class="danang-event__gallery-image"
                  src="{{ story_fallback }}"
                  alt=""
                  width="700"
                  height="900"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="danang-event__gallery-controls">
          <button
            type="button"
            class="danang-event__gallery-button"
            data-story-prev
            aria-controls="danang-story-slider-{{ section.id }}"
            aria-label="Ảnh trước"
          >
            <span aria-hidden="true">{% render 'svg-chevron-left' %}</span>
          </button>
          <span class="danang-event__gallery-count" aria-live="polite">
            <span data-story-current>1</span>
            <span aria-hidden="true">/</span>
            <span data-story-total>4</span>
          </span>
          <button
            type="button"
            class="danang-event__gallery-button"
            data-story-next
            aria-controls="danang-story-slider-{{ section.id }}"
            aria-label="Ảnh tiếp theo"
          >
            <span aria-hidden="true">{% render 'svg-chevron-right' %}</span>
          </button>
        </div>
      </div>
    </div>

    {%- if section.settings.statement != blank -%}
      <h2 class="danang-event__statement">{{ section.settings.statement | escape | newline_to_br }}</h2>
    {%- endif -%}

    <div class="danang-event__clues">
      {%- if section.settings.clues_heading != blank -%}
        <h2 class="danang-event__clues-heading">{{ section.settings.clues_heading | escape }}</h2>
      {%- endif -%}

      <div class="danang-event__clue-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            case forloop.index
              when 1
                assign default_back_image = 'https://framerusercontent.com/images/AEtzKlb3rqUp5d9rxlbTmgvk0.png?scale-down-to=1024&width=1002&height=1251'
              when 2
                assign default_back_image = 'https://framerusercontent.com/images/m5Ryu9qm3EBWXQRfl2W6E7GRQE.png?scale-down-to=1024&width=1002&height=1251'
              else
                assign default_back_image = 'https://framerusercontent.com/images/EkqGIsEHqvKfVNf1GJNUD0As.png?scale-down-to=1024&width=1002&height=1251'
            endcase
            assign default_front_image = 'https://framerusercontent.com/images/WsyzbvqlxOAWCNKbEabLvpMED0.png?scale-down-to=1024&width=2506&height=3301'
          -%}

          <article
            class="danang-event__clue"
            data-clue-card
            data-reveal-at="{{ block.settings.reveal_at | escape }}"
            data-preview-state="{{ block.settings.preview_state }}"
            data-block-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <button
              class="danang-event__clue-button"
              type="button"
              aria-expanded="false"
              aria-label="{{ block.settings.accessible_label | default: block.settings.date_label | escape }}"
              disabled
            >
              <span class="danang-event__clue-inner">
                <span class="danang-event__clue-face danang-event__clue-face--front">
                  {%- if block.settings.front_image != blank -%}
                    {{-
                      block.settings.front_image
                      | image_url: width: 1000
                      | image_tag:
                        class: 'danang-event__clue-image',
                        widths: '360, 540, 720, 1000',
                        sizes: '(min-width: 750px) 30vw, 100vw',
                        loading: 'lazy',
                        alt: ''
                    -}}
                  {%- else -%}
                    <img class="danang-event__clue-image" src="{{ default_front_image }}" alt="" width="1000" height="1320" loading="lazy">
                  {%- endif -%}
                  <span class="danang-event__clue-front-copy">
                    <span>{{ block.settings.front_label | escape }}</span>
                    <strong>{{ block.settings.date_label | escape }}</strong>
                  </span>
                </span>

                <span class="danang-event__clue-face danang-event__clue-face--back">
                  {%- if block.settings.back_image != blank -%}
                    {{-
                      block.settings.back_image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'danang-event__clue-image',
                        widths: '360, 540, 720, 1000, 1200',
                        sizes: '(min-width: 750px) 30vw, 100vw',
                        loading: 'lazy',
                        alt: block.settings.back_image.alt
                    -}}
                  {%- else -%}
                    <img class="danang-event__clue-image" src="{{ default_back_image }}" alt="" width="1000" height="1250" loading="lazy">
                  {%- endif -%}
                  <span class="danang-event__clue-arrow" aria-hidden="true">&#8594;</span>
                </span>
              </span>
            </button>
            <p class="danang-event__clue-status" aria-live="polite"></p>
          </article>
        {%- endfor -%}
      </div>

      <div class="danang-event__clue-footer">
        {%- if section.settings.clue_footer_heading != blank -%}
          <h2>{{ section.settings.clue_footer_heading | escape }}</h2>
        {%- endif -%}
        <div class="danang-event__buttons">
          {%- if section.settings.club_label != blank -%}
            <a class="danang-event__button" href="{{ section.settings.club_link | default: '#' }}">
              {{ section.settings.club_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.website_label != blank -%}
            <a class="danang-event__button" href="{{ section.settings.website_link | default: '#' }}">
              {{ section.settings.website_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="danang-event__venue">
      <div class="danang-event__venue-background" aria-hidden="true">
        {%- if section.settings.venue_image != blank -%}
          {{-
            section.settings.venue_image
            | image_url: width: 2200
            | image_tag:
              class: 'danang-event__venue-image',
              widths: '750, 1100, 1500, 2200',
              sizes: '100vw',
              loading: 'lazy',
              alt: ''
          -}}
        {%- else -%}
          <img class="danang-event__venue-image" src="{{ venue_fallback }}" alt="" width="1280" height="1920" loading="lazy">
        {%- endif -%}
      </div>

      <div class="danang-event__venue-content">
        <div class="danang-event__venue-copy">
          <h2>{{ section.settings.venue_heading | escape }}</h2>
          <p class="danang-event__venue-name">{{ section.settings.venue_name | escape }}</p>
          <p class="danang-event__venue-date">{{ section.settings.venue_date | escape }}</p>
          <p class="danang-event__venue-note">{{ section.settings.venue_note | escape }}</p>
          {%- if section.settings.venue_highlight != blank -%}
            <p class="danang-event__venue-highlight">{{ section.settings.venue_highlight | escape }}</p>
          {%- endif -%}

          <div class="danang-event__venue-links">
            {%- if section.settings.booking_label != blank -%}
              <a href="{{ section.settings.booking_link | default: '#' }}">{{ section.settings.booking_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.club_small_label != blank -%}
              <a href="{{ section.settings.club_link | default: '#' }}">{{ section.settings.club_small_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>

        <div class="danang-event__map">
          {%- if section.settings.map_image != blank -%}
            {{-
              section.settings.map_image
              | image_url: width: 1200
              | image_tag:
                class: 'danang-event__map-image',
                widths: '360, 540, 720, 1000, 1200',
                sizes: '(min-width: 750px) 40vw, 100vw',
                loading: 'lazy',
                alt: section.settings.venue_name
            -}}
          {%- else -%}
            <img class="danang-event__map-image" src="{{ map_fallback }}" alt="{{ section.settings.venue_name | escape }}" width="1000" height="650" loading="lazy">
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  #danang-event-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    background: var(--de-bg);
    color: var(--de-text);
  }

  #danang-event-{{ section.id }} *,
  #danang-event-{{ section.id }} *::before,
  #danang-event-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #danang-event-{{ section.id }} .danang-event__hero {
    position: relative;
    width: 100%;
    min-height: clamp(420px, 48vw, 680px);
    overflow: hidden;
    background: #090909;
  }

  #danang-event-{{ section.id }} .danang-event__hero-image,
  #danang-event-{{ section.id }} .danang-event__venue-image,
  #danang-event-{{ section.id }} .danang-event__gallery-image,
  #danang-event-{{ section.id }} .danang-event__clue-image,
  #danang-event-{{ section.id }} .danang-event__map-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #danang-event-{{ section.id }} .danang-event__hero-image {
    position: absolute;
    inset: 0;
    object-position: center;
  }

  #danang-event-{{ section.id }} .danang-event__content {
    width: 100%;
    background: var(--de-bg);
  }

  #danang-event-{{ section.id }} .danang-event__title {
    width: min(100% - 40px, var(--de-max-width));
    margin: 0 auto;
    padding: clamp(40px, 6vw, 76px) 0 clamp(28px, 4vw, 52px);
    font-size: clamp(34px, 5.5vw, 66px);
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }

  #danang-event-{{ section.id }} .danang-event__story {
    display: grid;
    grid-template-columns: minmax(400px, 0.82fr) minmax(0, 1.6fr);
    gap: clamp(36px, 5vw, 72px);
    width: min(100% - 40px, var(--de-max-width));
    margin: 0 auto;
    padding-bottom: clamp(70px, 9vw, 120px);
  }

  #danang-event-{{ section.id }} .danang-event__story-copy {
    display: grid;
    grid-template-columns: 0.45fr 0.55fr;
    gap: 28px 34px;
    align-content: center;
  }

  #danang-event-{{ section.id }} .danang-event__product-copy,
  #danang-event-{{ section.id }} .danang-event__meeting-copy {
    grid-column: 1 / -1;
  }

  #danang-event-{{ section.id }} .danang-event__product-heading,
  #danang-event-{{ section.id }} .danang-event__event-date,
  #danang-event-{{ section.id }} .danang-event__event-time,
  #danang-event-{{ section.id }} .danang-event__meeting-title,
  #danang-event-{{ section.id }} .danang-event__location-copy p {
    margin: 0;
  }

  #danang-event-{{ section.id }} .danang-event__product-heading,
  #danang-event-{{ section.id }} .danang-event__meeting-title,
  #danang-event-{{ section.id }} .danang-event__venue-copy h2 {
    text-align: left;
  }

  #danang-event-{{ section.id }} .danang-event__product-title,
  #danang-event-{{ section.id }} .danang-event__product-subtitle {
    display: block;
    color: var(--de-accent);
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }

  #danang-event-{{ section.id }} .danang-event__product-title {
    font-size: clamp(28px, 3.2vw, 44px);
  }

  #danang-event-{{ section.id }} .danang-event__product-subtitle {
    margin-top: 2px;
    font-size: clamp(20px, 2.2vw, 30px);
  }

  #danang-event-{{ section.id }} .danang-event__small-copy,
  #danang-event-{{ section.id }} .danang-event__small-copy p,
  #danang-event-{{ section.id }} .danang-event__location-copy {
    margin: 12px 0 0;
    color: var(--de-text);
    font-size: 16px;
    line-height: 1.35;
  }

  #danang-event-{{ section.id }} .danang-event__event-date,
  #danang-event-{{ section.id }} .danang-event__meeting-title {
    font-size: 27px;
    font-weight: 700;
    line-height: 1.1;
  }

  #danang-event-{{ section.id }} .danang-event__event-time {
    margin-top: 14px;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
  }

  #danang-event-{{ section.id }} .danang-event__location-copy {
    margin-top: 4px;
  }

  #danang-event-{{ section.id }} .danang-event__meeting-copy {
    margin-top: 12px;
  }

  #danang-event-{{ section.id }} .danang-event__gallery {
    display: flex;
    gap: 0;
    height: clamp(530px, 54vw, 640px);
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  #danang-event-{{ section.id }} .danang-event__gallery-shell {
    position: relative;
    min-width: 0;
  }

  #danang-event-{{ section.id }} .danang-event__gallery::-webkit-scrollbar {
    display: none;
  }

  #danang-event-{{ section.id }} .danang-event__gallery-item {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  #danang-event-{{ section.id }} .danang-event__gallery-item:nth-child(even) {
    transform: none;
  }

  #danang-event-{{ section.id }} .danang-event__gallery-image {
    object-position: center;
  }

  #danang-event-{{ section.id }} .danang-event__gallery-controls {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  #danang-event-{{ section.id }} .danang-event__gallery-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    min-width: 42px;
    height: 42px;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    font: inherit;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    pointer-events: auto;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  #danang-event-{{ section.id }} .danang-event__gallery-button[data-story-prev] {
    left: 16px;
  }

  #danang-event-{{ section.id }} .danang-event__gallery-button[data-story-next] {
    right: 16px;
  }

  #danang-event-{{ section.id }} .danang-event__gallery-button svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  #danang-event-{{ section.id }} .danang-event__gallery-button:hover,
  #danang-event-{{ section.id }} .danang-event__gallery-button:focus-visible {
    background: #fff;
    color: #000;
    transform: translateY(-50%) scale(1.06);
  }

  #danang-event-{{ section.id }} .danang-event__gallery-count {
    position: absolute;
    bottom: 16px;
    left: 50%;
    display: inline-flex;
    gap: 4px;
    align-items: center;
    min-height: 30px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.58);
    color: #fff;
    font-size: 13px;
    line-height: 1;
    transform: translateX(-50%);
  }

  #danang-event-{{ section.id }} .danang-event__statement {
    display: grid;
    place-items: center;
    min-height: clamp(480px, 62vw, 760px);
    width: min(100% - 40px, 900px);
    margin: 0 auto;
    font-size: clamp(36px, 5vw, 58px);
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }

  #danang-event-{{ section.id }} .danang-event__clues {
    width: 100%;
    padding: clamp(46px, 6vw, 82px) 20px clamp(60px, 7vw, 96px);
  }

  #danang-event-{{ section.id }} .danang-event__clues-heading {
    width: min(100%, var(--de-max-width));
    margin: 0 auto clamp(34px, 4vw, 52px);
    font-size: clamp(34px, 4.4vw, 54px);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
  }

  #danang-event-{{ section.id }} .danang-event__clue-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 5vw, 62px);
    width: min(100%, 1000px);
    margin: 0 auto;
  }

  #danang-event-{{ section.id }} .danang-event__clue {
    min-width: 0;
  }

  #danang-event-{{ section.id }} .danang-event__clue-button {
    display: block;
    width: 100%;
    aspect-ratio: 1002 / 1408;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--de-card-radius);
    background: transparent;
    color: inherit;
    perspective: 1200px;
    cursor: pointer;
  }

  #danang-event-{{ section.id }} .danang-event__clue-button:disabled {
    cursor: default;
  }

  #danang-event-{{ section.id }} .danang-event__clue-button:focus-visible {
    outline: 2px solid var(--de-accent);
    outline-offset: 4px;
  }

  #danang-event-{{ section.id }} .danang-event__clue-inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 800ms cubic-bezier(.2, .8, .2, 1);
  }

