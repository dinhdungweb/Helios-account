{%- liquid
  assign media_count = section.blocks.size
  assign is_carousel = false
  if media_count > 2
    assign is_carousel = true
  endif

  assign media_width = 100 | minus: section.settings.text_width
-%}

{% style %}
  #MultiMediaText-{{ section.id }} {
    --mmt-background: {{ section.settings.background_color }};
    --mmt-text: {{ section.settings.text_color }};
    --mmt-heading: {{ section.settings.heading_color }};
    --mmt-accent: {{ section.settings.accent_color }};
    --mmt-button-background: {{ section.settings.button_background }};
    --mmt-button-text: {{ section.settings.button_text_color }};
    --mmt-button-border: {{ section.settings.button_border_color }};
    --mmt-container: {{ section.settings.container_width }}px;
    --mmt-text-width: {{ section.settings.text_width }}%;
    --mmt-media-width: {{ media_width }}%;
    --mmt-column-gap: {{ section.settings.column_gap }}px;
    --mmt-media-gap: {{ section.settings.media_gap }}px;
    --mmt-radius: {{ section.settings.media_radius }}px;
    --mmt-heading-size: {{ section.settings.heading_size }}px;
    --mmt-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --mmt-body-size: {{ section.settings.body_size }}px;
    --mmt-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --mmt-section-padding-top: {{ section.settings.padding_top }}px;
    --mmt-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --mmt-section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --mmt-section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --mmt-side-padding: {{ section.settings.side_padding }}px;
    --mmt-side-padding-mobile: {{ section.settings.side_padding_mobile }}px;
    --mmt-text-max-width: {{ section.settings.text_max_width }}px;
    --mmt-content-gap-mobile: {{ section.settings.content_gap_mobile }}px;
    --mmt-media-ratio: {{ section.settings.media_ratio }};
    --mmt-media-ratio-mobile: {{ section.settings.media_ratio_mobile }};
  }
{% endstyle %}

<section
  id="MultiMediaText-{{ section.id }}"
  class="mmt mmt--media-{{ section.settings.media_position }}"
  data-mmt-section
  data-autoplay="{{ section.settings.carousel_autoplay }}"
  data-autoplay-speed="{{ section.settings.carousel_autoplay_speed | times: 1000 }}"
  data-transition-duration="{{ section.settings.carousel_transition_duration }}"
  aria-label="{{ section.settings.heading | default: 'Multi media with text' | strip_html | escape }}"
>
  <div class="mmt__container{% if section.settings.full_width %} mmt__container--full{% endif %}">
    <div class="mmt__text mmt__text--{{ section.settings.text_alignment }} mmt__text--vertical-{{ section.settings.text_vertical_alignment }}">
      <div class="mmt__text-inner">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mmt__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="mmt__heading">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="mmt__body rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            class="mmt__button mmt__button--{{ section.settings.button_style }}"
            href="{{ section.settings.button_link | default: '#' }}"
            {% if section.settings.button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="mmt__media"{% if is_carousel %} data-mmt-carousel{% endif %}>
      <div class="mmt__carousel-frame">
        <div
          id="MultiMediaViewport-{{ section.id }}"
          class="mmt__viewport{% unless is_carousel %} mmt__viewport--static{% endunless %}"
          {% if is_carousel %}tabindex="0" aria-roledescription="carousel"{% endif %}
        >
          <div class="mmt__track{% unless is_carousel %} mmt__track--static mmt__track--count-{{ media_count }}{% endunless %}" data-mmt-track>
          {%- for block in section.blocks -%}
            {%- liquid
              assign block_image = block.settings.image
              assign block_alt = block.settings.alt_text
              if block_alt == blank and block.settings.image.alt != blank
                assign block_alt = block.settings.image.alt
              endif
              if block_alt == blank
                assign block_alt = section.settings.heading | strip_html
              endif
              if block.settings.media_type == 'video' and block.settings.video.preview_image != blank
                assign block_image = block.settings.video.preview_image
              endif
              if block.settings.poster != blank
                assign block_image = block.settings.poster
              endif
              assign poster_url = blank
              if block_image != blank
                assign poster_url = block_image | image_url: width: 1600
              endif
              assign render_media_link = false
              if block.settings.link != blank and block.settings.media_type == 'image'
                assign render_media_link = true
              endif
            -%}
            <div
              class="mmt__slide"
              data-mmt-slide
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {%- capture media_content -%}
                {%- if block.settings.media_type == 'video' and block.settings.video != blank -%}
                  <div class="mmt__video-wrap" data-mmt-video data-poster-time="{{ block.settings.poster_time }}">
                    <video
                      class="mmt__video"
                      playsinline
                      preload="{% if section.settings.video_autoplay %}metadata{% else %}auto{% endif %}"
                      tabindex="0"
                      aria-label="{{ block_alt | escape }}"
                      {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
                      {% if section.settings.video_autoplay %}autoplay{% endif %}
                      {% if section.settings.video_loop %}loop{% endif %}
                      {% if section.settings.video_muted %}muted{% endif %}
                    >
                      {% # theme-check-disable RemoteAsset %}
                      {%- for source in block.settings.video.sources -%}
                        <source src="{{ source.url | escape }}" type="{{ source.mime_type | escape }}">
                      {%- endfor -%}
                      {% # theme-check-enable RemoteAsset %}
                    </video>

                    {%- if block_image != blank -%}
                      {{- block_image
                        | image_url: width: 1600
                        | image_tag:
                          class: 'mmt__video-poster',
                          widths: '360, 540, 720, 900, 1200, 1600',
                          sizes: '(min-width: 750px) 42vw, 50vw',
                          loading: 'lazy',
                          alt: block_alt
                      -}}
                    {%- endif -%}

                    {%- if section.settings.video_autoplay == false and section.settings.video_controls -%}
                      <button class="mmt__video-play" type="button" data-mmt-video-play aria-label="Phát video">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                      </button>
                    {%- endif -%}
                  </div>
                {%- elsif block.settings.image != blank -%}
                  {{- block.settings.image
                    | image_url: width: 1800
                    | image_tag:
                      class: 'mmt__image',
                      widths: '360, 540, 720, 900, 1200, 1500, 1800',
                      sizes: '(min-width: 750px) 42vw, 100vw',
                      loading: 'lazy',
                      alt: block_alt
                  -}}
                {%- else -%}
                  <div class="mmt__placeholder">
                    {{ 'image' | placeholder_svg_tag: 'mmt__placeholder-svg' }}
                  </div>
                {%- endif -%}
              {%- endcapture -%}

              {%- if render_media_link -%}
                <a
                  class="mmt__media-link"
                  href="{{ block.settings.link }}"
                  {% if block.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                  aria-label="{{ block.settings.link_label | default: block_alt | strip_html | escape }}"
                >
                  {{ media_content }}
                </a>
              {%- else -%}
                {{ media_content }}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="mmt__slide">
              <div class="mmt__placeholder">
                {{ 'image' | placeholder_svg_tag: 'mmt__placeholder-svg' }}
              </div>
            </div>
          {%- endfor -%}
          </div>
        </div>

        {%- if is_carousel and section.settings.show_arrows -%}
          <div class="mmt__arrows">
            <button class="mmt__arrow mmt__arrow--prev" type="button" data-mmt-prev aria-controls="MultiMediaViewport-{{ section.id }}" aria-label="Media trước">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button class="mmt__arrow mmt__arrow--next" type="button" data-mmt-next aria-controls="MultiMediaViewport-{{ section.id }}" aria-label="Media tiếp theo">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      {%- if is_carousel and section.settings.show_dots -%}
        <div class="mmt__dots mmt__dots--{{ section.settings.controls_position }}" data-mmt-dots aria-label="Chọn media">
          {%- for block in section.blocks -%}
            <button
              class="mmt__dot{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-mmt-dot="{{ forloop.index0 }}"
              aria-label="Xem media {{ forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #MultiMediaText-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    color: var(--mmt-text);
    background: var(--mmt-background);
  }

  #MultiMediaText-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MultiMediaText-{{ section.id }} .mmt__container {
    display: flex;
    width: 100%;
    max-width: calc(var(--mmt-container) + (var(--mmt-side-padding) * 2));
    min-height: {{ section.settings.min_height }}px;
    margin-inline: auto;
    padding: var(--mmt-section-padding-top) var(--mmt-side-padding) var(--mmt-section-padding-bottom);
    gap: var(--mmt-column-gap);
  }

  #MultiMediaText-{{ section.id }} .mmt__container--full {
    max-width: none;
  }

  #MultiMediaText-{{ section.id }}.mmt--media-right .mmt__text {
    order: 1;
  }

  #MultiMediaText-{{ section.id }}.mmt--media-right .mmt__media {
    order: 2;
  }

  #MultiMediaText-{{ section.id }}.mmt--media-left .mmt__media {
    order: 1;
  }

  #MultiMediaText-{{ section.id }}.mmt--media-left .mmt__text {
    order: 2;
  }

  #MultiMediaText-{{ section.id }} .mmt__text {
    display: flex;
    flex: 0 0 var(--mmt-text-width);
    min-width: 0;
  }

  #MultiMediaText-{{ section.id }} .mmt__text--vertical-top {
    align-items: flex-start;
  }

  #MultiMediaText-{{ section.id }} .mmt__text--vertical-center {
    align-items: center;
  }

  #MultiMediaText-{{ section.id }} .mmt__text--vertical-bottom {
    align-items: flex-end;
  }

  #MultiMediaText-{{ section.id }} .mmt__text-inner {
    width: 100%;
    max-width: var(--mmt-text-max-width);
  }

  #MultiMediaText-{{ section.id }} .mmt__text--left .mmt__text-inner {
    margin-right: auto;
    text-align: left;
  }

  #MultiMediaText-{{ section.id }} .mmt__text--center .mmt__text-inner {
    margin-inline: auto;
    text-align: center;
  }

  #MultiMediaText-{{ section.id }} .mmt__text--right .mmt__text-inner {
    margin-left: auto;
    text-align: right;
  }

  #MultiMediaText-{{ section.id }} .mmt__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_spacing }}px;
    color: var(--mmt-accent);
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: {{ section.settings.eyebrow_weight }};
    line-height: 1.3;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing | divided_by: 10.0 }}px;
    text-transform: {{ section.settings.eyebrow_transform }};
  }

  #MultiMediaText-{{ section.id }} .mmt__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: var(--mmt-heading);
    font-size: var(--mmt-heading-size);
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 10.0 }}px;
  }

  #MultiMediaText-{{ section.id }} .mmt__body,
  #MultiMediaText-{{ section.id }} .mmt__body p {
    color: var(--mmt-text);
    font-size: var(--mmt-body-size);
    line-height: {{ section.settings.body_line_height | divided_by: 100.0 }};
  }

  #MultiMediaText-{{ section.id }} .mmt__body {
    margin: 0;
  }

  #MultiMediaText-{{ section.id }} .mmt__body > *:first-child {
    margin-top: 0;
  }

  #MultiMediaText-{{ section.id }} .mmt__body > *:last-child {
    margin-bottom: 0;
  }

  #MultiMediaText-{{ section.id }} .mmt__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.button_height }}px;
    margin-top: {{ section.settings.button_spacing }}px;
    padding: 8px {{ section.settings.button_horizontal_padding }}px;
    border: 1px solid var(--mmt-button-border);
    border-radius: {{ section.settings.button_radius }}px;
    font-size: {{ section.settings.button_size }}px;
    font-weight: {{ section.settings.button_weight }};
    line-height: 1.2;
    text-decoration: none;
    transition: opacity 180ms ease, color 180ms ease, background-color 180ms ease;
  }

  #MultiMediaText-{{ section.id }} .mmt__button--solid {
    color: var(--mmt-button-text);
    background: var(--mmt-button-background);
  }

  #MultiMediaText-{{ section.id }} .mmt__button--outline {
    color: var(--mmt-button-border);
    background: transparent;
  }

  #MultiMediaText-{{ section.id }} .mmt__button--link {
    min-height: auto;
    padding: 3px 0;
    border-width: 0 0 1px;
    border-radius: 0;
    color: var(--mmt-button-border);
    background: transparent;
  }

  #MultiMediaText-{{ section.id }} .mmt__button:hover {
    opacity: 0.75;
  }

  #MultiMediaText-{{ section.id }} .mmt__media {
    position: relative;
    flex: 1 1 var(--mmt-media-width);
    min-width: 0;
  }

  #MultiMediaText-{{ section.id }} .mmt__carousel-frame {
    position: relative;
    min-width: 0;
  }

  #MultiMediaText-{{ section.id }} .mmt__viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  #MultiMediaText-{{ section.id }} .mmt__viewport::-webkit-scrollbar {
    display: none;
  }

  #MultiMediaText-{{ section.id }} .mmt__viewport--static {
    overflow: visible;
    scroll-snap-type: none;
  }

  #MultiMediaText-{{ section.id }} .mmt__viewport.is-animating {
    scroll-snap-type: none;
  }

  #MultiMediaText-{{ section.id }} .mmt__track {
    display: flex;
    gap: var(--mmt-media-gap);
  }

  #MultiMediaText-{{ section.id }} [data-mmt-carousel] .mmt__slide {
    flex: 0 0 calc((100% - var(--mmt-media-gap)) / 2);
    scroll-snap-align: start;
  }

  #MultiMediaText-{{ section.id }} .mmt__track--static .mmt__slide {
    flex: 1 1 0;
  }

  #MultiMediaText-{{ section.id }} .mmt__track--count-1 .mmt__slide {
    flex-basis: 100%;
  }

  #MultiMediaText-{{ section.id }} .mmt__slide,
  #MultiMediaText-{{ section.id }} .mmt__media-link {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--mmt-radius);
    background: {{ section.settings.media_background }};
  }

  #MultiMediaText-{{ section.id }} .mmt__slide {
    aspect-ratio: var(--mmt-media-ratio);
  }

  #MultiMediaText-{{ section.id }} .mmt__media-link {
    width: 100%;
    height: 100%;
  }

  #MultiMediaText-{{ section.id }} .mmt__image,
  #MultiMediaText-{{ section.id }} .mmt__video-wrap,
  #MultiMediaText-{{ section.id }} .mmt__video,
  #MultiMediaText-{{ section.id }} .mmt__placeholder,
  #MultiMediaText-{{ section.id }} .mmt__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #MultiMediaText-{{ section.id }} .mmt__video-wrap {
    position: relative;
    overflow: hidden;
  }

  #MultiMediaText-{{ section.id }} .mmt__video {
    position: relative;
    z-index: 0;
    {% if section.settings.video_autoplay == false and section.settings.video_controls %}
      cursor: pointer;
    {% endif %}
  }

  #MultiMediaText-{{ section.id }} .mmt__video-poster {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.media_fit }};
    opacity: 1;
    visibility: visible;
    transition: opacity 220ms ease, visibility 220ms ease;
    pointer-events: none;
  }

  #MultiMediaText-{{ section.id }} .mmt__video-wrap.has-started .mmt__video-poster {
    opacity: 0;
    visibility: hidden;
  }

  #MultiMediaText-{{ section.id }} .mmt__image,
  #MultiMediaText-{{ section.id }} .mmt__video {
    object-fit: {{ section.settings.media_fit }};
  }

  #MultiMediaText-{{ section.id }} .mmt__placeholder-svg {
    opacity: 0.35;
  }

  #MultiMediaText-{{ section.id }} .mmt__video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.62);
    box-shadow: 0 5px 22px rgba(0, 0, 0, 0.28);
    transform: translate(-50%, -50%);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    cursor: pointer;
  }

  #MultiMediaText-{{ section.id }} .mmt__video-play:hover {
    transform: translate(-50%, -50%) scale(1.07);
  }

  #MultiMediaText-{{ section.id }} .mmt__video-play svg {
    width: 30px;
    height: 30px;
    margin-left: 3px;
    fill: currentColor;
  }

  #MultiMediaText-{{ section.id }} .mmt__video-wrap.is-playing .mmt__video-play {
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.86);
    pointer-events: none;
  }

  #MultiMediaText-{{ section.id }} .mmt__arrows {
    position: absolute;
    top: 50%;
    right: {{ section.settings.arrow_inset }}px;
    left: {{ section.settings.arrow_inset }}px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transform: translateY(-50%);
    pointer-events: none;
  }

  #MultiMediaText-{{ section.id }} .mmt__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    padding: 0;
    border: 0;
    border-radius: {{ section.settings.arrow_radius }}%;
    color: {{ section.settings.control_color }};
    background: {{ section.settings.control_background }};
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
    transition: opacity 180ms ease, transform 180ms ease, background-color 180ms ease;
    pointer-events: auto;
  }

  #MultiMediaText-{{ section.id }} .mmt__arrow:hover {
    opacity: 0.82;
    transform: scale(1.06);
  }

  #MultiMediaText-{{ section.id }} .mmt__arrow:active {
    transform: scale(0.94);
  }

  #MultiMediaText-{{ section.id }} .mmt__arrow svg {
    width: 50%;
    height: 50%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  #MultiMediaText-{{ section.id }} .mmt__dots {
    display: flex;
    gap: 8px;
    margin-top: {{ section.settings.controls_spacing }}px;
  }

  #MultiMediaText-{{ section.id }} .mmt__dots--left {
    justify-content: flex-start;
  }

  #MultiMediaText-{{ section.id }} .mmt__dots--center {
    justify-content: center;
  }

  #MultiMediaText-{{ section.id }} .mmt__dots--right {
    justify-content: flex-end;
  }

  #MultiMediaText-{{ section.id }} .mmt__dot {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    opacity: 0.35;
    background: {{ section.settings.control_color }};
    cursor: pointer;
  }

  #MultiMediaText-{{ section.id }} .mmt__dot.is-active {
    opacity: 1;
  }

  #MultiMediaText-{{ section.id }} .mmt__dot[hidden] {
    display: none;
  }

  @media (max-width: 749px) {
    #MultiMediaText-{{ section.id }} .mmt__container {
      flex-direction: column;
      min-height: 0;
      padding: var(--mmt-section-padding-top-mobile) var(--mmt-side-padding-mobile) var(--mmt-section-padding-bottom-mobile);
      gap: var(--mmt-content-gap-mobile);
    }

    #MultiMediaText-{{ section.id }} .mmt__text,
    #MultiMediaText-{{ section.id }}.mmt--media-left .mmt__text,
    #MultiMediaText-{{ section.id }}.mmt--media-right .mmt__text {
      order: 1;
      flex: 0 0 auto;
      width: 100%;
    }

    #MultiMediaText-{{ section.id }} .mmt__media,
    #MultiMediaText-{{ section.id }}.mmt--media-left .mmt__media,
    #MultiMediaText-{{ section.id }}.mmt--media-right .mmt__media {
      order: 2;
      width: 100%;
    }

    #MultiMediaText-{{ section.id }} .mmt__heading {
      font-size: var(--mmt-heading-size-mobile);
    }

    #MultiMediaText-{{ section.id }} .mmt__body,
    #MultiMediaText-{{ section.id }} .mmt__body p {
      font-size: var(--mmt-body-size-mobile);
    }

    #MultiMediaText-{{ section.id }} .mmt__slide {
      aspect-ratio: var(--mmt-media-ratio-mobile);
    }

    #MultiMediaText-{{ section.id }} [data-mmt-carousel] .mmt__slide {
      flex-basis: calc((100% - var(--mmt-media-gap)) / 2);
    }

    #MultiMediaText-{{ section.id }} .mmt__video-play {
      width: 52px;
      height: 52px;
    }

    #MultiMediaText-{{ section.id }} .mmt__video-play svg {
      width: 24px;
      height: 24px;
    }

    #MultiMediaText-{{ section.id }} .mmt__track--static {
      {% if section.settings.mobile_static_layout == 'stack' %}
        flex-direction: column;
      {% endif %}
    }

    #MultiMediaText-{{ section.id }} .mmt__track--static .mmt__slide {
      {% if section.settings.mobile_static_layout == 'stack' %}
        flex: 0 0 auto;
        width: 100%;
      {% else %}
        flex: 1 1 0;
      {% endif %}
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MultiMediaText-{{ section.id }} .mmt__viewport {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  (() => {
    const sectionId = 'MultiMediaText-{{ section.id }}';

    function initMultiMediaText(root) {
      if (!root || root.dataset.mmtInitialized === 'true') return;

      root.dataset.mmtInitialized = 'true';

      root.querySelectorAll('[data-mmt-video]').forEach((player) => {
        const video = player.querySelector('video');
        const playButton = player.querySelector('[data-mmt-video-play]');
        const posterImage = player.querySelector('.mmt__video-poster');
        const posterTime = Number(player.dataset.posterTime) || 1;
        if (!video) return;

        const seekToPosterFrame = () => {
          if (posterImage || !Number.isFinite(video.duration) || video.duration <= 0) return;
          video.currentTime = Math.min(posterTime, Math.max(0, video.duration - 0.1));
        };

        if (!posterImage) {
          if (video.readyState >= 1) {
            seekToPosterFrame();
          } else {
            video.addEventListener('loadedmetadata', seekToPosterFrame, { once: true });
          }
        }

        const resetPlayer = () => {
          player.classList.remove('is-playing', 'has-started');
          seekToPosterFrame();
        };

        video.addEventListener('play', () => {
          player.classList.add('has-started');
          if (playButton) player.classList.add('is-playing');
        });

        video.addEventListener('ended', resetPlayer);

        if (!playButton) {
          if (!video.paused) player.classList.add('has-started');
          return;
        }

        const showPlayButton = () => player.classList.remove('is-playing');
        const togglePlayback = () => {
          if (video.paused) {
            video.play().catch(showPlayButton);
          } else {
            video.pause();
          }
        };

        playButton.addEventListener('click', (event) => {
          event.stopPropagation();
          togglePlayback();
        });

        video.addEventListener('click', togglePlayback);
        video.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            togglePlayback();
          }
        });
        video.addEventListener('pause', showPlayButton);
      });

      const carousel = root.querySelector('[data-mmt-carousel]');
      if (!carousel) return;

      const viewport = carousel.querySelector('.mmt__viewport');
      const slides = Array.from(carousel.querySelectorAll('[data-mmt-slide]'));
      const dots = Array.from(carousel.querySelectorAll('[data-mmt-dot]'));
      const previous = carousel.querySelector('[data-mmt-prev]');
      const next = carousel.querySelector('[data-mmt-next]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let activeIndex = 0;
      let scrollTimer;
      let autoplayTimer;
      let animationFrame;

      const perView = () => 2;
      const maxIndex = () => Math.max(0, slides.length - perView());

      function updateDots(index) {
        const lastIndex = maxIndex();
        dots.forEach((dot, dotIndex) => {
          dot.hidden = dotIndex > lastIndex;
          const isActive = dotIndex === index;
          dot.classList.toggle('is-active', isActive);
          if (isActive) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });
      }

      function stopScrollAnimation() {
        if (animationFrame) {
          window.cancelAnimationFrame(animationFrame);
          animationFrame = null;
        }
        viewport.classList.remove('is-animating');
      }

      function animateScrollTo(targetLeft) {
        stopScrollAnimation();

        const startLeft = viewport.scrollLeft;
        const distance = targetLeft - startLeft;
        const duration = Number(root.dataset.transitionDuration) || 700;
        const startTime = performance.now();

        if (Math.abs(distance) < 1 || reduceMotion.matches || duration <= 0) {
          viewport.scrollLeft = targetLeft;
          return;
        }

        viewport.classList.add('is-animating');

        function step(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          const eased = progress < 0.5
            ? 4 * progress * progress * progress
            : 1 - Math.pow(-2 * progress + 2, 3) / 2;

          viewport.scrollLeft = startLeft + (distance * eased);

          if (progress < 1) {
            animationFrame = window.requestAnimationFrame(step);
          } else {
            animationFrame = null;
            viewport.classList.remove('is-animating');
          }
        }

        animationFrame = window.requestAnimationFrame(step);
      }

      function goTo(index, smooth = true) {
        const targetIndex = Math.max(0, Math.min(index, maxIndex()));
        const target = slides[targetIndex];
        if (!target) return;
        activeIndex = targetIndex;
        const firstSlideOffset = slides[0]?.offsetLeft || 0;
        const targetLeft = Math.min(
          target.offsetLeft - firstSlideOffset,
          viewport.scrollWidth - viewport.clientWidth
        );

        if (smooth) {
          animateScrollTo(targetLeft);
        } else {
          stopScrollAnimation();
          viewport.scrollLeft = targetLeft;
        }
        updateDots(activeIndex);
      }

      function closestIndex() {
        const viewportLeft = viewport.getBoundingClientRect().left;
        let closest = 0;
        let distance = Infinity;
        slides.forEach((slide, index) => {
          const currentDistance = Math.abs(slide.getBoundingClientRect().left - viewportLeft);
          if (currentDistance < distance) {
            distance = currentDistance;
            closest = index;
          }
        });
        return Math.min(closest, maxIndex());
      }

      function stopAutoplay() {
        window.clearInterval(autoplayTimer);
      }

      function startAutoplay() {
        stopAutoplay();
        if (root.dataset.autoplay !== 'true' || reduceMotion.matches) return;
        autoplayTimer = window.setInterval(() => {
          goTo(activeIndex >= maxIndex() ? 0 : activeIndex + 1);
        }, Number(root.dataset.autoplaySpeed) || 5000);
      }

      previous?.addEventListener('click', () => {
        goTo(activeIndex <= 0 ? maxIndex() : activeIndex - 1);
        startAutoplay();
      });

      next?.addEventListener('click', () => {
        goTo(activeIndex >= maxIndex() ? 0 : activeIndex + 1);
        startAutoplay();
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          goTo(Number(dot.dataset.mmtDot));
          startAutoplay();
        });
      });

      viewport.addEventListener('scroll', () => {
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          if (animationFrame) return;
          activeIndex = closestIndex();
          updateDots(activeIndex);
        }, 80);
      }, { passive: true });

      viewport.addEventListener('pointerdown', stopScrollAnimation, { passive: true });
      viewport.addEventListener('touchstart', stopScrollAnimation, { passive: true });
      viewport.addEventListener('wheel', stopScrollAnimation, { passive: true });

      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', startAutoplay);
      root.addEventListener('focusin', stopAutoplay);
      root.addEventListener('focusout', startAutoplay);

      const onResize = () => goTo(activeIndex, false);
      window.addEventListener('resize', onResize);

      root.mmtDestroy = () => {
        stopAutoplay();
        stopScrollAnimation();
        window.clearTimeout(scrollTimer);
        window.removeEventListener('resize', onResize);
      };

      updateDots(0);
      startAutoplay();
    }

    initMultiMediaText(document.getElementById(sectionId));

    if (!window.multiMediaTextThemeEventsBound) {
      window.multiMediaTextThemeEventsBound = true;

      document.addEventListener('shopify:section:load', (event) => {
        const root = event.target.matches?.('[data-mmt-section]')
          ? event.target
          : event.target.querySelector?.('[data-mmt-section]');
        initMultiMediaText(root);
      });

      document.addEventListener('shopify:section:unload', (event) => {
        const root = event.target.matches?.('[data-mmt-section]')
          ? event.target
          : event.target.querySelector?.('[data-mmt-section]');
        root?.mmtDestroy?.();
      });

      document.addEventListener('shopify:block:select', (event) => {
        const slide = event.target.closest?.('[data-mmt-slide]');
        const root = slide?.closest?.('[data-mmt-section]');
        if (!slide || !root) return;
        const slides = Array.from(root.querySelectorAll('[data-mmt-slide]'));
        const viewport = root.querySelector('.mmt__viewport');
        const index = slides.indexOf(slide);
        if (index > -1 && viewport) {
          viewport.scrollTo({ left: slide.offsetLeft - viewport.offsetLeft, behavior: 'smooth' });
        }
      });
    }
  })();
</script>

