{%- comment -%}Shoppable TikTok stories section{%- endcomment -%}
{{ 'shoppable-tiktok-stories.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font_family
  if heading_font == blank
    assign heading_font = 'inherit'
  endif

  assign body_font = section.settings.body_font_family
  if body_font == blank
    assign body_font = 'inherit'
  endif
-%}

<section
  id="ShoppableStories-{{ section.id }}"
  class="sts sts--arrows-{{ section.settings.arrow_position }} sts--product-{{ section.settings.product_position }} sts--reveal-{{ section.settings.product_reveal }}{% if section.settings.full_width %} sts--full-width{% endif %}"
  data-shoppable-stories
  data-section-id="{{ section.id }}"
  data-slides-desktop="{{ section.settings.slides_desktop }}"
  data-slides-mobile="{{ section.settings.slides_mobile }}"
  data-gap-desktop="{{ section.settings.gap_desktop }}"
  data-gap-mobile="{{ section.settings.gap_mobile }}"
  data-speed="{{ section.settings.transition_speed }}"
  data-loop="{{ section.settings.slider_loop }}"
  data-slider-autoplay="{{ section.settings.slider_autoplay }}"
  data-slider-delay="{{ section.settings.slider_autoplay_delay | times: 1000 }}"
  data-disable-on-interaction="{{ section.settings.disable_autoplay_on_interaction }}"
  data-pause-on-hover="{{ section.settings.pause_on_hover }}"
  data-touch="{{ section.settings.enable_swipe }}"
  data-centered-desktop="{{ section.settings.centered_desktop }}"
  data-centered-mobile="{{ section.settings.centered_mobile }}"
  data-video-autoplay="{{ section.settings.video_autoplay }}"
  data-video-mode="{{ section.settings.video_play_mode }}"
  style="
    --sts-background: {{ section.settings.background_color }};
    --sts-text: {{ section.settings.text_color }};
    --sts-heading: {{ section.settings.heading_color }};
    --sts-accent: {{ section.settings.accent_color }};
    --sts-container: {{ section.settings.max_width }}px;
    --sts-padding-top: {{ section.settings.padding_top }}px;
    --sts-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sts-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --sts-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --sts-side-padding: {{ section.settings.side_padding }}px;
    --sts-side-padding-mobile: {{ section.settings.side_padding_mobile }}px;
    --sts-header-spacing: {{ section.settings.header_spacing }}px;
    --sts-heading-size: {{ section.settings.heading_size }}px;
    --sts-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --sts-heading-weight: {{ section.settings.heading_weight }};
    --sts-heading-line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --sts-heading-letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    --sts-heading-font: {{ heading_font }};
    --sts-body-font: {{ body_font }};
    --sts-card-radius: {{ section.settings.card_radius }}px;
    --sts-card-border-width: {{ section.settings.card_border_width }}px;
    --sts-card-border: {{ section.settings.card_border_color }};
    --sts-card-background: {{ section.settings.card_background }};
    --sts-overlay: {{ section.settings.overlay_color }};
    --sts-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --sts-story-text: {{ section.settings.story_text_color }};
    --sts-story-size: {{ section.settings.story_text_size }}px;
    --sts-story-size-mobile: {{ section.settings.story_text_size_mobile }}px;
    --sts-meta-size: {{ section.settings.meta_text_size }}px;
    --sts-product-background: {{ section.settings.product_background }};
    --sts-product-text: {{ section.settings.product_text_color }};
    --sts-product-price: {{ section.settings.product_price_color }};
    --sts-product-radius: {{ section.settings.product_radius }}px;
    --sts-product-image-size: {{ section.settings.product_image_size }}px;
    --sts-arrow-background: {{ section.settings.arrow_background }};
    --sts-arrow-color: {{ section.settings.arrow_color }};
    --sts-arrow-border: {{ section.settings.arrow_border_color }};
    --sts-arrow-size: {{ section.settings.arrow_size }}px;
    --sts-dot-color: {{ section.settings.dot_color }};
    --sts-dot-active: {{ section.settings.dot_active_color }};
    --sts-progress-track: {{ section.settings.progress_track_color }};
    --sts-progress-color: {{ section.settings.progress_color }};
  "
  aria-label="{{ section.settings.heading | default: 'Shoppable stories' | strip_html | escape }}"
>
  <div class="sts__container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <header class="sts__header sts__header--{{ section.settings.header_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sts__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="sts__heading">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="sts__intro rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="sts__slider-frame">
      <div
        id="ShoppableStoriesSlider-{{ section.id }}"
        class="swiper-container sts__slider"
        data-sts-slider
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ section.settings.heading | default: 'Shoppable stories' | strip_html | escape }}"
      >
        <div class="swiper-wrapper sts__wrapper">
          {%- for block in section.blocks -%}
            {%- liquid
              assign story_video = block.settings.video
              assign story_product = block.settings.product
              assign story_poster = block.settings.poster
              assign external_video_url = block.settings.video_url | strip
              assign tiktok_video_id = blank

              if story_video == blank and external_video_url contains 'tiktok.com'
                if external_video_url contains '/video/'
                  assign tiktok_video_id = external_video_url | split: '/video/' | last | split: '?' | first | split: '/' | first
                elsif external_video_url contains '/player/v1/'
                  assign tiktok_video_id = external_video_url | split: '/player/v1/' | last | split: '?' | first | split: '/' | first
                endif
              endif

              if story_poster == blank and story_video.preview_image != blank
                assign story_poster = story_video.preview_image
              endif

              assign has_video = false
              assign has_native_video = false
              if story_video != blank or external_video_url != blank
                assign has_video = true
              endif
              if tiktok_video_id == blank
                if story_video != blank or external_video_url != blank
                  assign has_native_video = true
                endif
              endif

              assign media_alt = block.settings.alt_text
              if media_alt == blank and story_poster.alt != blank
                assign media_alt = story_poster.alt
              endif
              if media_alt == blank
                assign media_alt = block.settings.caption | default: section.settings.heading | strip_html
              endif

              assign product_button_label = block.settings.product_button_label
              if product_button_label == blank
                assign product_button_label = section.settings.product_button_label
              endif

              assign has_meta = false
              if block.settings.author != blank or block.settings.date != blank or block.settings.meta != blank
                assign has_meta = true
              endif
            -%}

            <article
              class="swiper-slide sts__slide"
              data-sts-slide
              data-block-id="{{ block.id }}"
              data-slide-index="{{ forloop.index0 }}"
              role="group"
              aria-label="{{ forloop.index }} / {{ section.blocks.size }}"
              {{ block.shopify_attributes }}
              style="
                --sts-block-overlay: {{ block.settings.overlay_color }};
                --sts-block-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
                --sts-block-text: {{ block.settings.text_color }};
              "
            >
              <div class="sts__card sts__card--desktop-{{ section.settings.card_ratio_desktop }} sts__card--mobile-{{ section.settings.card_ratio_mobile }} sts__media-position--{{ block.settings.media_position }}{% if block.settings.use_custom_overlay %} sts__card--custom-overlay{% endif %}">
                <div class="sts__media">
                  {%- if tiktok_video_id != blank -%}
                    {% # theme-check-disable RemoteAsset %}
                    <iframe
                      class="sts__tiktok-player"
                      data-sts-tiktok
                      data-sts-playing="false"
                      data-sts-muted="{{ section.settings.video_muted }}"
                      src="https://www.tiktok.com/player/v1/{{ tiktok_video_id | escape }}?autoplay={% if section.settings.video_autoplay %}1{% else %}0{% endif %}&amp;muted={% if section.settings.video_muted %}1{% else %}0{% endif %}&amp;loop={% if section.settings.video_loop %}1{% else %}0{% endif %}&amp;controls=0&amp;progress_bar=0&amp;play_button=0&amp;volume_control=0&amp;fullscreen_button=0&amp;timestamp=0&amp;music_info=0&amp;description=0&amp;rel=0"
                      title="{{ media_alt | escape }}"
                      loading="lazy"
                      allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                    {% # theme-check-enable RemoteAsset %}
                  {%- elsif has_native_video -%}
                    <video
                      class="sts__video"
                      data-sts-video
                      playsinline
                      preload="{{ section.settings.video_preload }}"
                      {% if section.settings.video_loop %}loop{% endif %}
                      {% if section.settings.video_muted %}muted{% endif %}
                      {% if story_poster != blank %}poster="{{ story_poster | image_url: width: 1200 }}"{% endif %}
                      aria-label="{{ media_alt | escape }}"
                    >
                      {%- if story_video != blank -%}
                        {% # theme-check-disable RemoteAsset %}
                        {%- for source in story_video.sources -%}
                          <source src="{{ source.url | escape }}" type="{{ source.mime_type | escape }}">
                        {%- endfor -%}
                        {% # theme-check-enable RemoteAsset %}
                      {%- else -%}
                        {% # theme-check-disable RemoteAsset %}
                        <source src="{{ external_video_url | escape }}" type="video/mp4">
                        {% # theme-check-enable RemoteAsset %}
                      {%- endif -%}
                    </video>
                  {%- elsif story_poster != blank -%}
                    {{- story_poster
                      | image_url: width: 1400
                      | image_tag:
                        class: 'sts__poster',
                        widths: '320, 480, 640, 800, 1000, 1200, 1400',
                        sizes: '(max-width: 749px) 75vw, 25vw',
                        loading: 'lazy',
                        alt: media_alt
                    -}}
                  {%- else -%}
                    <div class="sts__placeholder">
                      {{ 'image' | placeholder_svg_tag: 'sts__placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>

                <span class="sts__overlay" aria-hidden="true"></span>

                <div class="sts__top-controls">
                  {%- if block.settings.badge != blank -%}
                    <span class="sts__badge">{{ block.settings.badge | escape }}</span>
                  {%- else -%}
                    <span></span>
                  {%- endif -%}

                  <div class="sts__video-actions">
                    {%- if has_video and section.settings.show_mute_button -%}
                      <button class="sts__media-button sts__mute-button" type="button" data-sts-mute aria-label="Bật âm thanh">
                        <svg class="sts__icon sts__icon--muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Zm11.5 3a3.5 3.5 0 0 0-1.1-2.55v5.1A3.5 3.5 0 0 0 15.5 12Zm2.5 0c0 1.6-.7 3.04-1.8 4.02l1.42 1.42A7.37 7.37 0 0 0 20 12a7.37 7.37 0 0 0-2.38-5.44L16.2 7.98A5.37 5.37 0 0 1 18 12Z"/><path class="sts__mute-slash" d="m3.3 2 18 18-1.3 1.3-18-18L3.3 2Z"/></svg>
                      </button>
                    {%- endif -%}

                    {%- if story_product != blank and section.settings.show_product_card and section.settings.product_reveal == 'toggle' -%}
                      <button class="sts__media-button sts__shop-toggle" type="button" data-sts-product-toggle aria-expanded="false" aria-label="Xem sản phẩm">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7V6a5 5 0 0 1 10 0v1h3l-1 14H5L4 7h3Zm2 0h6V6a3 3 0 0 0-6 0v1Zm-2.85 2 .72 10h10.26l.72-10H17v2h-2V9H9v2H7V9h-.85Z"/></svg>
                      </button>
                    {%- endif -%}
                  </div>
                </div>

                {%- if has_video and section.settings.show_play_button -%}
                  <button class="sts__play-button" type="button" data-sts-play aria-label="Phát video">
                    <svg class="sts__play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7L8 5Z"/></svg>
                    <svg class="sts__pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7V5Zm6 0h4v14h-4V5Z"/></svg>
                  </button>
                {%- endif -%}

                <div class="sts__content">
                  {%- if section.settings.show_story_text and block.settings.label != blank -%}
                    <p class="sts__label">{{ block.settings.label | escape }}</p>
                  {%- endif -%}

                  {%- if section.settings.show_story_text and block.settings.caption != blank -%}
                    <h3 class="sts__caption">{{ block.settings.caption }}</h3>
                  {%- endif -%}

                  {%- if section.settings.show_story_text and has_meta -%}
                    <div class="sts__meta">
                      {%- if block.settings.author != blank -%}<span>{{ block.settings.author | escape }}</span>{%- endif -%}
                      {%- if block.settings.date != blank -%}<span>{{ block.settings.date | escape }}</span>{%- endif -%}
                      {%- if block.settings.meta != blank -%}<span>{{ block.settings.meta | escape }}</span>{%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- if story_product != blank and section.settings.show_product_card -%}
                    <a class="sts__product" href="{{ story_product.url }}" aria-label="{{ story_product.title | escape }}">
                      {%- if section.settings.show_product_image and story_product.featured_image != blank -%}
                        {{- story_product.featured_image
                          | image_url: width: 240
                          | image_tag:
                            class: 'sts__product-image',
                            widths: '80, 120, 160, 240',
                            sizes: '80px',
                            loading: 'lazy',
                            alt: story_product.title
                        -}}
                      {%- endif -%}

                      <span class="sts__product-info">
                        <span class="sts__product-title">{{ story_product.title }}</span>
                        {%- if section.settings.show_product_price -%}
                          <span class="sts__product-price">
                            {{ story_product.price | money }}
                            {%- if story_product.compare_at_price > story_product.price -%}
                              <s>{{ story_product.compare_at_price | money }}</s>
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                      </span>

                      {%- if product_button_label != blank -%}
                        <span class="sts__product-cta">{{ product_button_label | escape }}</span>
                      {%- endif -%}
                    </a>
                  {%- endif -%}

                  {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                    <a class="sts__story-link" href="{{ block.settings.link }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                      {{ block.settings.link_label | escape }}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- else -%}
            {%- for index in (1..4) -%}
              <article class="swiper-slide sts__slide" role="group" aria-label="{{ index }} / 4">
                <div class="sts__card sts__card--desktop-{{ section.settings.card_ratio_desktop }} sts__card--mobile-{{ section.settings.card_ratio_mobile }}">
                  <div class="sts__placeholder">{{ 'image' | placeholder_svg_tag: 'sts__placeholder-svg' }}</div>
                </div>
              </article>
            {%- endfor -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.show_dots -%}
          <div class="swiper-pagination sts__pagination" data-sts-pagination></div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_arrows -%}
        <div class="sts__arrows" data-sts-arrows>
          <button class="sts__arrow sts__arrow--prev" type="button" data-sts-prev aria-label="Story trước">
            {% render 'svg-chevron-left' %}
          </button>
          <button class="sts__arrow sts__arrow--next" type="button" data-sts-next aria-label="Story tiếp theo">
            {% render 'svg-chevron-right' %}
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_progress -%}
      <div class="sts__progress" aria-hidden="true"><span data-sts-progress></span></div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'shoppable-tiktok-stories.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Shoppable TikTok Story",
  "tag": "section",
  "class": "section-shoppable-stories",
  "max_blocks": 20,
  "settings": [
    { "type": "header", "content": "Nội dung đầu section" },
    { "type": "text", "id": "eyebrow", "label": "Dòng phụ", "default": "REAL STORIES" },
    { "type": "inline_richtext", "id": "heading", "label": "Tiêu đề", "default": "CUSTOMER EXPERIENCE" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Thẻ tiêu đề",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "Mô tả" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Căn nội dung",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" },
        { "value": "right", "label": "Phải" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Bố cục section" },
    { "type": "checkbox", "id": "full_width", "label": "Toàn chiều rộng", "default": false },
    { "type": "range", "id": "max_width", "label": "Chiều rộng tối đa", "min": 900, "max": 1800, "step": 50, "unit": "px", "default": 1400 },
    { "type": "range", "id": "side_padding", "label": "Padding hai bên desktop", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "side_padding_mobile", "label": "Padding hai bên mobile", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "padding_top", "label": "Padding trên desktop", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding dưới desktop", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding trên mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding dưới mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "header_spacing", "label": "Khoảng cách tiêu đề và slider", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 30 },

    { "type": "header", "content": "Kiểu chữ" },
    { "type": "text", "id": "heading_font_family", "label": "Font tiêu đề tùy chỉnh", "info": "Ví dụ: Arial, sans-serif. Bỏ trống để dùng font theme." },
    { "type": "text", "id": "body_font_family", "label": "Font nội dung tùy chỉnh", "info": "Bỏ trống để dùng font theme." },
    { "type": "range", "id": "heading_size", "label": "Cỡ tiêu đề desktop", "min": 18, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Cỡ tiêu đề mobile", "min": 16, "max": 50, "step": 2, "unit": "px", "default": 26 },
    { "type": "select", "id": "heading_weight", "label": "Độ đậm tiêu đề", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semi bold" },
      { "value": "700", "label": "Bold" },
      { "value": "800", "label": "Extra bold" }
    ], "default": "700" },
    { "type": "range", "id": "heading_line_height", "label": "Line-height tiêu đề", "min": 90, "max": 160, "step": 5, "unit": "%", "default": 120 },
    { "type": "range", "id": "heading_letter_spacing", "label": "Khoảng cách chữ tiêu đề", "min": 0, "max": 10, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "Màu sắc" },
    { "type": "color", "id": "background_color", "label": "Màu nền section", "default": "#101010" },
    { "type": "color", "id": "heading_color", "label": "Màu tiêu đề", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Màu mô tả", "default": "#d1d1d1" },
    { "type": "color", "id": "accent_color", "label": "Màu nhấn", "default": "#ffffff" },

    { "type": "header", "content": "Cấu hình slider" },
    { "type": "range", "id": "slides_desktop", "label": "Số story hiển thị desktop", "min": 1, "max": 6, "step": 0.1, "default": 4.2 },
    { "type": "range", "id": "slides_mobile", "label": "Số story hiển thị mobile", "min": 1, "max": 2.5, "step": 0.1, "default": 1.4 },
    { "type": "range", "id": "gap_desktop", "label": "Khoảng cách story desktop", "min": 0, "max": 50, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "gap_mobile", "label": "Khoảng cách story mobile", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 10 },
    { "type": "checkbox", "id": "centered_desktop", "label": "Căn giữa slide desktop", "default": true },
    { "type": "checkbox", "id": "centered_mobile", "label": "Căn giữa slide mobile", "default": true },
    { "type": "checkbox", "id": "enable_swipe", "label": "Cho phép kéo/vuốt", "default": true },
    { "type": "checkbox", "id": "slider_loop", "label": "Lặp vô hạn", "default": true },
    { "type": "range", "id": "transition_speed", "label": "Thời gian chuyển slide", "min": 150, "max": 1500, "step": 50, "unit": "ms", "default": 550 },
    { "type": "checkbox", "id": "slider_autoplay", "label": "Tự chuyển slide", "default": false },
    { "type": "range", "id": "slider_autoplay_delay", "label": "Thời gian chờ autoplay", "min": 2, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "disable_autoplay_on_interaction", "label": "Dừng autoplay sau khi tương tác", "default": false },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Dừng autoplay khi hover", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Hiện nút mũi tên", "default": true },
    { "type": "select", "id": "arrow_position", "label": "Vị trí mũi tên", "options": [
      { "value": "overlay", "label": "Nằm trên story" },
      { "value": "below", "label": "Nằm dưới slider" }
    ], "default": "overlay" },
    { "type": "checkbox", "id": "show_dots", "label": "Hiện dots", "default": false },
