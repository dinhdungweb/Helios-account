<style>
  #shopify-section-{{ section.id }} .mema-scroll {
    --mema-bg: {{ section.settings.background_color }};
    --mema-content-bg: {{ section.settings.middle_background }};
    --mema-text: {{ section.settings.text_color }};
    --mema-muted: {{ section.settings.muted_color }};
    --mema-accent: {{ section.settings.active_color }};
    --mema-gap: {{ section.settings.column_gap }}px;
    --mema-side-padding: {{ section.settings.side_padding }}px;
    --mema-text-padding: {{ section.settings.middle_padding }}px;
    --mema-image-padding: {{ section.settings.image_padding }}px;
    --mema-step-height: {{ section.settings.desktop_height }}px;
    --mema-image-height: {{ section.settings.desktop_image_height }}px;
    --mema-mobile-image-height: {{ section.settings.mobile_image_height }}px;
    --mema-sticky-top: {{ section.settings.sticky_top }}px;
    --mema-heading-size: {{ section.settings.heading_size }}px;
    --mema-body-size: {{ section.settings.body_size }}px;
    --mema-subtitle-size: {{ section.settings.subtitle_size }}px;
    color: var(--mema-text);
    background: var(--mema-bg);
  }
  #shopify-section-{{ section.id }} .mema-scroll *,
  #shopify-section-{{ section.id }} .mema-scroll *::before,
  #shopify-section-{{ section.id }} .mema-scroll *::after { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .mema-scroll__desktop {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1fr);
    gap: var(--mema-gap);
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .mema-scroll--image-left .mema-scroll__content-list {
    grid-column: 2;
  }
  #shopify-section-{{ section.id }} .mema-scroll--image-left .mema-scroll__media {
    grid-column: 1;
  }
  #shopify-section-{{ section.id }} .mema-scroll__content-list {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    padding: 0 var(--mema-side-padding);
    background: var(--mema-content-bg);
    text-align: left;
  }
  #shopify-section-{{ section.id }} .mema-scroll__item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: max(var(--mema-step-height), 80vh);
    padding: var(--mema-text-padding) 0;
    opacity: 1;
    transition: opacity .35s ease;
  }
  #shopify-section-{{ section.id }} .mema-scroll[data-initialized="true"] .mema-scroll__item { opacity: .38; }
  #shopify-section-{{ section.id }} .mema-scroll[data-initialized="true"] .mema-scroll__item.is-active { opacity: 1; }
  #shopify-section-{{ section.id }} .mema-scroll__counter {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 25px;
    color: var(--mema-accent);
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: .12em;
  }
  #shopify-section-{{ section.id }} .mema-scroll__counter::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    background: currentColor;
  }
  #shopify-section-{{ section.id }} .mema-scroll__heading {
    margin: 0;
    color: inherit;
    text-align: {{ section.settings.heading_alignment }};
    font-size: var(--mema-heading-size);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -.025em;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }
  #shopify-section-{{ section.id }} .mema-scroll__subtitle {
    margin: 16px 0 0;
    color: var(--mema-muted);
    font-size: var(--mema-subtitle-size);
    line-height: 1.45;
  }
  #shopify-section-{{ section.id }} .mema-scroll__rule {
    width: min(100%, 320px);
    height: 1px;
    margin: 22px 0 18px;
    background: var(--mema-muted);
    opacity: .4;
  }
  #shopify-section-{{ section.id }} .mema-scroll__details {
    margin: 0;
    font-size: var(--mema-body-size);
    line-height: 1.55;
  }
  #shopify-section-{{ section.id }} .mema-scroll__link {
    display: inline-block;
    width: fit-content;
    margin-top: 24px;
    color: inherit;
    font-size: var(--mema-subtitle-size);
    line-height: 1.4;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  #shopify-section-{{ section.id }} .mema-scroll__media {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: var(--mema-sticky-top);
    align-self: start;
    height: min(var(--mema-image-height), calc(100vh - var(--mema-sticky-top) - 24px));
    min-height: 280px;
    margin-top: var(--mema-image-padding);
  }
  #shopify-section-{{ section.id }} .mema-scroll__media-panel {
    position: absolute;
    inset: 0 var(--mema-image-padding);
    opacity: 0;
    visibility: hidden;
    clip-path: inset(100% 0 0 0);
    transition: opacity .35s ease, clip-path .5s ease, visibility 0s .5s;
  }
  #shopify-section-{{ section.id }} .mema-scroll__media-panel.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition: opacity .35s ease, clip-path .5s ease;
  }
  #shopify-section-{{ section.id }} .mema-scroll[data-effect="fade"] .mema-scroll__media-panel {
    clip-path: none;
  }
  #shopify-section-{{ section.id }} .mema-scroll__media-inner,
  #shopify-section-{{ section.id }} .mema-scroll__picture,
  #shopify-section-{{ section.id }} .mema-scroll__image {
    display: block;
    width: 100%;
    height: 100%;
  }
  #shopify-section-{{ section.id }} .mema-scroll__image {
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
  }
  #shopify-section-{{ section.id }} .mema-scroll__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    height: 100%;
    border: 1px dashed #d4d4d4;
    background: #fafafa;
    color: #a7a7a7;
  }
  #shopify-section-{{ section.id }} .mema-scroll__placeholder-icon { width: 42px; height: 42px; }
  #shopify-section-{{ section.id }} .mema-scroll__placeholder-label {
    color: var(--mema-muted);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .mema-scroll__mobile { display: none; }
  @media (max-width: 899px) {
    #shopify-section-{{ section.id }} .mema-scroll__desktop { display: none; }
    #shopify-section-{{ section.id }} .mema-scroll__mobile {
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.card_gap }}px;
      width: 100%;
      max-width: 640px;
      margin: 0 auto;
      padding: 20px;
    }
    #shopify-section-{{ section.id }} .mema-scroll__mobile-item {
      min-width: 0;
    }
    #shopify-section-{{ section.id }} .mema-scroll__mobile-media {
      height: var(--mema-mobile-image-height);
      overflow: hidden;
      border-radius: {{ section.settings.card_radius }}px;
    }
    #shopify-section-{{ section.id }} .mema-scroll__mobile-media .mema-scroll__image {
      object-fit: contain;
    }
    #shopify-section-{{ section.id }} .mema-scroll__mobile-copy {
      padding: 25px 4px 20px;
      text-align: left;
    }
    #shopify-section-{{ section.id }} .mema-scroll__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      text-align: {{ section.settings.mobile_heading_alignment }};
    }
    #shopify-section-{{ section.id }} .mema-scroll__counter { margin-bottom: 18px; }
    #shopify-section-{{ section.id }} .mema-scroll__rule { margin: 17px 0 15px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .mema-scroll__item,
    #shopify-section-{{ section.id }} .mema-scroll__media-panel { transition: none; }
  }
</style>

<section id="mema-scroll-{{ section.id }}"
  class="mema-scroll{% if section.settings.image_position == 'left' %} mema-scroll--image-left{% endif %}"
  data-effect="{{ section.settings.desktop_image_effect }}"
  aria-label="{{ section.settings.accessible_label | escape }}">
  <div class="mema-scroll__desktop">
    <div class="mema-scroll__content-list">
      {%- for block in section.blocks -%}
        <div class="mema-scroll__item{% if forloop.first %} is-active{% endif %}" data-mema-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if section.settings.show_counter -%}<span class="mema-scroll__counter">{{ forloop.index | prepend: '0' }}</span>{%- endif -%}
          {%- if block.settings.title != blank -%}<h2 class="mema-scroll__heading">{{ block.settings.title | escape }}</h2>{%- endif -%}
          {%- if block.settings.subtitle != blank -%}<p class="mema-scroll__subtitle">{{ block.settings.subtitle | escape }}</p>{%- endif -%}
          {%- if block.settings.details != blank -%}
            <div class="mema-scroll__rule" aria-hidden="true"></div>
            <p class="mema-scroll__details">{{ block.settings.details | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a class="mema-scroll__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="mema-scroll__media">
      {%- for block in section.blocks -%}
        <div class="mema-scroll__media-panel{% if forloop.first %} is-active{% endif %}" data-mema-panel="{{ forloop.index0 }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
          {% render 'mema-set-image', block: block, placeholder_label: section.settings.placeholder_label %}
        </div>
      {%- endfor -%}
    </div>
  </div>
  <div class="mema-scroll__mobile">
    {%- for block in section.blocks -%}
      <article class="mema-scroll__mobile-item" data-mema-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <div class="mema-scroll__mobile-media">
          {% render 'mema-set-image', block: block, placeholder_label: section.settings.placeholder_label %}
        </div>
        <div class="mema-scroll__mobile-copy">
          {%- if section.settings.show_counter -%}<span class="mema-scroll__counter">{{ forloop.index | prepend: '0' }}</span>{%- endif -%}
          {%- if block.settings.title != blank -%}<h2 class="mema-scroll__heading">{{ block.settings.title | escape }}</h2>{%- endif -%}
          {%- if block.settings.subtitle != blank -%}<p class="mema-scroll__subtitle">{{ block.settings.subtitle | escape }}</p>{%- endif -%}
          {%- if block.settings.details != blank -%}
            <div class="mema-scroll__rule" aria-hidden="true"></div>
            <p class="mema-scroll__details">{{ block.settings.details | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a class="mema-scroll__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('mema-scroll-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const items = Array.from(root.querySelectorAll('.mema-scroll__desktop .mema-scroll__item'));
    const panels = Array.from(root.querySelectorAll('.mema-scroll__media-panel'));
    const abort = new AbortController();
    let frame = 0;
    let activeIndex = 0;
    const activate = (index) => {
      if (index === activeIndex || index < 0 || index >= items.length) return;
      activeIndex = index;
      items.forEach((item, i) => item.classList.toggle('is-active', i === index));
      panels.forEach((panel, i) => {
        panel.classList.toggle('is-active', i === index);
        panel.setAttribute('aria-hidden', String(i !== index));
      });
    };
    const update = () => {
      frame = 0;
      if (!root.isConnected) { abort.abort(); return; }
      if (window.innerWidth < 900 || items.length < 2) return;
      const bounds = root.getBoundingClientRect();
      if (bounds.bottom < 0 || bounds.top > window.innerHeight) return;
      const anchor = window.innerHeight * .5;
      let nearest = 0;
      let distance = Infinity;
      items.forEach((item, i) => {
        const rect = item.getBoundingClientRect();
        const current = Math.abs((rect.top + rect.bottom) / 2 - anchor);
        if (current < distance) { distance = current; nearest = i; }
      });
      activate(nearest);
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true, signal: abort.signal });
    window.addEventListener('resize', schedule, { signal: abort.signal });
    root.addEventListener('shopify:block:select', (event) => {
      const target = event.target.closest('[data-mema-index]');
      if (!target || !root.contains(target)) return;
      const index = Number(target.dataset.memaIndex);
      activate(index);
      target.scrollIntoView({ block: 'center', inline: 'center', behavior: 'smooth' });
    }, { signal: abort.signal });
    document.addEventListener('shopify:section:unload', (event) => {
      if (event.target.contains(root)) abort.abort();
    }, { signal: abort.signal });
    schedule();
  })();
</script>

{% schema %}
{
  "name": "MEMA image text scroll",
  "settings": [
    { "type": "text", "id": "accessible_label", "label": "Section label", "default": "MEMA sets" },
    { "type": "header", "content": "Desktop scrolling" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1000 },
    { "type": "range", "id": "desktop_height", "label": "Minimum height per set", "min": 320, "max": 800, "step": 10, "unit": "px", "default": 500 },
    { "type": "range", "id": "desktop_image_height", "label": "Image height", "min": 300, "max": 800, "step": 10, "unit": "px", "default": 560 },
    { "type": "range", "id": "sticky_top", "label": "Sticky offset from top", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 80 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "side_padding", "label": "Text side padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "middle_padding", "label": "Text vertical padding", "min": 8, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "image_padding", "label": "Image side padding", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "right", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "select", "id": "desktop_image_effect", "label": "Image transition", "default": "reveal", "options": [{ "value": "reveal", "label": "Reveal" }, { "value": "fade", "label": "Fade" }] },
    { "type": "select", "id": "image_fit", "label": "Desktop image fit", "default": "contain", "options": [{ "value": "contain", "label": "Show full image" }, { "value": "cover", "label": "Fill area" }] },
    { "type": "checkbox", "id": "show_counter", "label": "Show set number", "default": true },
    { "type": "header", "content": "Mobile layout" },
    { "type": "range", "id": "mobile_image_height", "label": "Image height", "min": 240, "max": 700, "step": 10, "unit": "px", "default": 420 },
    { "type": "range", "id": "card_gap", "label": "Space between sets", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "Image corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Text and placeholder" },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "select", "id": "heading_alignment", "label": "Desktop heading alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 18, "max": 42, "step": 2, "unit": "px", "default": 26 },
    { "type": "select", "id": "mobile_heading_alignment", "label": "Mobile heading alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "range", "id": "subtitle_size", "label": "Subtitle size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "body_size", "label": "Detail size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "text", "id": "placeholder_label", "label": "Image placeholder label", "default": "SET IMAGE" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "middle_background", "label": "Text background", "default": "#f8f8f8" },
    { "type": "color", "id": "text_color", "label": "Main text", "default": "#171717" },
    { "type": "color", "id": "muted_color", "label": "Secondary text and rule", "default": "#777777" },
    { "type": "color", "id": "active_color", "label": "Counter accent", "default": "#444444" }
  ],
  "blocks": [{
    "type": "set",
    "name": "Set",
    "limit": 8,
    "settings": [
      { "type": "text", "id": "title", "label": "Set name", "default": "LIMITED SET" },
      { "type": "text", "id": "subtitle", "label": "Short description", "default": "Vòng tay + Vòng cổ đặc biệt" },
      { "type": "textarea", "id": "details", "label": "Included items", "default": "1 Minibook Love - 2 Love Notes\n2 Individual Card + 2 Duo Card" },
      { "type": "image_picker", "id": "image_desktop", "label": "Desktop image" },
      { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. Uses desktop image when empty." },
      { "type": "text", "id": "link_label", "label": "Optional link label" },
      { "type": "url", "id": "link", "label": "Optional link" }
    ]
  }],
  "presets": [{
    "name": "MEMA image text scroll",
    "blocks": [
      { "type": "set", "settings": { "title": "LIMITED SET", "subtitle": "Vòng tay + Vòng cổ đặc biệt", "details": "1 Minibook Love - 2 Love Notes\n2 Individual Card + 2 Duo Card" } },
      { "type": "set", "settings": { "title": "STANDARD SET", "subtitle": "Vòng tay + Mặt dây + Nhẫn", "details": "1 Minibook Love - 2 Love Notes\n1 Individual Card + 1 Duo Card" } },
      { "type": "set", "settings": { "title": "STANDARD INDIVIDUAL", "subtitle": "Mua lẻ từng sản phẩm Standard", "details": "1 Minibook Love - 2 Love Notes\nKhông kèm Card" } }
    ]
  }]
}
{% endschema %}
