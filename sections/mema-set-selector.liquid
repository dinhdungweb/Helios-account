<style>
  #shopify-section-{{ section.id }} .mema-sets {
    --sets-background: {{ section.settings.background_color }};
    --sets-middle: {{ section.settings.middle_background }};
    --sets-card: {{ section.settings.card_background }};
    --sets-text: {{ section.settings.text_color }};
    --sets-muted: {{ section.settings.muted_color }};
    --sets-active: {{ section.settings.active_color }};
    --sets-gap: {{ section.settings.column_gap }}px;
    --sets-radius: {{ section.settings.card_radius }}px;
    --sets-min-height: {{ section.settings.desktop_height }}px;
    --sets-mobile-image-height: {{ section.settings.mobile_image_height }}px;
    color: var(--sets-text);
    background-color: var(--sets-background);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .mema-sets *,
  #shopify-section-{{ section.id }} .mema-sets *::before,
  #shopify-section-{{ section.id }} .mema-sets *::after { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .mema-sets__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sets-gap);
    align-items: stretch;
    max-width: {{ section.settings.max_width }}px;
    min-height: var(--sets-min-height);
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .mema-sets__choices {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: {{ section.settings.card_gap }}px;
    padding: 20px {{ section.settings.middle_padding }}px;
    background: var(--sets-middle);
  }
  #shopify-section-{{ section.id }} .mema-sets__choice {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) 14px;
    align-items: start;
    gap: 12px;
    position: relative;
    width: 100%;
    padding: 17px 16px;
    border: 0;
    border-radius: var(--sets-radius);
    background: transparent;
    color: var(--sets-text);
    text-align: left;
    cursor: pointer;
    font: inherit;
    transition: background-color .2s ease, box-shadow .2s ease;
  }
  #shopify-section-{{ section.id }} .mema-sets__choice:hover,
  #shopify-section-{{ section.id }} .mema-sets__choice[aria-selected="true"] {
    background: var(--sets-card);
  }
  #shopify-section-{{ section.id }} .mema-sets__choice[aria-selected="true"] {
    box-shadow: 0 5px 18px rgba(0, 0, 0, .035);
  }
  #shopify-section-{{ section.id }} .mema-sets__choice[aria-selected="true"]::before {
    content: '';
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    width: 2px;
    background: var(--sets-active);
  }
  #shopify-section-{{ section.id }} .mema-sets__choice:focus-visible {
    outline: 2px solid var(--sets-active);
    outline-offset: 2px;
  }
  #shopify-section-{{ section.id }} .mema-sets__number {
    display: block;
    padding-top: 2px;
    color: var(--sets-muted);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: .08em;
  }
  #shopify-section-{{ section.id }} .mema-sets__copy { display: block; min-width: 0; }
  #shopify-section-{{ section.id }} .mema-sets__title {
    display: block;
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: .025em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .mema-sets__subtitle {
    display: block;
    margin-top: 7px;
    color: var(--sets-muted);
    font-size: {{ section.settings.card_detail_size }}px;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} .mema-sets__divider {
    display: block;
    height: 1px;
    margin: 12px 0 9px;
    background: var(--sets-muted);
    opacity: .3;
  }
  #shopify-section-{{ section.id }} .mema-sets__details {
    display: block;
    font-size: {{ section.settings.card_detail_size }}px;
    line-height: 1.45;
  }
  #shopify-section-{{ section.id }} .mema-sets__arrow {
    display: block;
    width: 8px;
    height: 8px;
    margin-top: 4px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    color: var(--sets-muted);
    transform: rotate(45deg);
    transition: transform .2s ease, color .2s ease;
  }
  #shopify-section-{{ section.id }} .mema-sets__choice[aria-selected="true"] .mema-sets__arrow {
    color: var(--sets-active);
    transform: translateX(2px) rotate(45deg);
  }
  #shopify-section-{{ section.id }} .mema-sets__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: {{ section.settings.image_padding }}px {{ section.settings.side_padding }}px {{ section.settings.image_padding }}px 0;
  }
  #shopify-section-{{ section.id }} .mema-sets__panel { width: 100%; text-align: center; }
  #shopify-section-{{ section.id }} .mema-sets__panel[hidden] { display: none !important; }
  #shopify-section-{{ section.id }} .mema-sets__picture,
  #shopify-section-{{ section.id }} .mema-sets__image,
  #shopify-section-{{ section.id }} .mema-sets__placeholder { display: block; width: 100%; }
  #shopify-section-{{ section.id }} .mema-sets__image {
    max-height: calc(var(--sets-min-height) - {{ section.settings.image_padding | times: 2 }}px);
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
  }
  #shopify-section-{{ section.id }} .mema-sets__placeholder { max-height: calc(var(--sets-min-height) - 40px); }
  #shopify-section-{{ section.id }} .mema-sets__link {
    display: inline-block;
    margin-top: 12px;
    color: var(--sets-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 899px) {
    #shopify-section-{{ section.id }} .mema-sets__inner {
      display: flex;
      flex-direction: column;
      min-height: 0;
      gap: 0;
    }
    #shopify-section-{{ section.id }} .mema-sets__choices {
      flex-direction: row;
      justify-content: flex-start;
      gap: 10px;
      overflow-x: auto;
      padding: 14px 20px;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
    }
    #shopify-section-{{ section.id }} .mema-sets__choice {
      flex: 0 0 min(76vw, 260px);
      scroll-snap-align: start;
      padding: 16px 14px;
    }
    #shopify-section-{{ section.id }} .mema-sets__visual {
      min-height: var(--sets-mobile-image-height);
      padding: 20px;
    }
    #shopify-section-{{ section.id }} .mema-sets__image {
      max-height: var(--sets-mobile-image-height);
      width: 100%;
      object-fit: contain;
    }
    #shopify-section-{{ section.id }} .mema-sets__placeholder { max-height: var(--sets-mobile-image-height); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .mema-sets__choice { transition: none; }
  }
</style>

<section id="mema-sets-{{ section.id }}" class="mema-sets" aria-label="{{ section.settings.accessible_label | escape }}">
  <div class="mema-sets__inner">
    <div class="mema-sets__choices" role="tablist" aria-label="{{ section.settings.accessible_label | escape }}">
      {%- for block in section.blocks -%}
        <button type="button" class="mema-sets__choice" id="mema-set-tab-{{ section.id }}-{{ block.id }}" role="tab"
          aria-controls="mema-set-panel-{{ section.id }}-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          {{ block.shopify_attributes }}>
          <span class="mema-sets__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          <span class="mema-sets__copy">
            <span class="mema-sets__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.subtitle != blank -%}<span class="mema-sets__subtitle">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
            {%- if block.settings.details != blank -%}
              <span class="mema-sets__divider" aria-hidden="true"></span>
              <span class="mema-sets__details">{{ block.settings.details | escape | newline_to_br }}</span>
            {%- endif -%}
          </span>
          <span class="mema-sets__arrow" aria-hidden="true"></span>
        </button>
      {%- endfor -%}
    </div>
    <div class="mema-sets__visual">
      {%- for block in section.blocks -%}
        {%- liquid
          assign set_image = block.settings.image_desktop | default: block.settings.image_mobile
          assign set_alt = set_image.alt | default: block.settings.title
        -%}
        <div class="mema-sets__panel" id="mema-set-panel-{{ section.id }}-{{ block.id }}" role="tabpanel"
          aria-labelledby="mema-set-tab-{{ section.id }}-{{ block.id }}" tabindex="0"{% unless forloop.first %} hidden{% endunless %}>
          {%- if set_image != blank -%}
            <picture class="mema-sets__picture">
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 899px)" srcset="{{ block.settings.image_mobile | image_url: width: 480 }} 480w, {{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="(max-width: 899px) 100vw">
              {%- endif -%}
              <img class="mema-sets__image" src="{{ set_image | image_url: width: 900 }}"
                srcset="{{ set_image | image_url: width: 480 }} 480w, {{ set_image | image_url: width: 750 }} 750w, {{ set_image | image_url: width: 1100 }} 1100w"
                sizes="(max-width: 899px) 100vw, 33vw" width="{{ set_image.width }}" height="{{ set_image.height }}"
                alt="{{ set_alt | escape }}" loading="lazy">
            </picture>
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'mema-sets__placeholder' }}
          {%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a class="mema-sets__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('mema-sets-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll('[role="tabpanel"]'));
    const activate = (tab, focus) => {
      if (!tab) return;
      tabs.forEach((item) => {
        const active = item === tab;
        item.setAttribute('aria-selected', String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => { panel.hidden = panel.id !== tab.getAttribute('aria-controls'); });
      if (focus) tab.focus();
    };
    root.addEventListener('click', (event) => activate(event.target.closest('[role="tab"]'), false));
    root.addEventListener('keydown', (event) => {
      const index = tabs.indexOf(event.target);
      if (index < 0) return;
      let next = index;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault();
      activate(tabs[next], true);
    });
    root.addEventListener('shopify:block:select', (event) => {
      const tab = event.target.closest('[role="tab"]');
      activate(tab, false);
    });
  })();
</script>

{% schema %}
{
  "name": "MEMA set selector",
  "settings": [
    { "type": "text", "id": "accessible_label", "label": "Section label", "default": "Choose a set" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1000 },
    { "type": "range", "id": "desktop_height", "label": "Desktop minimum height", "min": 320, "max": 800, "step": 10, "unit": "px", "default": 390 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "side_padding", "label": "Image right padding", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "middle_padding", "label": "Set column padding", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "image_padding", "label": "Image padding", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_image_height", "label": "Mobile image height", "min": 240, "max": 700, "step": 10, "unit": "px", "default": 420 },
    { "type": "select", "id": "image_fit", "label": "Desktop image fit", "default": "contain", "options": [{ "value": "contain", "label": "Show full image" }, { "value": "cover", "label": "Fill area" }] },
    { "type": "header", "content": "Cards and text" },
    { "type": "range", "id": "card_gap", "label": "Space between sets", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_radius", "label": "Selected set corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "card_title_size", "label": "Set name size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_detail_size", "label": "Set detail size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 11 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "middle_background", "label": "Set column background", "default": "#f8f8f8" },
    { "type": "color", "id": "card_background", "label": "Selected set background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Main text", "default": "#171717" },
    { "type": "color", "id": "muted_color", "label": "Secondary text and rule", "default": "#777777" },
    { "type": "color", "id": "active_color", "label": "Selected set border", "default": "#444444" }
  ],
  "blocks": [{
    "type": "set",
    "name": "Set option",
    "limit": 8,
    "settings": [
      { "type": "text", "id": "title", "label": "Set name", "default": "LIMITED SET" },
      { "type": "text", "id": "subtitle", "label": "Short description", "default": "Vòng tay + Vòng cổ đặc biệt" },
      { "type": "textarea", "id": "details", "label": "Included items", "default": "1 Minibook Love - 2 Love Notes\n2 Individual Card + 2 Duo Card" },
      { "type": "image_picker", "id": "image_desktop", "label": "Desktop image" },
      { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. Uses desktop image when empty." },
      { "type": "text", "id": "link_label", "label": "Optional link label" },
      { "type": "url", "id": "link", "label": "Optional link" }
    ]
  }],
  "presets": [{
    "name": "MEMA set selector",
    "blocks": [
      { "type": "set", "settings": { "title": "LIMITED SET", "subtitle": "Vòng tay + Vòng cổ đặc biệt", "details": "1 Minibook Love - 2 Love Notes\n2 Individual Card + 2 Duo Card" } },
      { "type": "set", "settings": { "title": "STANDARD SET", "subtitle": "Vòng tay + Mặt dây + Nhẫn", "details": "1 Minibook Love - 2 Love Notes\n1 Individual Card + 1 Duo Card" } },
      { "type": "set", "settings": { "title": "STANDARD INDIVIDUAL", "subtitle": "Mua lẻ từng sản phẩm Standard", "details": "1 Minibook Love - 2 Love Notes\nKhông kèm Card" } }
    ]
  }]
}
{% endschema %}
