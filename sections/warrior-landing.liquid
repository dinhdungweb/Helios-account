{{ 'warrior-landing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_desktop_url = 'warrior-hero.png' | asset_url
  assign hero_mobile_url = hero_desktop_url

  if section.settings.hero_desktop != blank
    assign hero_desktop_url = section.settings.hero_desktop | image_url: width: 2000
  endif

  if section.settings.hero_mobile != blank
    assign hero_mobile_url = section.settings.hero_mobile | image_url: width: 1000
  elsif section.settings.hero_desktop != blank
    assign hero_mobile_url = section.settings.hero_desktop | image_url: width: 1000
  endif

  assign hero_button_url = section.settings.hero_button_link
  if hero_button_url == blank
    assign hero_button_url = '#warrior-chapters-' | append: section.id
  endif
-%}

<section
  id="WarriorLanding-{{ section.id }}"
  class="warrior-landing header-overlap-section needs-alt-logo"
  data-warrior-landing
  style="--warrior-accent: {{ section.settings.accent_color }}; --warrior-bg: {{ section.settings.background_color }}; --warrior-text: {{ section.settings.text_color }};"
>
  <h1 class="visually-hidden">{{ page.title | default: section.settings.accessible_title | escape }}</h1>

  <div class="warrior-hero">
    <picture>
      <source media="(max-width: 767px)" srcset="{{ hero_mobile_url }}">
      <img
        src="{{ hero_desktop_url }}"
        alt="{{ section.settings.hero_alt | escape }}"
        width="1440"
        height="810"
        fetchpriority="high"
      >
    </picture>

    {%- if section.settings.hero_button_label != blank -%}
      <a class="warrior-hero__button" href="{{ hero_button_url }}">
        {{ section.settings.hero_button_label | escape }}
      </a>
    {%- endif -%}
  </div>

  <div id="warrior-chapters-{{ section.id }}" class="warrior-chapters" data-warrior-chapters>
    <div class="warrior-chapters__viewport" aria-live="polite">
      {%- assign chapter_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'chapter' -%}
          {%- assign chapter_index = chapter_index | plus: 1 -%}
          {%- capture chapter_asset -%}warrior-chapter-{% case chapter_index %}{% when 1 %}01{% when 2 %}02{% when 3 %}03{% when 4 %}04{% when 5 %}05{% when 6 %}06{% when 7 %}07{% when 8 %}08{% when 9 %}09{% else %}10{% endcase %}.png{%- endcapture -%}
          {%- if block.settings.artwork != blank -%}
            {%- assign chapter_image_url = block.settings.artwork | image_url: width: 1200 -%}
          {%- else -%}
            {%- assign chapter_image_url = chapter_asset | asset_url -%}
          {%- endif -%}

          <article
            class="warrior-chapter-card{% if chapter_index == 1 %} is-active{% endif %}"
            data-warrior-chapter
            data-index="{{ chapter_index | minus: 1 }}"
            aria-hidden="{% if chapter_index == 1 %}false{% else %}true{% endif %}"
            {{ block.shopify_attributes }}
          >
            <h2>{{ block.settings.title | default: 'Chapter' | escape }}</h2>
            <img
              class="warrior-chapter-card__art"
              src="{{ chapter_image_url }}"
              alt="{{ block.settings.artwork.alt | default: block.settings.title | escape }}"
              width="900"
              height="900"
              draggable="false"
              loading="{% if chapter_index == 1 %}eager{% else %}lazy{% endif %}"
            >
            {%- if block.settings.description != blank -%}
              <div class="warrior-chapter-card__description rte">{{ block.settings.description }}</div>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <p class="warrior-chapter-card__caption">{{ block.settings.caption | escape }}</p>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="warrior-collections" data-warrior-collections>
    <div class="warrior-collections__desktop">
      <nav class="warrior-collection-tabs" aria-label="Bộ sưu tập">
        {%- assign collection_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' -%}
            {%- assign collection_index = collection_index | plus: 1 -%}
            {%- case collection_index -%}
              {%- when 1 -%}
                {%- assign collection_asset = 'warrior-lotus-drop.png' -%}
                {%- assign collection_hover_asset = 'warrior-hover-lotus.png' -%}
              {%- when 2 -%}
                {%- assign collection_asset = 'warrior-tab-sunflower.png' -%}
                {%- assign collection_hover_asset = 'warrior-hover-sunflower.png' -%}
              {%- else -%}
                {%- assign collection_asset = 'warrior-tab-chrysaber.png' -%}
                {%- assign collection_hover_asset = 'warrior-hover-chrysaber.png' -%}
            {%- endcase -%}
            {%- if block.settings.icon != blank -%}
              {%- assign collection_icon_url = block.settings.icon | image_url: width: 500 -%}
            {%- else -%}
              {%- assign collection_icon_url = collection_asset | asset_url -%}
            {%- endif -%}
            {%- if block.settings.hover_artwork != blank -%}
              {%- assign collection_hover_url = block.settings.hover_artwork | image_url: width: 900 -%}
            {%- else -%}
              {%- assign collection_hover_url = collection_hover_asset | asset_url -%}
            {%- endif -%}

            <button
              class="warrior-collection-tab no-hover{% if collection_index == 1 %} is-active{% endif %}"
              type="button"
              data-warrior-collection-tab
              data-index="{{ collection_index | minus: 1 }}"
              data-warrior-collection-link="{{ block.settings.link }}"
              aria-pressed="{% if collection_index == 1 %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="warrior-collection-tab__media" aria-hidden="true">
                <img class="warrior-collection-tab__icon" src="{{ collection_icon_url }}" alt="" width="120" height="120" loading="lazy">
                <img class="warrior-collection-tab__warrior" src="{{ collection_hover_url }}" alt="" width="900" height="900" loading="lazy">
              </span>
              <span class="warrior-collection-tab__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.description != blank -%}<small>{{ block.settings.description | escape }}</small>{%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <span class="warrior-collection-tab__cta" data-warrior-collection-cta>{{ block.settings.link_label | escape }}</span>
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <div class="warrior-collection-galleries">
        {%- assign gallery_collection_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' -%}
            {%- assign gallery_collection_index = gallery_collection_index | plus: 1 -%}
            {%- case gallery_collection_index -%}
              {%- when 1 -%}
                {%- assign gallery_artwork_asset = 'warrior-hover-lotus.png' -%}
              {%- when 2 -%}
                {%- assign gallery_artwork_asset = 'warrior-hover-sunflower.png' -%}
              {%- else -%}
                {%- assign gallery_artwork_asset = 'warrior-hover-chrysaber.png' -%}
            {%- endcase -%}
            {%- if block.settings.hover_artwork != blank -%}
              {%- assign gallery_artwork_url = block.settings.hover_artwork | image_url: width: 1200 -%}
            {%- else -%}
              {%- assign gallery_artwork_url = gallery_artwork_asset | asset_url -%}
            {%- endif -%}

            <div
              class="warrior-gallery{% if gallery_collection_index == 1 %} is-active{% endif %}"
              data-warrior-gallery
              data-warrior-collection-gallery
              data-collection-index="{{ gallery_collection_index | minus: 1 }}"
              aria-hidden="{% if gallery_collection_index == 1 %}false{% else %}true{% endif %}"
            >
              <button class="warrior-gallery__arrow warrior-gallery__arrow--previous" type="button" data-warrior-gallery-previous aria-label="Ảnh trước">
                <img src="{{ 'warrior-arrow.svg' | asset_url }}" alt="" width="42" height="52">
              </button>

              <div class="warrior-gallery__track" aria-live="polite">
                <figure class="warrior-gallery__slide warrior-gallery__slide--warrior is-active" data-warrior-gallery-slide data-index="0">
                  <img
                    src="{{ gallery_artwork_url }}"
                    alt="{{ block.settings.hover_artwork.alt | default: block.settings.title | escape }}"
                    width="900"
                    height="900"
                    draggable="false"
                    loading="lazy"
                  >
                </figure>

                {%- assign gallery_slide_index = 1 -%}
                {%- for gallery_number in (1..5) -%}
                  {%- capture gallery_setting_id -%}gallery_image_{{ gallery_number }}{%- endcapture -%}
                  {%- assign gallery_image = block.settings[gallery_setting_id] -%}
                  {%- assign gallery_image_url = blank -%}

                  {%- if gallery_image != blank -%}
                    {%- assign gallery_image_url = gallery_image | image_url: width: 1800 -%}
                  {%- elsif gallery_collection_index == 1 -%}
                    {%- assign gallery_image = section.settings[gallery_setting_id] -%}
                    {%- if gallery_image != blank -%}
                      {%- assign gallery_image_url = gallery_image | image_url: width: 1800 -%}
                    {%- else -%}
                      {%- capture gallery_asset -%}warrior-gallery-0{{ gallery_number }}.png{%- endcapture -%}
                      {%- assign gallery_image_url = gallery_asset | asset_url -%}
                    {%- endif -%}
                  {%- endif -%}

                  {%- if gallery_image_url != blank -%}
                    <figure class="warrior-gallery__slide" data-warrior-gallery-slide data-index="{{ gallery_slide_index }}">
                      <img
                        src="{{ gallery_image_url }}"
                        alt="{{ gallery_image.alt | default: block.settings.title | default: section.settings.gallery_alt | escape }}"
                        width="1400"
                        height="900"
                        draggable="false"
                        loading="lazy"
                      >
                    </figure>
                    {%- assign gallery_slide_index = gallery_slide_index | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <button class="warrior-gallery__arrow warrior-gallery__arrow--next" type="button" data-warrior-gallery-next aria-label="Ảnh tiếp theo">
                <img src="{{ 'warrior-arrow.svg' | asset_url }}" alt="" width="42" height="52">
              </button>
              <div class="warrior-dots warrior-gallery__dots" data-warrior-gallery-dots aria-label="Chọn ảnh"></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="warrior-collections__mobile">
      {%- assign mobile_collection_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection' -%}
          {%- assign mobile_collection_index = mobile_collection_index | plus: 1 -%}
          {%- case mobile_collection_index -%}
            {%- when 1 -%}{%- assign mobile_collection_asset = 'warrior-lotus-drop.png' -%}
            {%- when 2 -%}{%- assign mobile_collection_asset = 'warrior-tab-sunflower.png' -%}
            {%- else -%}{%- assign mobile_collection_asset = 'warrior-tab-chrysaber.png' -%}
          {%- endcase -%}
          {%- if block.settings.icon != blank -%}
            {%- assign mobile_collection_icon_url = block.settings.icon | image_url: width: 700 -%}
          {%- else -%}
            {%- assign mobile_collection_icon_url = mobile_collection_asset | asset_url -%}
          {%- endif -%}

          <article class="warrior-mobile-collection" {{ block.shopify_attributes }}>
            <div class="warrior-mobile-gallery" data-warrior-mobile-gallery>
              <div class="warrior-mobile-gallery__track" aria-live="polite">
                <figure class="warrior-mobile-gallery__slide warrior-mobile-gallery__slide--artwork is-active" data-warrior-mobile-gallery-slide>
                  <img src="{{ mobile_collection_icon_url }}" alt="{{ block.settings.icon.alt | default: block.settings.title | escape }}" width="700" height="700" draggable="false" loading="lazy">
                </figure>

                {%- for gallery_number in (1..5) -%}
                  {%- capture gallery_setting_id -%}gallery_image_{{ gallery_number }}{%- endcapture -%}
                  {%- assign mobile_gallery_image = block.settings[gallery_setting_id] -%}
                  {%- assign mobile_gallery_image_url = blank -%}

                  {%- if mobile_gallery_image != blank -%}
                    {%- assign mobile_gallery_image_url = mobile_gallery_image | image_url: width: 1000 -%}
                  {%- elsif mobile_collection_index == 1 -%}
                    {%- assign mobile_gallery_image = section.settings[gallery_setting_id] -%}
                    {%- if mobile_gallery_image != blank -%}
                      {%- assign mobile_gallery_image_url = mobile_gallery_image | image_url: width: 1000 -%}
                    {%- else -%}
                      {%- capture mobile_gallery_asset -%}warrior-gallery-0{{ gallery_number }}.png{%- endcapture -%}
                      {%- assign mobile_gallery_image_url = mobile_gallery_asset | asset_url -%}
                    {%- endif -%}
                  {%- endif -%}

                  {%- if mobile_gallery_image_url != blank -%}
                    <figure class="warrior-mobile-gallery__slide" data-warrior-mobile-gallery-slide>
                      <img
                        src="{{ mobile_gallery_image_url }}"
                        alt="{{ mobile_gallery_image.alt | default: block.settings.title | escape }}"
                        width="900"
                        height="700"
                        draggable="false"
                        loading="lazy"
                      >
                    </figure>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <div class="warrior-dots warrior-mobile-collection__dots" data-warrior-mobile-gallery-dots aria-label="Chọn ảnh"></div>
            </div>
            <h2>{{ block.settings.title | escape }}</h2>
            {%- if block.settings.description != blank -%}<p>{{ block.settings.description | escape }}</p>{%- endif -%}
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'Xem sản phẩm' | escape }}</a>
            {%- elsif block.settings.link_label != blank -%}
              <span class="warrior-mobile-collection__cta">{{ block.settings.link_label | escape }}</span>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="warrior-story-art">
    {%- if section.settings.story_art != blank -%}
      {{ section.settings.story_art | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 760, 1100, 1600', sizes: '(max-width: 767px) calc(100vw - 48px), 0px', alt: section.settings.story_art.alt }}
    {%- else -%}
      <img src="{{ 'warrior-story-art.png' | asset_url }}" alt="{{ section.settings.story_art_alt | escape }}" width="1400" height="1400" loading="lazy">
    {%- endif -%}
  </div>

  <div class="warrior-finale" aria-label="{{ section.settings.finale_alt | escape }}">
    <img class="warrior-finale__flare warrior-finale__flare--left" src="{{ 'warrior-finale-flare.png' | asset_url }}" alt="" width="1100" height="1100" loading="lazy">
    <img class="warrior-finale__mark" src="{{ 'warrior-finale-mark.png' | asset_url }}" alt="" width="1100" height="1100" loading="lazy">
    <img class="warrior-finale__flare warrior-finale__flare--right" src="{{ 'warrior-finale-flare.png' | asset_url }}" alt="" width="1100" height="1100" loading="lazy">
    <img class="warrior-finale__date" src="{{ 'warrior-finale-date.png' | asset_url }}" alt="{{ section.settings.finale_alt | escape }}" width="1600" height="303" loading="lazy">
  </div>
</section>

<script src="{{ 'warrior-landing.js' | asset_url }}" defer="defer"></script>

