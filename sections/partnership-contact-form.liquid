{%- liquid
  assign form_id = 'PartnershipContactForm-' | append: section.id
  assign section_id = 'PartnershipContactSection-' | append: section.id
  assign panel_id = 'PartnershipContactPanel-' | append: section.id
  assign template_file = 'templates/' | append: template.name
  if template.suffix != blank
    assign template_file = template_file | append: '.' | append: template.suffix
  endif
  assign template_file = template_file | append: '.json'
-%}

{%- style -%}
  #{{ section_id }} {
    padding: {{ section.settings.mobile_padding_top }}px 20px {{ section.settings.mobile_padding_bottom }}px;
  }

  #{{ section_id }} .partnership-form__inner {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #{{ section_id }} .partnership-form__disclosure {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  #{{ section_id }} .partnership-form__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    text-align: left;
  }

  #{{ section_id }} .partnership-form__summary::-webkit-details-marker {
    display: none;
  }

  #{{ section_id }} .partnership-form__title {
    flex: 1;
    margin: 0;
    text-align: left !important;
  }

  #{{ section_id }} .partnership-form__toggle-icon {
    position: relative;
    display: block;
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
  }

  #{{ section_id }} .partnership-form__toggle-icon::before,
  #{{ section_id }} .partnership-form__toggle-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: opacity 160ms ease;
  }

  #{{ section_id }} .partnership-form__toggle-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  #{{ section_id }} .partnership-form__disclosure[open] .partnership-form__toggle-icon::after {
    opacity: 0;
  }

  #{{ section_id }} .partnership-form__panel {
    padding: 8px 0 34px;
  }

  #{{ section_id }} .partnership-form__description {
    margin-bottom: 32px;
    text-align: {{ section.settings.text_alignment }};
  }

  #{{ section_id }} .partnership-form__description > :last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .partnership-form__group {
    margin: 0 0 34px;
    padding: 0;
    border: 0;
  }

  #{{ section_id }} .partnership-form__legend {
    width: 100%;
    margin: 0 0 18px;
    padding: 0 0 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    color: inherit;
    font-size: 18px;
    font-weight: 600;
  }

  #{{ section_id }} .partnership-form__field + .partnership-form__field {
    margin-top: 24px;
  }

  #{{ section_id }} .partnership-form__label {
    display: block;
    margin-bottom: 7px;
    color: inherit;
    font-weight: 600;
  }

  #{{ section_id }} .partnership-form__required {
    color: #fab320;
  }

  #{{ section_id }} .partnership-form__hint {
    display: block;
    margin: 0 0 10px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 14px;
    line-height: 1.5;
  }

  #{{ section_id }} .partnership-form__input,
  #{{ section_id }} .partnership-form__textarea {
    width: 100%;
    border-color: rgba(255, 255, 255, 0.24);
  }

  #{{ section_id }} .partnership-form__textarea {
    min-height: 130px;
    resize: vertical;
  }

  #{{ section_id }} .partnership-form__documents {
    margin: 0 0 12px 20px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 14px;
    line-height: 1.6;
  }

  #{{ section_id }} .partnership-form__optional {
    font-size: 13px;
    font-style: italic;
    font-weight: 400;
    opacity: 0.7;
  }

  #{{ section_id }} .partnership-form__submit {
    min-width: 180px;
    cursor: pointer;
  }

  #{{ section_id }} .partnership-form__submit[disabled] {
    cursor: wait;
    opacity: 0.65;
  }

  #{{ section_id }} .partnership-form__honeypot {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
  }

  #{{ section_id }} .partnership-form__status {
    margin-bottom: 24px;
    padding: 14px 16px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  #{{ section_id }} .partnership-form__status--success {
    border-color: #fab320;
  }

  #{{ section_id }} .partnership-form__status--error {
    border-color: #d84b4b;
  }

  #{{ section_id }} .partnership-form__status ul {
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="{{ section_id }}"
  class="partnership-form"
  data-section-id="{{ section.id }}"
  data-api-url="{{ section.settings.api_url | escape }}"
  data-template-file="{{ template_file | escape }}"
>
  <div class="partnership-form__inner">
    <form id="{{ form_id }}" class="partnership-form__form">
      <details
        class="partnership-form__disclosure"
      >
        <summary class="partnership-form__summary" aria-controls="{{ panel_id }}">
          <h2 class="partnership-form__title">
            {%- if section.settings.title != blank -%}
              {{ section.settings.title | escape }}
            {%- else -%}
              Partnership form
            {%- endif -%}
          </h2>
          <span class="partnership-form__toggle-icon" aria-hidden="true"></span>
        </summary>

        <div id="{{ panel_id }}" class="partnership-form__panel">
          {%- if section.settings.description != blank -%}
            <div class="partnership-form__description rte">{{ section.settings.description }}</div>
          {%- endif -%}

      <div class="partnership-form__status" role="status" tabindex="-1" hidden></div>
      <div class="partnership-form__honeypot" aria-hidden="true">
        <label for="PartnershipWebsite-{{ section.id }}">Website</label>
        <input id="PartnershipWebsite-{{ section.id }}" name="company_website" type="text" tabindex="-1" autocomplete="off">
      </div>

      <fieldset class="partnership-form__group">
        <legend class="partnership-form__legend">Thông tin liên hệ</legend>
        <div class="partnership-form__field">
          <label class="partnership-form__label" for="PartnershipEmail-{{ section.id }}">
            Email <span class="partnership-form__required" aria-hidden="true">*</span>
          </label>
          <input
            class="partnership-form__input"
            id="PartnershipEmail-{{ section.id }}"
            type="email"
            name="email"
            value="{% if customer %}{{ customer.email | escape }}{% endif %}"
            autocomplete="email"
            aria-required="true"
            required
          >
        </div>
      </fieldset>

      <fieldset class="partnership-form__group">
        <legend class="partnership-form__legend">Lý do hợp tác</legend>

        <div class="partnership-form__field">
          <label class="partnership-form__label" for="PartnershipWhy-{{ section.id }}">
            Vì sao bạn quan tâm đến HELIOS?
            <span class="partnership-form__required" aria-hidden="true">*</span>
          </label>
          <span class="partnership-form__hint" id="PartnershipWhyHint-{{ section.id }}">
            Điều gì trong sản phẩm, tinh thần hoặc cách HELIOS xây thương hiệu phù hợp với thị trường và định hướng của bạn?
          </span>
          <textarea
            class="partnership-form__textarea"
            id="PartnershipWhy-{{ section.id }}"
            name="reason"
            aria-describedby="PartnershipWhyHint-{{ section.id }}"
            aria-required="true"
            required
          ></textarea>
        </div>

        <div class="partnership-form__field">
          <label class="partnership-form__label" for="PartnershipGoal-{{ section.id }}">
            Bạn muốn cùng HELIOS xây điều gì trong 12–24 tháng tới?
            <span class="partnership-form__required" aria-hidden="true">*</span>
          </label>
          <span class="partnership-form__hint" id="PartnershipGoalHint-{{ section.id }}">
            Hãy mô tả mục tiêu thực tế: thị trường, điểm bán, kênh phân phối, dự án hoặc cộng đồng bạn muốn phát triển.
          </span>
          <textarea
            class="partnership-form__textarea"
            id="PartnershipGoal-{{ section.id }}"
            name="goal"
            aria-describedby="PartnershipGoalHint-{{ section.id }}"
            aria-required="true"
            required
          ></textarea>
        </div>

        <div class="partnership-form__field">
          <label class="partnership-form__label" for="PartnershipSupport-{{ section.id }}">
            Bạn kỳ vọng HELIOS hỗ trợ điều gì?
            <span class="partnership-form__required" aria-hidden="true">*</span>
          </label>
          <span class="partnership-form__hint" id="PartnershipSupportHint-{{ section.id }}">
            Sản phẩm, đào tạo, nội dung, hình ảnh, vận hành, launch, trưng bày hoặc những phần khác.
          </span>
          <textarea
            class="partnership-form__textarea"
            id="PartnershipSupport-{{ section.id }}"
            name="expected_support"
            aria-describedby="PartnershipSupportHint-{{ section.id }}"
            aria-required="true"
            required
          ></textarea>
        </div>
      </fieldset>

      <fieldset class="partnership-form__group">
        <legend class="partnership-form__legend">Tài liệu giới thiệu</legend>
        <div class="partnership-form__field">
          <label class="partnership-form__label" for="PartnershipDocuments-{{ section.id }}">
            Link tài liệu
            <span class="partnership-form__optional">(Không bắt buộc)</span>
          </label>
          <span class="partnership-form__hint" id="PartnershipDocumentsHint-{{ section.id }}">
            Dán một hoặc nhiều link Google Drive/Dropbox và nhớ bật quyền xem cho HELIOS.
          </span>
          <ul class="partnership-form__documents">
            <li>Company profile</li>
            <li>Retail portfolio</li>
            <li>Brand deck</li>
            <li>Hình ảnh điểm bán</li>
            <li>Tài liệu thị trường</li>
          </ul>
          <textarea
            class="partnership-form__textarea"
            id="PartnershipDocuments-{{ section.id }}"
            name="document_links"
            aria-describedby="PartnershipDocumentsHint-{{ section.id }}"
            placeholder="https://drive.google.com/..."
          ></textarea>
        </div>
      </fieldset>

      <button class="button partnership-form__submit" type="submit">
        {{ section.settings.button_label | escape }}
      </button>
        </div>
      </details>
    </form>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById({{ section_id | json }});
    if (!section || section.dataset.partnershipReady === 'true') return;
    section.dataset.partnershipReady = 'true';

    const form = section.querySelector('.partnership-form__form');
    const submitButton = section.querySelector('.partnership-form__submit');
    const status = section.querySelector('.partnership-form__status');
    const successMessage = {{ section.settings.success_message | json }};
    const errorMessage = {{ section.settings.error_message | json }};

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const apiUrl = section.dataset.apiUrl.trim();
      const templateFile = section.dataset.templateFile.trim();
      if (!apiUrl || !templateFile) {
        showStatus(errorMessage + ' Thiếu cấu hình API.', true);
        return;
      }

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      payload.section_id = section.dataset.sectionId;
      payload.template_file = templateFile;
      payload.page_url = window.location.href;

      submitButton.disabled = true;
      status.hidden = true;

      try {
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.success) {
          throw new Error(result.message || errorMessage);
        }

        form.reset();
        showStatus(successMessage, false);
      } catch (error) {
        showStatus(error.message || errorMessage, true);
      } finally {
        submitButton.disabled = false;
      }
    });

    function showStatus(message, isError) {
      status.textContent = message;
      status.hidden = false;
      status.classList.toggle('partnership-form__status--error', isError);
      status.classList.toggle('partnership-form__status--success', !isError);
      status.setAttribute('role', isError ? 'alert' : 'status');
      status.focus();
    }
  })();
</script>

{% schema %}
{
  "name": "Partnership form",
  "class": "section-partnership-form",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Đề xuất hợp tác"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Hãy chia sẻ định hướng hợp tác của bạn với HELIOS.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Header alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Gửi thông tin"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Gửi thông tin thành công. HELIOS sẽ liên hệ với bạn trong thời gian sớm nhất."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Chưa thể gửi thông tin. Vui lòng kiểm tra lại các trường bên dưới."
    },
    {
      "type": "header",
      "content": "Email API"
    },
    {
      "type": "text",
      "id": "recipient_email",
      "label": "Recipient email",
      "info": "Form của section này sẽ được gửi trực tiếp tới email này."
    },
    {
      "type": "url",
      "id": "api_url",
      "label": "API URL",
      "default": "https://helios-tier-pricing-api-h543.vercel.app/api/partnership"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Form width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Partnership form"
    }
  ]
}
{% endschema %}
