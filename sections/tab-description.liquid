{%- liquid
  assign rating_count = product.metafields.reviews.rating_count | default: 0
  assign description_tab_id = 'ProductDescriptionTab-' | append: section.id
  assign description_panel_id = 'ProductDescriptionPanel-' | append: section.id
  assign description_content_id = 'ProductDescriptionContent-' | append: section.id
  assign reviews_tab_id = 'ProductReviewsTab-' | append: section.id
  assign reviews_panel_id = 'ProductReviewsPanel-' | append: section.id
-%}

<product-description-tabs
  class="product-description-tabs wide-container"
  style="
    --product-description-tabs-collapsed-height: {{ section.settings.collapsed_height }}px;
    --product-description-tabs-fade-color: {{ section.settings.fade_color }};
    --product-description-tabs-fade-transparent: {{ section.settings.fade_color | color_modify: 'alpha', 0 }};
  "
  data-collapsed-height="{{ section.settings.collapsed_height }}"
>
  <div class="product-description-tabs__list" role="tablist" aria-label="Thông tin sản phẩm">
    <button
      id="{{ description_tab_id }}"
      class="product-description-tabs__tab is-active no-hover"
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="{{ description_panel_id }}"
      data-tab="description"
    >
      <span>{{ section.settings.description_tab_label | default: 'Mô tả sản phẩm' | escape }}</span>
    </button>

    {%- if section.settings.show_reviews_tab -%}
      <button
        id="{{ reviews_tab_id }}"
        class="product-description-tabs__tab no-hover"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="{{ reviews_panel_id }}"
        tabindex="-1"
        data-tab="reviews"
      >
        <span>
          {{- section.settings.reviews_tab_label | default: 'Đánh giá' | escape -}}
          {%- if section.settings.show_review_count %} ({{ rating_count }}){% endif -%}
        </span>
      </button>
    {%- endif -%}
  </div>

  <div class="product-description-tabs__content">
    <div
      id="{{ description_panel_id }}"
      class="product-description-tabs__panel"
      role="tabpanel"
      aria-labelledby="{{ description_tab_id }}"
      data-panel="description"
    >
      <div id="{{ description_content_id }}" class="product-description-tabs__description" data-description-content>
        <div class="product-description-tabs__description-inner" data-description-inner>
          {{ product.description }}
        </div>
      </div>

      <button
        class="product-description-tabs__toggle no-hover"
        type="button"
        aria-expanded="false"
        aria-controls="{{ description_content_id }}"
        data-description-toggle
        hidden
      >
        <span class="product-description-tabs__toggle-label" data-expand-label>
          {{ section.settings.expand_label | default: 'Xem thêm' | escape }}
          {% render 'svg-chevron-down' %}
        </span>
        <span class="product-description-tabs__toggle-label" data-collapse-label hidden>
          {{ section.settings.collapse_label | default: 'Thu gọn' | escape }}
          <svg class="icon-chevron-up" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16">
            <path d="M12 8.4l6.9 6.9-1.4 1.4L12 11.2 6.5 16.7 5.1 15.3z"></path>
          </svg>
        </span>
      </button>
    </div>

    {%- if section.settings.show_reviews_tab -%}
      <div
        id="{{ reviews_panel_id }}"
        class="product-description-tabs__panel"
        role="tabpanel"
        aria-labelledby="{{ reviews_tab_id }}"
        data-panel="reviews"
        hidden
      >
        <div style="clear: both"></div>
        <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">
          {{ product.metafields.judgeme.widget }}
        </div>
      </div>
    {%- endif -%}
  </div>
</product-description-tabs>

{% style %}
  .product-description-tabs {
    display: block;
    max-width: 1300px;
    padding-top: 10px;
  }

  .product-description-tabs__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .product-description-tabs__tab {
    display: flex;
    min-height: 48px;
    align-items: center;
    padding: 12px 24px;
    border: 0;
    border-radius: 0;
    background: #f2f2f2;
    color: #111;
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
    cursor: pointer;
  }

  .product-description-tabs__tab.is-active {
    background: #fab230;
  }

  .product-description-tabs__tab:focus-visible,
  .product-description-tabs__toggle:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .product-description-tabs__content {
    padding: 20px 0 0;
  }

  .product-description-tabs__panel {
    position: relative;
  }

  .product-description-tabs__panel[hidden],
  .product-description-tabs__toggle[hidden],
  .product-description-tabs__toggle-label[hidden] {
    display: none !important;
  }

  .product-description-tabs__description {
    transition: max-height 0.3s ease;
  }

  .product-description-tabs.is-collapsible:not(.is-expanded) .product-description-tabs__description {
    max-height: var(--product-description-tabs-collapsed-height);
    overflow: hidden;
  }

  .product-description-tabs__description-inner {
    overflow-wrap: anywhere;
  }

  .product-description-tabs__description-inner img,
  .product-description-tabs__description-inner video,
  .product-description-tabs__description-inner iframe {
    max-width: 100%;
  }

  .product-description-tabs__description-inner img,
  .product-description-tabs__description-inner video {
    height: auto;
  }

  .product-description-tabs__toggle {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    margin: 16px 0 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.2rem;
    cursor: pointer;
  }

  .product-description-tabs__toggle:hover {
    background-color: transparent !important;
    color: inherit;
  }

  .product-description-tabs.is-collapsible:not(.is-expanded) .product-description-tabs__toggle {
    min-height: 140px;
    margin-top: -96px;
    padding-top: 96px;
    background: linear-gradient(
      to bottom,
      var(--product-description-tabs-fade-transparent),
      var(--product-description-tabs-fade-color) 70%
    );
  }

  .product-description-tabs__toggle-label {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .product-description-tabs__toggle-label svg {
    width: 16px;
    height: 16px;
    fill: currentcolor;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-description-tabs__description {
      transition: none;
    }
  }
{% endstyle %}

<script src="{{ 'tab-description.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Tabs Product Description",
  "settings": [
    {
      "type": "text",
      "id": "description_tab_label",
      "label": "Tên tab mô tả",
      "default": "Mô tả sản phẩm"
    },
    {
      "type": "checkbox",
      "id": "show_reviews_tab",
      "label": "Hiển thị tab đánh giá",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_tab_label",
      "label": "Tên tab đánh giá",
      "default": "Đánh giá"
    },
    {
      "type": "checkbox",
      "id": "show_review_count",
      "label": "Hiển thị số lượng đánh giá",
      "default": true
    },
    {
      "type": "text",
      "id": "expand_label",
      "label": "Nhãn mở rộng",
      "default": "Xem thêm"
    },
    {
      "type": "text",
      "id": "collapse_label",
      "label": "Nhãn thu gọn",
      "default": "Thu gọn"
    },
    {
      "type": "range",
      "id": "collapsed_height",
      "min": 200,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Chiều cao khi thu gọn",
      "default": 350
    },
    {
      "type": "color",
      "id": "fade_color",
      "label": "Màu nền hiệu ứng mờ",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Tabs Product Description"
    }
  ]
}
{% endschema %}
