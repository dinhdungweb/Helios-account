{%- liquid
  assign hero_image = section.settings.image_desktop | default: section.settings.image_mobile
  assign mobile_image = section.settings.image_mobile | default: hero_image
  assign image_alt = hero_image.alt | default: section.settings.heading
-%}

<style>
  #shopify-section-{{ section.id }} .mema-hero {
    --mema-panel-width: {{ section.settings.panel_width }}%;
    --mema-height: {{ section.settings.desktop_height }}px;
    --mema-mobile-image-height: {{ section.settings.mobile_image_height }}px;
    --mema-panel-padding: {{ section.settings.desktop_padding }}px;
    --mema-mobile-padding: {{ section.settings.mobile_padding }}px;
    --mema-panel-bg: {{ section.settings.panel_background }};
    --mema-text-color: {{ section.settings.text_color }};
    --mema-heading-size: {{ section.settings.heading_size }}px;
    --mema-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --mema-body-size: {{ section.settings.body_size }}px;
    --mema-mobile-body-size: {{ section.settings.mobile_body_size }}px;
    display: grid;
    grid-template-columns: minmax(0, var(--mema-panel-width)) minmax(0, 1fr);
    min-height: var(--mema-height);
    width: 100%;
    color: var(--mema-text-color);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .mema-hero *,
  #shopify-section-{{ section.id }} .mema-hero *::before,
  #shopify-section-{{ section.id }} .mema-hero *::after { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .mema-hero__panel {
    min-width: 0;
    padding: var(--mema-panel-padding);
    background: var(--mema-panel-bg);
    text-align: {{ section.settings.text_alignment }};
  }
  #shopify-section-{{ section.id }} .mema-hero__eyebrow {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
    letter-spacing: .01em;
  }
  #shopify-section-{{ section.id }} .mema-hero__heading {
    margin: clamp(64px, 13vh, 128px) 0 0;
    font-size: var(--mema-heading-size);
    font-weight: 400;
    line-height: 1.12;
    color: inherit;
    overflow-wrap: break-word;
  }
  #shopify-section-{{ section.id }} .mema-hero__story {
    margin-top: clamp(48px, 8vh, 88px);
    font-size: var(--mema-body-size);
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .mema-hero__lead {
    margin: 0;
    font-weight: 700;
    line-height: 1.35;
  }
  #shopify-section-{{ section.id }} .mema-hero__quote { margin: 0 0 16px; }
  #shopify-section-{{ section.id }} .mema-hero__body p { margin: 0 0 12px; }
  #shopify-section-{{ section.id }} .mema-hero__body p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .mema-hero__button {
    display: inline-block;
    margin-top: 24px;
    padding: 11px 18px;
    border: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
    font: inherit;
  }
  #shopify-section-{{ section.id }} .mema-hero__button:hover,
  #shopify-section-{{ section.id }} .mema-hero__button:focus-visible {
    color: var(--mema-panel-bg);
    background: var(--mema-text-color);
  }
  #shopify-section-{{ section.id }} .mema-hero__media {
    position: relative;
    min-width: 0;
    min-height: var(--mema-height);
    overflow: hidden;
    background: #e8e8e8;
  }
  #shopify-section-{{ section.id }} .mema-hero__picture,
  #shopify-section-{{ section.id }} .mema-hero__image,
  #shopify-section-{{ section.id }} .mema-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }
  #shopify-section-{{ section.id }} .mema-hero__picture,
  #shopify-section-{{ section.id }} .mema-hero__placeholder {
    position: absolute;
    inset: 0;
  }
  #shopify-section-{{ section.id }} .mema-hero__image {
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position_desktop }};
  }
  #shopify-section-{{ section.id }} .mema-hero__placeholder { min-height: var(--mema-height); }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .mema-hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    #shopify-section-{{ section.id }} .mema-hero__panel {
      order: {% if section.settings.mobile_order == 'image_first' %}2{% else %}1{% endif %};
      padding: var(--mema-mobile-padding);
      text-align: {{ section.settings.mobile_text_alignment }};
    }
    #shopify-section-{{ section.id }} .mema-hero__heading {
      margin-top: 40px;
      font-size: var(--mema-mobile-heading-size);
    }
    #shopify-section-{{ section.id }} .mema-hero__story {
      margin-top: 36px;
      font-size: var(--mema-mobile-body-size);
    }
    #shopify-section-{{ section.id }} .mema-hero__media {
      order: {% if section.settings.mobile_order == 'image_first' %}1{% else %}2{% endif %};
      height: var(--mema-mobile-image-height);
      min-height: 0;
      flex: none;
    }
    #shopify-section-{{ section.id }} .mema-hero__image {
      object-position: {{ section.settings.image_position_mobile }};
    }
    #shopify-section-{{ section.id }} .mema-hero__placeholder { min-height: var(--mema-mobile-image-height); }
  }
</style>

<section class="mema-hero" aria-label="{{ section.settings.heading | escape }}">
  <div class="mema-hero__panel">
    {%- if section.settings.eyebrow != blank -%}<p class="mema-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="mema-hero__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="mema-hero__story">
      {%- if section.settings.lead != blank -%}<p class="mema-hero__lead">{{ section.settings.lead | escape }}</p>{%- endif -%}
      {%- if section.settings.quote != blank -%}<p class="mema-hero__quote">{{ section.settings.quote | escape }}</p>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="mema-hero__body rte">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="mema-hero__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="mema-hero__media">
    {%- if hero_image != blank -%}
      <picture class="mema-hero__picture">
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">
        {%- endif -%}
        <img class="mema-hero__image"
          src="{{ hero_image | image_url: width: 1400 }}"
          srcset="{{ hero_image | image_url: width: 750 }} 750w, {{ hero_image | image_url: width: 1100 }} 1100w, {{ hero_image | image_url: width: 1400 }} 1400w, {{ hero_image | image_url: width: 2000 }} 2000w"
          sizes="(max-width: 749px) 100vw, {{ 100 | minus: section.settings.panel_width }}vw"
          width="{{ hero_image.width }}" height="{{ hero_image.height }}"
          alt="{{ image_alt | escape }}" loading="lazy">
      </picture>
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'mema-hero__placeholder' }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "MEMA editorial hero",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "HELIOS x BEX&O.D" },
    { "type": "text", "id": "heading", "label": "Main heading", "default": "MEMA Collection" },
    { "type": "text", "id": "lead", "label": "Bold intro", "default": "YOU ARE LOVED." },
    { "type": "text", "id": "quote", "label": "Quote", "default": "“Có những điều mình muốn giữ lại bằng bạc.”" },
    { "type": "richtext", "id": "body", "label": "Description", "default": "<p>BEX và O.D đưa những chi tiết họ để tâm vào bản phác. Từ đó, HELIOS phát triển năm thiết kế, với nét nối và điểm xanh RIZER xuyên suốt bộ sưu tập.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. Uses the desktop image when empty." },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover", "options": [{ "value": "cover", "label": "Fill area" }, { "value": "contain", "label": "Show full image" }] },
    { "type": "select", "id": "image_position_desktop", "label": "Desktop image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
    { "type": "select", "id": "image_position_mobile", "label": "Mobile image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
    { "type": "header", "content": "Desktop layout" },
    { "type": "range", "id": "panel_width", "label": "Text column width", "min": 20, "max": 60, "step": 1, "unit": "%", "default": 28 },
    { "type": "range", "id": "desktop_height", "label": "Minimum height", "min": 400, "max": 900, "step": 10, "unit": "px", "default": 610 },
    { "type": "range", "id": "desktop_padding", "label": "Text padding", "min": 16, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 13 },
    { "type": "header", "content": "Mobile layout" },
    { "type": "select", "id": "mobile_order", "label": "First on mobile", "default": "text_first", "options": [{ "value": "text_first", "label": "Text" }, { "value": "image_first", "label": "Image" }] },
    { "type": "range", "id": "mobile_image_height", "label": "Image height", "min": 220, "max": 800, "step": 10, "unit": "px", "default": 430 },
    { "type": "range", "id": "mobile_padding", "label": "Text padding", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "select", "id": "mobile_text_alignment", "label": "Text alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "range", "id": "mobile_heading_size", "label": "Heading size", "min": 20, "max": 52, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "mobile_body_size", "label": "Body size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "panel_background", "label": "Text background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" }
  ],
  "presets": [{ "name": "MEMA editorial hero" }]
}
{% endschema %}
