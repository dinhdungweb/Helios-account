{%- liquid
  assign section_heading = section.settings.heading
-%}

<section
  id="journey-timeline-{{ section.id }}"
  class="journey-timeline"
  style="
    --jt-background: {{ section.settings.background_color }};
    --jt-text: {{ section.settings.text_color }};
    --jt-muted: {{ section.settings.muted_text_color }};
    --jt-line: {{ section.settings.line_color }};
    --jt-dot: {{ section.settings.dot_color }};
    --jt-max-width: {{ section.settings.max_width }}px;
    --jt-heading-size: {{ section.settings.heading_size }}px;
    --jt-copy-width: {{ section.settings.copy_width }}%;
    --jt-gallery-gap: {{ section.settings.gallery_gap }}px;
    --jt-item-gap: {{ section.settings.item_gap }}px;
    --jt-padding-top: {{ section.settings.padding_top }}px;
    --jt-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="journey-timeline__container">
    {%- if section_heading != blank -%}
      <h2 class="journey-timeline__heading journey-timeline__heading--{{ section.settings.heading_alignment }}">
        {{ section_heading | escape }}
      </h2>
    {%- endif -%}

    <div class="journey-timeline__track">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'journey_item' -%}
            {%- liquid
              assign visible_image_count = block.settings.image_count | default: 2
              assign has_gallery = false

              for image_index in (1..visible_image_count)
                assign image_key = 'image_' | append: image_index
                if block.settings[image_key] != blank
                  assign has_gallery = true
                endif
              endfor

              if request.design_mode
                assign has_gallery = true
              endif
            -%}

            <article class="journey-timeline__item journey-timeline__item--standard" {{ block.shopify_attributes }}>
              <span class="journey-timeline__dot" aria-hidden="true"></span>

              <div class="journey-timeline__body{% unless has_gallery %} journey-timeline__body--text-only{% endunless %}">
                <div class="journey-timeline__copy">
                  {%- if block.settings.title != blank -%}
                    <h3 class="journey-timeline__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}

                  {%- if block.settings.description != blank -%}
                    <div class="journey-timeline__description rte">{{ block.settings.description }}</div>
                  {%- endif -%}
                </div>

                {%- if has_gallery -%}
                  <div
                    class="journey-timeline__gallery"
                    style="
                      --jt-columns-desktop: {{ block.settings.desktop_columns }};
                      --jt-columns-mobile: {{ block.settings.mobile_columns }};
                      --jt-image-ratio: {{ block.settings.image_ratio }};
                    "
                  >
                    {%- for image_index in (1..visible_image_count) -%}
                      {%- liquid
                        assign image_key = 'image_' | append: image_index
                        assign timeline_image = block.settings[image_key]
                        assign image_alt = timeline_image.alt | default: block.settings.title
                      -%}

                      {%- if timeline_image != blank -%}
                        <div class="journey-timeline__image-wrap">
                          {{-
                            timeline_image
                            | image_url: width: 1200
                            | image_tag:
                              class: 'journey-timeline__image',
                              widths: '240, 360, 480, 720, 960, 1200',
                              sizes: '(min-width: 750px) 30vw, 50vw',
                              loading: 'lazy',
                              alt: image_alt
                          -}}
                        </div>
                      {%- elsif request.design_mode -%}
                        <div class="journey-timeline__image-wrap journey-timeline__image-wrap--placeholder">
                          {{ 'image' | placeholder_svg_tag: 'journey-timeline__placeholder' }}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </article>

          {%- when 'final_item' -%}
            {%- assign final_image_alt = block.settings.image.alt | default: block.settings.title -%}

            <article class="journey-timeline__item journey-timeline__item--final" {{ block.shopify_attributes }}>
              <span class="journey-timeline__dot" aria-hidden="true"></span>

              <div class="journey-timeline__final-content">
                <div class="journey-timeline__copy journey-timeline__copy--final">
                  {%- if block.settings.title != blank -%}
                    <h3 class="journey-timeline__title journey-timeline__title--final">
                      {{ block.settings.title | escape }}
                    </h3>
                  {%- endif -%}

                  {%- if block.settings.description != blank -%}
                    <div class="journey-timeline__description rte">{{ block.settings.description }}</div>
                  {%- endif -%}
                </div>

                {%- if block.settings.image != blank or request.design_mode -%}
                  <div
                    class="journey-timeline__final-image-wrap"
                    style="--jt-final-image-ratio: {{ block.settings.image_ratio }};"
                  >
                    {%- if block.settings.image != blank -%}
                      {{-
                        block.settings.image
                        | image_url: width: 2000
                        | image_tag:
                          class: 'journey-timeline__final-image',
                          widths: '480, 720, 960, 1200, 1600, 2000',
                          sizes: '(min-width: 1200px) 1100px, 100vw',
                          loading: 'lazy',
                          alt: final_image_alt
                      -}}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'journey-timeline__placeholder' }}
                    {%- endif -%}

                    {%- if block.settings.quote != blank -%}
                      <blockquote class="journey-timeline__quote journey-timeline__quote--{{ block.settings.quote_alignment }}">
                        {{ block.settings.quote | escape | newline_to_br }}
                      </blockquote>
                    {%- endif -%}
                  </div>
                {%- elsif block.settings.quote != blank -%}
                  <blockquote class="journey-timeline__quote journey-timeline__quote--standalone journey-timeline__quote--{{ block.settings.quote_alignment }}">
                    {{ block.settings.quote | escape | newline_to_br }}
                  </blockquote>
                {%- endif -%}
              </div>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #journey-timeline-{{ section.id }} {
    box-sizing: border-box;
    width: 100%;
    padding: var(--jt-padding-top) 20px var(--jt-padding-bottom);
    overflow: hidden;
    background: var(--jt-background);
    color: var(--jt-text);
  }

  #journey-timeline-{{ section.id }} *,
  #journey-timeline-{{ section.id }} *::before,
  #journey-timeline-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__container {
    width: 100%;
    max-width: var(--jt-max-width);
    margin: 0 auto;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__heading {
    margin: 0 0 clamp(32px, 5vw, 64px) 52px;
    color: var(--jt-text);
    font-size: clamp(20px, 3vw, var(--jt-heading-size));
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__heading--left {
    text-align: left;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__heading--center {
    text-align: center;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__heading--right {
    text-align: right;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__track {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--jt-item-gap);
    padding-left: 52px;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__track::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 16px;
    width: 1px;
    background: var(--jt-line);
  }

  #journey-timeline-{{ section.id }} .journey-timeline__item {
    position: relative;
    min-width: 0;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__dot {
    position: absolute;
    top: 50%;
    left: -36px;
    z-index: 1;
    width: 7px;
    height: 7px;
    border: 1px solid var(--jt-dot);
    border-radius: 50%;
    background: var(--jt-background);
    transform: translate(-50%, -50%);
  }

  #journey-timeline-{{ section.id }} .journey-timeline__body {
    display: grid;
    grid-template-columns: minmax(0, var(--jt-copy-width)) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__body--text-only {
    grid-template-columns: minmax(0, 680px);
  }

  #journey-timeline-{{ section.id }} .journey-timeline__copy {
    min-width: 0;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__title {
    margin: 0 0 10px;
    color: var(--jt-text);
    font-size: clamp(16px, 1.7vw, 24px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__description,
  #journey-timeline-{{ section.id }} .journey-timeline__description p {
    margin: 0;
    color: var(--jt-muted);
    font-size: clamp(12px, 1.15vw, 15px);
    line-height: 1.5;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__gallery {
    display: grid;
    grid-template-columns: repeat(var(--jt-columns-desktop), minmax(0, 1fr));
    gap: var(--jt-gallery-gap);
    min-width: 0;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__image-wrap,
  #journey-timeline-{{ section.id }} .journey-timeline__final-image-wrap {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  #journey-timeline-{{ section.id }} .journey-timeline__image-wrap {
    aspect-ratio: var(--jt-image-ratio);
  }

  #journey-timeline-{{ section.id }} .journey-timeline__image,
  #journey-timeline-{{ section.id }} .journey-timeline__final-image,
  #journey-timeline-{{ section.id }} .journey-timeline__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__placeholder {
    min-height: 220px;
    fill: rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
  }

  #journey-timeline-{{ section.id }} .journey-timeline__item--final .journey-timeline__dot {
    top: 13px;
    transform: translateX(-50%);
  }

  #journey-timeline-{{ section.id }} .journey-timeline__copy--final {
    margin-bottom: 24px;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__title--final {
    font-size: clamp(18px, 2vw, 28px);
    text-transform: uppercase;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__final-image-wrap {
    aspect-ratio: var(--jt-final-image-ratio);
  }

  #journey-timeline-{{ section.id }} .journey-timeline__final-image-wrap::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 45%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.82), transparent);
    pointer-events: none;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__quote {
    position: absolute;
    right: 24px;
    bottom: 22px;
    left: 24px;
    z-index: 1;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--jt-text);
    font-size: clamp(14px, 1.8vw, 22px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
    quotes: none;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__quote::before,
  #journey-timeline-{{ section.id }} .journey-timeline__quote::after {
    content: none;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__quote--center {
    text-align: center;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__quote--right {
    text-align: right;
  }

  #journey-timeline-{{ section.id }} .journey-timeline__quote--standalone {
    position: static;
    margin-top: 20px;
  }

  @media (max-width: 749px) {
    #journey-timeline-{{ section.id }} {
      padding-right: 14px;
      padding-left: 14px;
    }

    #journey-timeline-{{ section.id }} .journey-timeline__heading {
      margin-left: 28px;
      margin-bottom: 32px;
    }

    #journey-timeline-{{ section.id }} .journey-timeline__track {
      gap: max(28px, var(--jt-item-gap));
      padding-left: 28px;
    }

    #journey-timeline-{{ section.id }} .journey-timeline__track::before {
      left: 7px;
    }

    #journey-timeline-{{ section.id }} .journey-timeline__dot {
      left: -21px;
    }

    #journey-timeline-{{ section.id }} .journey-timeline__body {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    #journey-timeline-{{ section.id }} .journey-timeline__gallery {
      grid-template-columns: repeat(var(--jt-columns-mobile), minmax(0, 1fr));
    }

    #journey-timeline-{{ section.id }} .journey-timeline__copy--final {
      margin-bottom: 16px;
    }

    #journey-timeline-{{ section.id }} .journey-timeline__quote {
      right: 14px;
      bottom: 14px;
      left: 14px;
      font-size: 14px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Journey Timeline",
  "tag": "section",
  "class": "section-journey-timeline",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề",
      "default": "NHỮNG HÀNH TRÌNH ĐÃ ĐỒNG HÀNH"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn lề tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" },
        { "value": "right", "label": "Phải" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Cỡ tiêu đề",
      "default": 28
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Chiều rộng tối đa",
      "default": 1200
    },
    {
      "type": "range",
      "id": "copy_width",
      "min": 25,
      "max": 55,
      "step": 5,
      "unit": "%",
      "label": "Độ rộng cột nội dung",
      "default": 35
    },
    {
      "type": "range",
      "id": "gallery_gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Khoảng cách ảnh",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Khoảng cách các mốc",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Khoảng cách phía trên",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Khoảng cách phía dưới",
      "default": 64
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Màu nền",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Màu chữ chính",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Màu chữ mô tả",
      "default": "#b8b8b8"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Màu đường timeline",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Màu điểm timeline",
      "default": "#f8f8f8"
    }
  ],
  "blocks": [
    {
      "type": "journey_item",
      "name": "Mốc hành trình",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tiêu đề",
          "default": "Tên hành trình"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Mô tả",
          "default": "<p>Thêm nội dung mô tả cho hành trình.</p>"
        },
        {
          "type": "range",
          "id": "image_count",
          "min": 1,
          "max": 8,
          "step": 1,
          "label": "Số ảnh hiển thị",
          "default": 2
        },
        {
          "type": "range",
          "id": "desktop_columns",
          "min": 1,
          "max": 4,
          "step": 1,
          "label": "Số cột ảnh desktop",
          "default": 2
        },
        {
          "type": "select",
          "id": "mobile_columns",
          "label": "Số cột ảnh mobile",
          "options": [
            { "value": "1", "label": "1 cột" },
            { "value": "2", "label": "2 cột" }
          ],
          "default": "2"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Tỷ lệ ảnh",
          "options": [
            { "value": "3 / 4", "label": "Dọc (3:4)" },
            { "value": "1 / 1", "label": "Vuông (1:1)" },
            { "value": "4 / 3", "label": "Ngang (4:3)" },
            { "value": "auto", "label": "Theo ảnh gốc" }
          ],
          "default": "3 / 4"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Ảnh 1"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Ảnh 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Ảnh 3"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Ảnh 4"
        },
        {
          "type": "image_picker",
          "id": "image_5",
          "label": "Ảnh 5"
        },
        {
          "type": "image_picker",
          "id": "image_6",
          "label": "Ảnh 6"
        },
        {
          "type": "image_picker",
          "id": "image_7",
          "label": "Ảnh 7"
        },
        {
          "type": "image_picker",
          "id": "image_8",
          "label": "Ảnh 8"
        }
      ]
    },
    {
      "type": "final_item",
      "name": "Mốc cuối hành trình",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tiêu đề",
          "default": "HÀNH TRÌNH VẪN ĐANG TIẾP DIỄN"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Mô tả",
          "default": "<p>Mỗi hành trình là một dấu ấn. Và hành trình tiếp theo vẫn đang chờ được viết tiếp.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ảnh lớn"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Tỷ lệ ảnh lớn",
          "options": [
            { "value": "16 / 9", "label": "Ngang (16:9)" },
            { "value": "4 / 3", "label": "Ngang (4:3)" },
            { "value": "3 / 4", "label": "Dọc (3:4)" },
            { "value": "auto", "label": "Theo ảnh gốc" }
          ],
          "default": "16 / 9"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Câu trích dẫn",
          "default": "“Lấy cuộc sống làm mặt giấy, lấy trải nghiệm để vẽ nên mình.”"
        },
        {
          "type": "select",
          "id": "quote_alignment",
          "label": "Căn lề câu trích dẫn",
          "options": [
            { "value": "left", "label": "Trái" },
            { "value": "center", "label": "Giữa" },
            { "value": "right", "label": "Phải" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journey Timeline",
      "blocks": [
        {
          "type": "journey_item",
          "settings": {
            "title": "Ra mắt BST Men's Armor",
            "description": "<p>Dấu ấn đầu tiên trên hành trình đồng hành cùng cộng đồng.</p>",
            "image_count": 2
          }
        },
        {
          "type": "journey_item",
          "settings": {
            "title": "Show Trừ Bảo",
            "description": "<p>Một hành trình mang cá tính và tinh thần riêng.</p>",
            "image_count": 2
          }
        },
        {
          "type": "journey_item",
          "settings": {
            "title": "Show Đông Fest",
            "description": "<p>Những khoảnh khắc đáng nhớ trên hành trình.</p>",
            "image_count": 2
          }
        },
        {
          "type": "final_item"
        }
      ]
    }
  ]
}
{% endschema %}
