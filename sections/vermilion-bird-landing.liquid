<script>
  if (!customElements.get('vermilion-bird-landing')) {
    customElements.define('vermilion-bird-landing', class extends HTMLElement {
      connectedCallback() {
        this.querySelectorAll('[data-vbl-slider]').forEach((slider) => {
          if (slider.dataset.vblBound === 'true') return;
          slider.dataset.vblBound = 'true';
          slider.addEventListener('click', () => {
            const slides = Array.from(slider.querySelectorAll('.vbl-slider__slide'));
            const current = Math.max(0, slides.findIndex((slide) => slide.classList.contains('is-active')));
            slides[current].classList.remove('is-active');
            slides[(current + 1) % slides.length].classList.add('is-active');
          });
        });

        this.querySelectorAll('[data-vbl-video]').forEach((surface) => {
          if (surface.dataset.vblBound === 'true') return;
          surface.dataset.vblBound = 'true';
          const video = surface.querySelector('video');
          if (!video) return;

          const syncState = () => {
            const isPlaying = !video.paused && !video.ended;
            surface.classList.toggle('is-playing', isPlaying);
            surface.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
          };
          const toggleVideo = () => {
            if (video.paused || video.ended) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          };

          surface.addEventListener('click', toggleVideo);
          surface.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            toggleVideo();
          });
          video.addEventListener('play', syncState);
          video.addEventListener('pause', syncState);
          video.addEventListener('ended', syncState);
        });
      }
    });
  }
</script>

