{{ 'centered-slide.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign mobile_slide_width = 100.0 | divided_by: section.settings.mobile_slides
  assign mobile_gap_offset = section.settings.mobile_gap | times: 1.0 | divided_by: section.settings.mobile_slides
  assign mobile_side_fade = 100 | minus: section.settings.mobile_side_opacity | divided_by: 100.0
-%}
<div
  id="CenteredSlide-{{ section.id }}"
  class="centered-slide{% unless section.settings.show_arrows %} centered-slide--hide-arrows{% endunless %}{% unless section.settings.show_mobile_arrows %} centered-slide--hide-mobile-arrows{% endunless %}{% unless section.settings.show_dots %} centered-slide--hide-dots{% endunless %}"
  style="
    --centered-slide-desktop-gap: {{ section.settings.desktop_gap }}px;
    --centered-slide-mobile-gap: {{ section.settings.mobile_gap }}px;
    --centered-slide-mobile-height: {{ section.settings.mobile_height }}px;
    --centered-slide-mobile-item-width: calc({{ mobile_slide_width }}vw - {{ mobile_gap_offset }}px);
    --centered-slide-speed: {{ section.settings.transition_speed }}ms;
    --centered-slide-side-fade: {{ mobile_side_fade }};
    --centered-slide-side-blur: {{ section.settings.mobile_side_blur }}px;
    --centered-slide-side-scale: {{ section.settings.mobile_side_scale | divided_by: 100.0 }};
  "
>
  <div class="list">
    {% for block in section.blocks %}
      <div class="item">
        <a href="{{ block.settings.link }}">
          <picture>
            <source media="(min-width:768px)" srcset="{{ block.settings.desktop_image | image_url }}">
            <img src="{{ block.settings.mobile_image | image_url: width: 1024 }}" alt="{{ block.settings.mobile_image.alt }}" width="1024" height="{{ 1024 | divided_by: block.settings.mobile_image.aspect_ratio | round }}">
          </picture>
        </a>
      </div>
    {% endfor %}
  </div>
  <div class="buttons">
    <button type="button" data-centered-slide-prev aria-label="Previous slide">{% render "svg-chevron-left" %}</button>
    <button type="button" data-centered-slide-next aria-label="Next slide">{% render "svg-chevron-right" %}</button>
  </div>
  <ul class="dots">
    {% for block in section.blocks %}
      <li class="{% if forloop.first %}active{% endif %}"></li>
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "Centered Slide",
  "settings": [
    {
      "type": "header",
      "content": "Bố cục"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Khoảng cách desktop",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Chiều cao mobile",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "mobile_slides",
      "label": "Số slide hiển thị trên mobile",
      "min": 1.1,
      "max": 2.5,
      "step": 0.1,
      "default": 1.4
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Khoảng cách mobile",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Tốc độ chuyển slide",
      "min": 200,
      "max": 1200,
      "step": 50,
      "unit": "ms",
      "default": 550
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Hiển thị nút mũi tên desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile_arrows",
      "label": "Hiển thị nút mũi tên mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Hiển thị dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Hiệu ứng slide hai bên trên mobile"
    },
    {
      "type": "range",
      "id": "mobile_side_opacity",
      "label": "Độ rõ ở mép ngoài",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45,
      "info": "Càng thấp thì slide càng tối dần về phía mép màn hình."
    },
    {
      "type": "range",
      "id": "mobile_side_blur",
      "label": "Độ blur",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_side_scale",
      "label": "Kích thước slide hai bên",
      "min": 80,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 94
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Centered Slide",
      "category": "Slideshow"
    }
  ]
}
{% endschema %}

<script>
(() => {
const section = document.getElementById('CenteredSlide-{{ section.id }}');
if (!section) return;

let slider = section.querySelector('.list');
let next = section.querySelector('[data-centered-slide-next]');
let prev = section.querySelector('[data-centered-slide-prev]');
let dots = section.querySelectorAll('.dots li');
let originalItems = Array.from(section.querySelectorAll('.list .item'));

if (!slider || !originalItems.length || !next || !prev) return;

let total = originalItems.length;
let items = originalItems;
let active = 0;
let isAnimating = false;

function prepareLoop() {
    if (total < 2) return;

    let firstClone = originalItems[0].cloneNode(true);
    let lastClone = originalItems[total - 1].cloneNode(true);
    firstClone.setAttribute('aria-hidden', 'true');
    lastClone.setAttribute('aria-hidden', 'true');
    firstClone.querySelectorAll('a, button').forEach((element) => element.setAttribute('tabindex', '-1'));
    lastClone.querySelectorAll('a, button').forEach((element) => element.setAttribute('tabindex', '-1'));

    slider.insertBefore(lastClone, originalItems[0]);
    slider.appendChild(firstClone);
    items = Array.from(slider.querySelectorAll('.item'));
    active = 1;
}

function getRealIndex() {
    if (total < 2) return 0;
    if (active === 0) return total - 1;
    if (active === total + 1) return 0;
    return active - 1;
}

function updateDots() {
    let lastActiveDot = section.querySelector('.dots li.active');
    if (lastActiveDot) lastActiveDot.classList.remove('active');
    let currentDot = dots[getRealIndex()];
    if (currentDot) currentDot.classList.add('active');
}

function updateSlideStates() {
    items.forEach((item, index) => {
        item.classList.toggle('is-active', index === active);
        item.classList.toggle('is-before', index < active);
        item.classList.toggle('is-after', index > active);
    });
}

function reloadSlider(animate = true) {
    let currentItem = items[active];
    if (!currentItem) return;

    if (!animate) {
        section.classList.add('is-jumping');
        slider.style.transition = 'none';
    }
    let centeredOffset = (section.clientWidth - currentItem.offsetWidth) / 2;
    let translateX = centeredOffset - currentItem.offsetLeft;
    slider.style.transform = 'translate3d(' + translateX + 'px, 0, 0)';
    updateSlideStates();
    updateDots();

    if (!animate) {
        slider.offsetHeight;
        slider.style.transition = '';
        section.classList.remove('is-jumping');
    }
}

prepareLoop();
reloadSlider(false);

next.onclick = function(){
    if (isAnimating || total < 2) return;
    isAnimating = true;
    active += 1;
    reloadSlider();
}
prev.onclick = function(){
    if (isAnimating || total < 2) return;
    isAnimating = true;
    active -= 1;
    reloadSlider();
}

dots.forEach((li, key) => {
    li.addEventListener('click', ()=>{
        if (isAnimating || key === getRealIndex()) return;
        isAnimating = true;
        active = total > 1 ? key + 1 : 0;
        reloadSlider();
    })
})

slider.addEventListener('transitionend', (event) => {
    if (event.propertyName !== 'transform') return;
    if (total > 1 && active === 0) {
        active = total;
        reloadSlider(false);
    } else if (total > 1 && active === total + 1) {
        active = 1;
        reloadSlider(false);
    }
    isAnimating = false;
});

window.addEventListener('resize', function() {
    reloadSlider(false);
});
  
let startX = 0;
let endX = 0;
let startY = 0;
let endY = 0;
let isDragging = false;
const dragThreshold = 10; // Ngưỡng để xác định kéo

slider.addEventListener('mousedown', (e) => {
    startX = e.clientX;
    isDragging = false; // Reset trạng thái kéo
    e.preventDefault(); // Ngăn hành vi mặc định như chọn văn bản
});

slider.addEventListener('mousemove', (e) => {
    if (e.buttons === 1) { // Chỉ kích hoạt khi chuột trái đang giữ
        endX = e.clientX;
        if (Math.abs(startX - endX) > dragThreshold) {
            isDragging = true; // Đánh dấu là kéo nếu vượt ngưỡng
        }
    }
});

slider.addEventListener('mouseup', (e) => {
    if (isDragging) {
        handleSwipe(); // Xử lý vuốt nếu đang kéo
    }
    startX = 0;
    endX = 0;
});

slider.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
    isDragging = false; // Reset trạng thái kéo
});

slider.addEventListener('touchmove', (e) => {
    endX = e.touches[0].clientX;
    endY = e.touches[0].clientY;
    if (Math.abs(startX - endX) > dragThreshold && Math.abs(startX - endX) > Math.abs(startY - endY)) {
        isDragging = true; // Đánh dấu là kéo nếu vượt ngưỡng
    }
});

slider.addEventListener('touchend', (e) => {
    if (isDragging) {
        handleSwipe(); // Xử lý vuốt nếu đang kéo
    }
    startX = 0;
    endX = 0;
    startY = 0;
    endY = 0;
});

slider.addEventListener('click', (e) => {
    if (isDragging) {
        e.preventDefault(); // Ngăn click nếu đang kéo
    }
});

function handleSwipe() {
    if (startX - endX > dragThreshold) {
        next.click(); // Kéo sang trái
    } else if (endX - startX > dragThreshold) {
        prev.click(); // Kéo sang phải
    }
}
})();
</script>
