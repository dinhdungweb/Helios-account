{{ 'centered-slide.css' | asset_url | stylesheet_tag }}
<div id="CenteredSlide-{{ section.id }}" class="centered-slide">
  <div class="list">
    {% for block in section.blocks %}
      <div class="item">
        <a href="{{ block.settings.link }}">
          <picture>
            <source media="(min-width:768px)" srcset="{{ block.settings.desktop_image | image_url }}">
            <img src="{{ block.settings.mobile_image | image_url: width: 1024 }}" alt="{{ block.settings.mobile_image.alt }}" width="1024" height="{{ 1024 | divided_by: block.settings.mobile_image.aspect_ratio | round }}">
          </picture>
        </a>
      </div>
    {% endfor %}
  </div>
  <div class="buttons">
    <button type="button" data-centered-slide-prev aria-label="Previous slide">{% render "svg-chevron-left" %}</button>
    <button type="button" data-centered-slide-next aria-label="Next slide">{% render "svg-chevron-right" %}</button>
  </div>
  <ul class="dots">
    {% for block in section.blocks %}
      <li class="{% if forloop.first %}active{% endif %}"></li>
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "Centered Slide",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Centered Slide",
      "category": "Slideshow"
    }
  ]
}
{% endschema %}

<script>
(() => {
const section = document.getElementById('CenteredSlide-{{ section.id }}');
if (!section) return;

let slider = section.querySelector('.list');
let next = section.querySelector('[data-centered-slide-next]');
let prev = section.querySelector('[data-centered-slide-prev]');
let dots = section.querySelectorAll('.dots li');
let originalItems = Array.from(section.querySelectorAll('.list .item'));

if (!slider || !originalItems.length || !next || !prev) return;

let total = originalItems.length;
let items = originalItems;
let active = 0;
let isAnimating = false;

function prepareLoop() {
    if (total < 2) return;

    let firstClone = originalItems[0].cloneNode(true);
    let lastClone = originalItems[total - 1].cloneNode(true);
    firstClone.setAttribute('aria-hidden', 'true');
    lastClone.setAttribute('aria-hidden', 'true');
    firstClone.querySelectorAll('a, button').forEach((element) => element.setAttribute('tabindex', '-1'));
    lastClone.querySelectorAll('a, button').forEach((element) => element.setAttribute('tabindex', '-1'));

    slider.insertBefore(lastClone, originalItems[0]);
    slider.appendChild(firstClone);
    items = Array.from(slider.querySelectorAll('.item'));
    active = 1;
}

function getRealIndex() {
    if (total < 2) return 0;
    if (active === 0) return total - 1;
    if (active === total + 1) return 0;
    return active - 1;
}

function updateDots() {
    let lastActiveDot = section.querySelector('.dots li.active');
    if (lastActiveDot) lastActiveDot.classList.remove('active');
    let currentDot = dots[getRealIndex()];
    if (currentDot) currentDot.classList.add('active');
}

function reloadSlider(animate = true) {
    let currentItem = items[active];
    if (!currentItem) return;

    if (!animate) slider.style.transition = 'none';
    let centeredOffset = (section.clientWidth - currentItem.offsetWidth) / 2;
    let translateX = centeredOffset - currentItem.offsetLeft;
    slider.style.transform = 'translate3d(' + translateX + 'px, 0, 0)';
    updateDots();

    if (!animate) {
        slider.offsetHeight;
        slider.style.transition = '';
    }
}

prepareLoop();
reloadSlider(false);

next.onclick = function(){
    if (isAnimating || total < 2) return;
    isAnimating = true;
    active += 1;
    reloadSlider();
}
prev.onclick = function(){
    if (isAnimating || total < 2) return;
    isAnimating = true;
    active -= 1;
    reloadSlider();
}

dots.forEach((li, key) => {
    li.addEventListener('click', ()=>{
        if (isAnimating || key === getRealIndex()) return;
        isAnimating = true;
        active = total > 1 ? key + 1 : 0;
        reloadSlider();
    })
})

slider.addEventListener('transitionend', (event) => {
    if (event.propertyName !== 'transform') return;
    if (total > 1 && active === 0) {
        active = total;
        reloadSlider(false);
    } else if (total > 1 && active === total + 1) {
        active = 1;
        reloadSlider(false);
    }
    isAnimating = false;
});

window.addEventListener('resize', function() {
    reloadSlider(false);
});
  
let startX = 0;
let endX = 0;
let startY = 0;
let endY = 0;
let isDragging = false;
const dragThreshold = 10; // Ngưỡng để xác định kéo

slider.addEventListener('mousedown', (e) => {
    startX = e.clientX;
    isDragging = false; // Reset trạng thái kéo
    e.preventDefault(); // Ngăn hành vi mặc định như chọn văn bản
});

slider.addEventListener('mousemove', (e) => {
    if (e.buttons === 1) { // Chỉ kích hoạt khi chuột trái đang giữ
        endX = e.clientX;
        if (Math.abs(startX - endX) > dragThreshold) {
            isDragging = true; // Đánh dấu là kéo nếu vượt ngưỡng
        }
    }
});

slider.addEventListener('mouseup', (e) => {
    if (isDragging) {
        handleSwipe(); // Xử lý vuốt nếu đang kéo
    }
    startX = 0;
    endX = 0;
});

slider.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
    isDragging = false; // Reset trạng thái kéo
});

slider.addEventListener('touchmove', (e) => {
    endX = e.touches[0].clientX;
    endY = e.touches[0].clientY;
    if (Math.abs(startX - endX) > dragThreshold && Math.abs(startX - endX) > Math.abs(startY - endY)) {
        isDragging = true; // Đánh dấu là kéo nếu vượt ngưỡng
    }
});

slider.addEventListener('touchend', (e) => {
    if (isDragging) {
        handleSwipe(); // Xử lý vuốt nếu đang kéo
    }
    startX = 0;
    endX = 0;
    startY = 0;
    endY = 0;
});

slider.addEventListener('click', (e) => {
    if (isDragging) {
        e.preventDefault(); // Ngăn click nếu đang kéo
    }
});

function handleSwipe() {
    if (startX - endX > dragThreshold) {
        next.click(); // Kéo sang trái
    } else if (endX - startX > dragThreshold) {
        prev.click(); // Kéo sang phải
    }
}
})();
</script>
