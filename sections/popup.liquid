{%- liquid
  assign popup_visible = false
  if section.settings.display_scope == 'all'
    assign popup_visible = true
  elsif section.settings.display_scope == 'home' and template.name == 'index'
    assign popup_visible = true
  elsif section.settings.display_scope == 'selected'
    assign current_path = request.path
    assign current_path_last = current_path | slice: -1, 1
    if current_path != '/' and current_path_last == '/'
      assign current_path_size = current_path.size | minus: 1
      assign current_path = current_path | slice: 0, current_path_size
    endif

    assign allowed_paths = section.settings.allowed_paths | split: ','
    for allowed_path in allowed_paths
      assign target_path = allowed_path | strip
      if target_path != blank
        assign target_last = target_path | slice: -1, 1
        if target_last == '*'
          assign prefix_size = target_path.size | minus: 1
          assign path_prefix = target_path | slice: 0, prefix_size
          assign actual_prefix = current_path | slice: 0, prefix_size
          if actual_prefix == path_prefix
            assign popup_visible = true
            break
          endif
        else
          if target_path != '/' and target_last == '/'
            assign target_size = target_path.size | minus: 1
            assign target_path = target_path | slice: 0, target_size
          endif
          if current_path == target_path
            assign popup_visible = true
            break
          endif
        endif
      endif
    endfor
  endif

  if request.design_mode
    assign popup_visible = true
  endif

  assign privacy_policy_url = section.settings.privacy_policy_url | default: shop.privacy_policy.url
  assign popup_backdrop_overlay_alpha = section.settings.popup_backdrop_overlay_opacity | divided_by: 100.0
-%}

{% if section.settings.mode != 'disabled' and popup_visible %}

  <style>
    .section-{{ section.id }} .cc-popup-modal {
      background-color: {{ section.settings.popup_background_color }};
      color: {{ section.settings.popup_text_color }};
    }
    {% if section.settings.popup_backdrop_overlay_opacity > 0 %}
      .section-{{ section.id }}.cc-popup:not(.store-availabilities-modal) .cc-popup-background {
        background: {{ section.settings.popup_backdrop_overlay_color | color_modify: 'alpha', popup_backdrop_overlay_alpha }} !important;
        pointer-events: auto;
      }
    {% endif %}
    @media (max-width: 767px) {
      .section-{{ section.id }} .cc-popup-modal {
        box-sizing: border-box;
        width: calc(100% - 24px);
        margin: 0 12px;
      }
    }
    .section-{{ section.id }} .cc-popup-modal.cc-popup-modal--has-image .cc-popup-content,
    .section-{{ section.id }} .cc-popup-close {
      color: {{ section.settings.popup_text_color }} !important;
    }
    .section-{{ section.id }} .cc-popup-close svg {
      stroke: {{ section.settings.popup_text_color }} !important;
    }
    .section-{{ section.id }} .cc-popup-form-submit {
      background-color: {{ section.settings.button_background_color }} !important;
      border-color: {{ section.settings.button_background_color }} !important;
      color: {{ section.settings.button_text_color }} !important;
    }
    .section-{{ section.id }} .cc-popup-consent {
      margin: 8px 0 12px;
      text-align: left;
      font-size: 13px;
      line-height: 1.45;
    }
    .section-{{ section.id }} .cc-popup-consent-label {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      cursor: pointer;
      margin: 0;
      font-size: 1em;
      line-height: 1.45;
      letter-spacing: normal;
      text-transform: none;
    }
    .section-{{ section.id }} .cc-popup-consent-label input {
      flex: none;
      width: 16px;
      height: 16px;
      margin: 2px 0 0;
      accent-color: {{ section.settings.popup_text_color }};
    }
    .section-{{ section.id }} .cc-popup-consent-note {
      margin: 10px 0 0;
      text-align: left;
      font-size: 12px;
      line-height: 1.45;
    }
    .section-{{ section.id }} .cc-popup-consent-note a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .section-{{ section.id }} .cc-popup-modal--horizontal {
      padding: 0;
      max-height: calc(100vh - 24px);
      overflow-y: auto;
    }
    .section-{{ section.id }} .cc-popup-modal--horizontal .cc-popup-container {
      flex-direction: column;
    }
    .section-{{ section.id }} .cc-popup-horizontal-media {
      position: relative;
      height: 250px;
      flex: none;
      overflow: hidden;
    }
    .section-{{ section.id }} .cc-popup-horizontal-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .section-{{ section.id }} .cc-popup-modal--horizontal .cc-popup-content {
      width: 100%;
      min-width: 0;
      padding: 5px 28px 30px;
    }
    .section-{{ section.id }} .cc-popup-modal--horizontal .cc-popup-close {
      top: 8px;
      right: 8px;
      z-index: 2;
      background: rgba(0, 0, 0, 0.65) !important;
      border-radius: 50%;
    }
    .section-{{ section.id }} .cc-popup-modal--horizontal .cc-popup-close svg {
      stroke: #ffffff !important;
    }
    @media (min-width: 768px) {
      .section-{{ section.id }} .cc-popup-modal--horizontal-has-image {
        width: min(760px, calc(100vw - 48px));
      }
      .section-{{ section.id }} .cc-popup-modal--horizontal .cc-popup-container {
        flex-direction: row;
      }
      .section-{{ section.id }} .cc-popup-modal--horizontal .cc-popup-container--reverse {
        flex-direction: row-reverse;
      }
      .section-{{ section.id }} .cc-popup-horizontal-media {
        width: 44%;
        height: auto;
        min-height: 380px;
      }
      .section-{{ section.id }} .cc-popup-horizontal-image {
        position: absolute;
        inset: 0;
      }
      .section-{{ section.id }} .cc-popup-modal--horizontal .cc-popup-content {
        flex: 1;
        padding: 48px 38px;
      }
    }
  </style>

  <section class="section-{{ section.id }} cc-popup cc-popup--{{ section.settings.position }}"
    data-freeze-scroll="false"
    data-section-id="{{ section.id }}"
    data-section-type="newsletter-popup"
    data-dismiss-for-days="{{ section.settings.popup_dismiss_for_days }}"
    data-delay-seconds="{{ section.settings.popup_delay_seconds }}"
    data-test-mode="{% if section.settings.mode == 'testing' %}true{% else %}false{% endif %}">
    <div class="cc-popup-background"></div>
    <div class="cc-popup-modal{% if section.settings.layout == 'horizontal' %} cc-popup-modal--horizontal{% if section.settings.horizontal_image != blank %} cc-popup-modal--horizontal-has-image{% endif %}{% elsif section.settings.image != blank %} cc-popup-modal--has-image{% endif %}"
         role="dialog"
         aria-modal="true">

      <button type="button" class="cc-popup-close" aria-label="{{ 'general.accessibility_labels.close' | t | escape }}">
        {% render 'popup-close' %}
      </button>

      <div class="cc-popup-container{% if section.settings.layout == 'horizontal' and section.settings.image_position == 'right' %} cc-popup-container--reverse{% endif %}">

        {%- if section.settings.layout == 'horizontal' and section.settings.horizontal_image != blank -%}
          <div class="cc-popup-horizontal-media">
            {{ section.settings.horizontal_image | image_url: width: 960 | image_tag: widths: '360, 540, 720, 960', sizes: '(min-width: 768px) 340px, 100vw', loading: 'lazy', class: 'cc-popup-horizontal-image' }}
          </div>
        {%- elsif section.settings.layout != 'horizontal' and section.settings.image != blank -%}
          <div class="cc-popup-image">
            {% render 'responsive-image', image: section.settings.image, cover: true %}
          </div>
        {%- endif -%}

        {%- if section.settings.title != blank or section.settings.text != blank or section.settings.show_newsletter == true or section.settings.show_social_icons == true -%}
          <div class="cc-popup-content">
            <div class="cc-popup-column">
              {%- capture popup_top_content -%}
                {%- if section.settings.title != blank or section.settings.text != blank -%}
                  <div class="cc-popup-text">
                    {%- if section.settings.title != blank -%}
                      <h2 class="cc-popup-title">{{ section.settings.title | escape }}</h2>
                    {%- endif -%}
                    {%- if section.settings.text != blank -%}
                      <div class="rte">{{ section.settings.text }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endcapture -%}

              {%- capture popup_bottom_content -%}
                {%- if section.settings.show_social_icons == true -%}
                  <div class="cc-popup-social">
                    {%- if section.settings.social_title != blank -%}
                      <h3>{{ section.settings.social_title }}</h3>
                    {%- endif -%}
                    {% render 'social-icons', icon_setting: settings.social_custom_icon, icon_size: 'x32' %}
                  </div>
                {%- endif -%}
              {%- endcapture -%}

              {%- if section.settings.show_newsletter == true -%}
                <div class="cc-popup-form">
                  {% form 'customer', id: 'cc-popup' %}
                    {% unless form.posted_successfully? %}
                      {{ popup_top_content }}
                    {% endunless %}

                    {% if form.posted_successfully? %}
                      <div class="cc-popup-form__response cc-popup-form__response--success">
                        <h4>{{ section.settings.success_text | escape }}</h4>
                      </div>
                    {% else %}
                      {% if form.errors %}
                        <div class="cc-popup-form__response cc-popup-form__response--error">
                          {% for field in form.errors %}
                          <p class="error-message">{{ field | capitalize }} - {{ form.errors.messages[field] }}</p>
                          {% endfor %}
                        </div>
                      {% endif %}
                      <input type="hidden" name="contact[tags]" value="prospect,newsletter,{{ section.settings.customer_tag | escape }}"/>
                      <div class="cc-popup-form__inputs">
                        <div class="cc-popup-form__input-wrapper">
                          <label class="visually-hidden" for="cc-popup-mailinglist_email">{{ section.settings.email_placeholder | escape }}</label>
                          <input type="email" required class="cc-popup-form-input" value="" id="cc-popup-mailinglist_email" name="contact[email]" autocomplete="email" placeholder="{{ section.settings.email_placeholder | escape }}" />
                        </div>
                        <div class="cc-popup-consent">
                          <label class="cc-popup-consent-label" for="cc-popup-marketing-consent">
                            <input type="checkbox" id="cc-popup-marketing-consent" name="email_marketing_consent" value="yes" required{% if section.settings.consent_checked_by_default %} checked{% endif %}>
                            <span>{{ section.settings.consent_label | escape }}</span>
                          </label>
                        </div>
                        <div class="cc-popup-form-buttons">
                          <button class="btn btn--primary button cc-popup-form-submit" type="submit">{{ section.settings.submit_text | escape }}</button>
                        </div>
                      </div>
                      <p class="cc-popup-consent-note">
                        {{ section.settings.frequency_text | escape }}
                        {% if privacy_policy_url != blank %}
                          <a href="{{ privacy_policy_url | escape }}">Chính sách bảo mật</a>
                        {% elsif request.design_mode %}
                          <span>Hãy thêm Chính sách bảo mật trong Shopify hoặc chọn liên kết bên dưới.</span>
                        {% endif %}
                      </p>
                    {% endif %}

                    {{ popup_bottom_content }}
                  {% endform %}
                </div>
              {%- else -%}
                {{ popup_top_content }}
                {{ popup_bottom_content }}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </section>

{% endif %}

{% schema %}
  {
    "name": "Popup",
    "class": "section-popup",
    "settings": [
      {
        "type": "select",
        "id": "mode",
        "label": "Display mode",
        "default": "disabled",
        "options": [
          {
            "value": "enabled",
            "label": "Enabled"
          },
          {
            "value": "testing",
            "label": "Test mode"
          },
          {
            "value": "disabled",
            "label": "Disabled"
          }
        ],
        "info": "Test mode displays your popup each time even after dismissing it. Switch to Enabled once you are happy with how your popup looks."
      },
      {
        "type": "header",
        "content": "Trang hiển thị"
      },
      {
        "type": "select",
        "id": "display_scope",
        "label": "Hiển thị trên",
        "default": "all",
        "options": [
          { "value": "all", "label": "Toàn bộ website" },
          { "value": "home", "label": "Chỉ trang chủ" },
          { "value": "selected", "label": "Các đường dẫn đã chọn" }
        ]
      },
      {
        "type": "textarea",
        "id": "allowed_paths",
        "label": "Đường dẫn được hiển thị",
        "info": "Chỉ dùng khi chọn Các đường dẫn đã chọn. Nhập đường dẫn bắt đầu bằng /, cách nhau bằng dấu phẩy. Ví dụ: /pages/gioi-thieu, /collections/nhan-bac-nam, /products/*"
      },
      {
        "type": "range",
        "id": "popup_delay_seconds",
        "label": "Delay",
        "info": "Delay is disabled in theme editor for visibility",
        "default": 5,
        "min": 2,
        "max": 60,
        "step": 1,
        "unit": "sec"
      },
      {
        "type": "range",
        "id": "popup_dismiss_for_days",
        "label": "Frequency",
        "default": 30,
        "info": "Number of days before a dismissed popup reappears",
        "min": 2,
        "max": 30,
        "step": 1,
        "unit": "day"
      },
      {
        "type": "select",
        "id": "position",
        "label": "Position",
        "default": "center",
        "options": [
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "bottom-left",
            "label": "Bottom left"
          },
          {
            "value": "bottom-right",
            "label": "Bottom right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Sign up and save"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Text",
        "default": "<p>Entice customers to sign up for your mailing list with discounts or exclusive offers.</p>"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Ảnh nền",
        "info": "Dùng cho bố cục ảnh nền."
      },
      {
        "type": "select",
        "id": "layout",
        "label": "Bố cục ảnh",
        "default": "background",
        "options": [
          { "value": "background", "label": "Ảnh nền" },
          { "value": "horizontal", "label": "Ảnh và nội dung nằm ngang" }
        ]
      },
      {
        "type": "image_picker",
        "id": "horizontal_image",
        "label": "Ảnh cho bố cục ngang",
        "info": "Hiển thị cạnh nội dung trên desktop và phía trên nội dung trên điện thoại."
      },
      {
        "type": "select",
        "id": "image_position",
        "label": "Vị trí ảnh trên desktop",
        "default": "left",
        "options": [
          { "value": "left", "label": "Bên trái" },
          { "value": "right", "label": "Bên phải" }
        ]
      },
      {
        "type": "header",
        "content": "Newsletter"
      },
      {
        "type": "paragraph",
        "content": "Customers who subscribe will have their email address added to the 'accepts marketing' [customer list](/admin/customers?query=&accepts_marketing=1)."
      },
      {
        "type": "checkbox",
        "id": "show_newsletter",
        "label": "Show newsletter signup",
        "default": true
      },
      {
        "type": "text",
        "id": "email_placeholder",
        "label": "Gợi ý ô email",
        "default": "Địa chỉ email của bạn"
      },
      {
        "type": "text",
        "id": "submit_text",
        "label": "Chữ trên nút đăng ký",
        "default": "Đăng ký nhận email"
      },
      {
        "type": "text",
        "id": "success_text",
        "label": "Thông báo đăng ký thành công",
        "default": "Cảm ơn bạn đã đăng ký!"
      },
      {
        "type": "text",
        "id": "customer_tag",
        "label": "Nhãn khách hàng",
        "default": "newsletter-popup",
        "info": "Email đăng ký sẽ có thêm nhãn này trong Shopify Customers."
      },
      {
        "type": "text",
        "id": "consent_label",
        "label": "Nội dung ô đồng ý",
        "default": "Tôi đồng ý nhận email về sản phẩm mới và ưu đãi từ HELIOS."
      },
      {
        "type": "checkbox",
        "id": "consent_checked_by_default",
        "label": "Tích sẵn ô đồng ý",
        "default": true
      },
      {
        "type": "text",
        "id": "frequency_text",
        "label": "Tần suất gửi email",
        "default": "Email được gửi theo từng chiến dịch, không theo lịch cố định."
      },
      {
        "type": "url",
        "id": "privacy_policy_url",
        "label": "Liên kết Chính sách bảo mật",
        "info": "Để trống để dùng Chính sách bảo mật trong Shopify Settings > Policies."
      },
      {
        "type": "header",
        "content": "Màu sắc"
      },
      {
        "type": "color",
        "id": "popup_background_color",
        "label": "Nền popup",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "popup_text_color",
        "label": "Chữ popup",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "button_background_color",
        "label": "Nền nút đăng ký",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "label": "Chữ nút đăng ký",
        "default": "#000000"
      },
      {
        "type": "header",
        "content": "Lớp phủ trang phía sau popup"
      },
      {
        "type": "color",
        "id": "popup_backdrop_overlay_color",
        "label": "Màu phủ trang phía sau",
        "default": "#000000"
      },
      {
        "type": "range",
        "id": "popup_backdrop_overlay_opacity",
        "label": "Độ phủ trang phía sau",
        "min": 0,
        "max": 80,
        "step": 5,
        "unit": "%",
        "default": 40
      },
      {
        "type": "header",
        "content": "Social media"
      },
      {
        "type": "checkbox",
        "id": "show_social_icons",
        "label": "Show social media icons",
        "default": true
      }
    ]
  }
{% endschema %}
