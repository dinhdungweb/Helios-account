{% comment %}
  Magazine Flipbook Section - optimized WebGL page curl with responsive double-page view
{% endcomment %}

{%- assign flipbook_section_id = 'magazine-flipbook-' | append: section.id -%}

<style>
  #{{ flipbook_section_id }} {
    position: relative;
    box-sizing: border-box;
    max-width: 100%;
    margin: 3rem auto;
    padding: 0;
    text-align: center;
    background-position: center;
    background-size: cover;
  }
  #{{ flipbook_section_id }} .magazine-flipbook-heading { margin: 0 0 1.5rem; padding: 0 1rem; font-size: 2rem; font-weight: 500; letter-spacing: 0.5px; }
  #{{ flipbook_section_id }} .magazine-reader { position: relative; display: flex; min-height: 480px; flex-direction: column; overflow: hidden; background: transparent; box-shadow: none; isolation: isolate; }
  #{{ flipbook_section_id }} .magazine-stage { position: relative; display: flex; min-height: 0; flex: 1 1 auto; align-items: center; justify-content: center; overflow: hidden; padding: 32px 68px 88px; overscroll-behavior: none; }
  #{{ flipbook_section_id }} .magazine-stage.is-zoomed:not(.is-flipping) { overflow: auto; scrollbar-width: thin; }
  #{{ flipbook_section_id }} .magazine-stage.is-flipping { overflow: hidden !important; }
  #{{ flipbook_section_id }} .magazine-flipbook-container { position: relative; z-index: 1; flex: 0 0 auto; overflow: visible; margin: auto; background: transparent; cursor: default; touch-action: none; user-select: none; }
  #{{ flipbook_section_id }} .magazine-flipbook-container.has-corner-preview { cursor: grab; }
  #{{ flipbook_section_id }} .magazine-flipbook-container.is-dragging { cursor: grabbing; }
  #{{ flipbook_section_id }} .magazine-webgl-canvas { display: block; width: 100%; height: 100%; background: transparent; touch-action: none; }
  #{{ flipbook_section_id }} .magazine-webgl-fallback { position: absolute; inset: 0; display: none; align-items: stretch; background: transparent; }
  #{{ flipbook_section_id }} .is-webgl-fallback .magazine-webgl-canvas { display: none; }
  #{{ flipbook_section_id }} .is-webgl-fallback .magazine-webgl-fallback { display: flex; }
  #{{ flipbook_section_id }} .magazine-fallback-page { display: block; width: 50%; height: 100%; flex: 0 0 50%; object-fit: contain; background: #fff; box-shadow: 0 8px 18px rgba(0, 0, 0, 0.28); }
  #{{ flipbook_section_id }} .magazine-fallback-page.is-empty { visibility: hidden; }
  #{{ flipbook_section_id }} .magazine-side-button { position: absolute; top: 50%; z-index: 8; display: grid; width: 44px; height: 64px; padding: 0; place-items: center; color: #fff; background: rgba(0, 0, 0, 0.48); border: 0; border-radius: 4px; cursor: pointer; transform: translateY(-70%); transition: background-color 0.2s ease, opacity 0.2s ease; }
  #{{ flipbook_section_id }} .magazine-side-button:hover:not(:disabled) { background: rgba(0, 0, 0, 0.8); }
  #{{ flipbook_section_id }} .magazine-side-button:disabled { cursor: default; opacity: 0; pointer-events: none; }
  #{{ flipbook_section_id }} .magazine-side-button svg { width: 20px; height: 20px; fill: currentColor; }
  #{{ flipbook_section_id }} .prev-page { left: 14px; }
  #{{ flipbook_section_id }} .next-page { right: 14px; }
  #{{ flipbook_section_id }} .magazine-toolbar { position: absolute; right: 0; bottom: 0; left: 0; z-index: 12; display: flex; min-height: 56px; align-items: center; justify-content: center; gap: 2px; padding: 7px 12px; color: #f5f5f5; background: transparent; border: 0; backdrop-filter: none; }
  #{{ flipbook_section_id }} .magazine-toolbar-button { display: grid; width: 40px; height: 40px; padding: 0; place-items: center; color: inherit; background: transparent; border: 0; border-radius: 4px; cursor: pointer; transition: color 0.2s ease, background-color 0.2s ease, opacity 0.2s ease; }
  #{{ flipbook_section_id }} .magazine-toolbar-button:hover:not(:disabled),
  #{{ flipbook_section_id }} .magazine-toolbar-button[aria-expanded="true"] { color: #fab320; background: rgba(255, 255, 255, 0.09); }
  #{{ flipbook_section_id }} .magazine-toolbar-button:disabled { cursor: default; opacity: 0.32; }
  #{{ flipbook_section_id }} .magazine-toolbar-button svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  #{{ flipbook_section_id }} .toolbar-prev svg > path:first-child,
  #{{ flipbook_section_id }} .toolbar-next svg > path:first-child { stroke: none; }
  #{{ flipbook_section_id }} .page-counter { display: flex; min-width: 92px; align-items: center; justify-content: center; gap: 6px; margin: 0 6px; color: #ddd; font-size: 13px; font-variant-numeric: tabular-nums; }
  #{{ flipbook_section_id }} .current-page-input { width: 38px; height: 30px; padding: 0 4px; color: #fff; font: inherit; text-align: center; background: rgba(255, 255, 255, 0.08); border: 0; border-radius: 3px; appearance: textfield; }
  #{{ flipbook_section_id }} .current-page-input::-webkit-inner-spin-button,
  #{{ flipbook_section_id }} .current-page-input::-webkit-outer-spin-button { margin: 0; appearance: none; }
  #{{ flipbook_section_id }} .magazine-thumbnails { position: absolute; right: 0; bottom: 56px; left: 0; z-index: 11; display: flex; max-height: 0; gap: 12px; overflow-x: auto; overflow-y: hidden; padding: 0 18px; background: rgba(12, 12, 12, 0.96); border-top: 1px solid transparent; opacity: 0; pointer-events: none; transition: max-height 0.25s ease, padding 0.25s ease, opacity 0.2s ease; }
  #{{ flipbook_section_id }} .magazine-thumbnails.is-open { max-height: 152px; padding-top: 12px; padding-bottom: 12px; border-color: rgba(255, 255, 255, 0.1); opacity: 1; pointer-events: auto; }
  #{{ flipbook_section_id }} .magazine-thumbnail { position: relative; flex: 0 0 76px; padding: 0; color: #bbb; background: transparent; border: 0; cursor: pointer; }
  #{{ flipbook_section_id }} .magazine-thumbnail img { display: block; width: 76px; height: 106px; object-fit: cover; background: #fff; border: 2px solid transparent; box-shadow: 0 3px 12px rgba(0, 0, 0, 0.45); }
  #{{ flipbook_section_id }} .magazine-thumbnail span { display: block; margin-top: 4px; font-size: 11px; }
  #{{ flipbook_section_id }} .magazine-thumbnail.is-active img { border-color: #fab320; }
  #{{ flipbook_section_id }} .magazine-thumbnail.is-active { color: #fab320; }
  #{{ flipbook_section_id }} .magazine-loading { position: absolute; top: 50%; left: 50%; z-index: 10; padding: 20px; color: #fff; background: rgba(0,0,0,0.85); border-radius: 10px; box-shadow: 0 2px 10px rgba(255,255,255,0.1); transform: translate(-50%, -50%); }
  #{{ flipbook_section_id }} .magazine-loading[hidden] { display: none; }
  #{{ flipbook_section_id }} .progress-bar { overflow: hidden; width: 100px; height: 6px; margin-top: 10px; background: #444; border-radius: 5px; }
  #{{ flipbook_section_id }} .progress-bar-inner { width: 0%; height: 100%; background: #fab320; transition: width 0.3s ease; }
  #{{ flipbook_section_id }}:fullscreen,
  #{{ flipbook_section_id }}:-webkit-full-screen { display: flex; width: 100vw; height: 100vh; margin: 0; flex-direction: column; overflow: hidden; background-color: #111; }
  #{{ flipbook_section_id }}:fullscreen .magazine-reader,
  #{{ flipbook_section_id }}:-webkit-full-screen .magazine-reader { min-height: 0; flex: 1 1 auto; }
  @media (max-width: 767.8px) {
    #{{ flipbook_section_id }} {
      {% if section.settings.background_image_mobile %}
        background-image: url('{{ section.settings.background_image_mobile | image_url }}');
      {% elsif section.settings.background_image %}
        background-image: url('{{ section.settings.background_image | image_url }}');
      {% endif %}
    }
    #{{ flipbook_section_id }} .magazine-flipbook-heading { margin-bottom: 1rem; font-size: 1.5rem; }
    #{{ flipbook_section_id }} .magazine-reader { min-height: 430px; }
    #{{ flipbook_section_id }} .magazine-stage { padding: 18px 12px 76px; }
    #{{ flipbook_section_id }} .magazine-side-button { top: auto; bottom: 66px; width: 38px; height: 52px; transform: none; }
    #{{ flipbook_section_id }} .prev-page { left: 6px; }
    #{{ flipbook_section_id }} .next-page { right: 6px; }
    #{{ flipbook_section_id }} .magazine-toolbar { min-height: 54px; padding-right: 6px; padding-left: 6px; }
    #{{ flipbook_section_id }} .magazine-toolbar-button { width: 36px; height: 38px; }
    #{{ flipbook_section_id }} .zoom-in,
    #{{ flipbook_section_id }} .zoom-out { display: none; }
    #{{ flipbook_section_id }} .page-counter { min-width: 82px; margin: 0 2px; }
    #{{ flipbook_section_id }} .magazine-thumbnails { bottom: 54px; }
  }
  @media (min-width: 768px) {
    #{{ flipbook_section_id }} {
      {% if section.settings.background_image_desktop %}
        background-image: url('{{ section.settings.background_image_desktop | image_url }}');
      {% elsif section.settings.background_image %}
        background-image: url('{{ section.settings.background_image | image_url }}');
      {% endif %}
    }
  }
</style>

<div
  id="{{ flipbook_section_id }}"
  class="magazine-flipbook-section"
  tabindex="0"
  aria-label="{{ section.settings.heading | default: 'Magazine Flipbook' | escape }}"
>
  {% if section.settings.heading != blank %}
    <h2 class="magazine-flipbook-heading">{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="magazine-loading" id="loading-{{ section.id }}" role="status" aria-live="polite">
    <span id="loading-text-{{ section.id }}">Đang tải...</span>
    <div class="progress-bar"><div class="progress-bar-inner" id="progress-{{ section.id }}"></div></div>
  </div>
  <div class="magazine-reader">
    <div class="magazine-stage">
      <div id="magazine-{{ section.id }}" class="magazine-flipbook-container"></div>
    </div>
    <button type="button" aria-label="Trang trước" class="magazine-side-button prev-page" disabled>{% render 'svg-chevron-left' %}</button>
    <button type="button" aria-label="Trang tiếp theo" class="magazine-side-button next-page">{% render 'svg-chevron-right' %}</button>
    <div class="magazine-thumbnails" aria-label="Danh sách trang"></div>
    <div class="magazine-toolbar" role="toolbar" aria-label="Công cụ xem tạp chí">
      <button type="button" class="magazine-toolbar-button thumbnails-toggle" aria-label="Hiện ảnh thu nhỏ" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="8"></rect><rect x="14" y="3" width="7" height="8"></rect><rect x="3" y="15" width="7" height="6"></rect><rect x="14" y="15" width="7" height="6"></rect></svg>
      </button>
      <button type="button" class="magazine-toolbar-button toolbar-prev" aria-label="Trang trước" disabled>{% render 'svg-chevron-left' %}</button>
      <span class="page-counter" aria-live="polite">
        <input id="current-page-{{ section.id }}" class="current-page-input" type="number" min="1" value="1" aria-label="Trang hiện tại">
        <span>/</span>
        <span id="total-pages-{{ section.id }}">0</span>
      </span>
      <button type="button" class="magazine-toolbar-button toolbar-next" aria-label="Trang tiếp theo">{% render 'svg-chevron-right' %}</button>
      <button type="button" class="magazine-toolbar-button zoom-out" aria-label="Thu nhỏ" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5M7.5 10.5h6"></path></svg>
      </button>
      <button type="button" class="magazine-toolbar-button zoom-in" aria-label="Phóng to">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5M7.5 10.5h6M10.5 7.5v6"></path></svg>
      </button>
      {% if section.settings.allow_fullscreen %}
      <button type="button" aria-label="Xem toàn màn hình" class="magazine-toolbar-button fullscreen-toggle">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path></svg>
      </button>
      {% endif %}
    </div>
  </div>
</div>

<script>
  (function() {
    const flipId = {{ section.id | json }};
    const root = document.getElementById({{ flipbook_section_id | json }});
    const webglAssetUrl = {{ 'magazine-flipbook-webgl.js' | asset_url | json }};
    const bookWidth = Number({{ section.settings.width | default: 1000 | json }}) || 1000;
    const pageHeight = Number({{ section.settings.height | default: 707 | json }}) || 707;
    const pages = [
      {%- assign rendered_page_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.page_image != blank -%}
          {%- assign page_number = rendered_page_count | plus: 1 -%}
          {%- assign fallback_alt = 'Trang tạp chí ' | append: page_number -%}
          {%- assign page_alt = block.settings.page_image.alt | default: fallback_alt -%}
          {%- if rendered_page_count > 0 -%},{%- endif -%}
          {
            "src": {{ block.settings.page_image | image_url: width: 1200 | json }},
            "srcMobile": {{ block.settings.page_image | image_url: width: 900 | json }},
            "thumb": {{ block.settings.page_image | image_url: width: 240 | json }},
            "alt": {{ page_alt | json }}
          }
          {%- assign rendered_page_count = rendered_page_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    ];

    if (!root || root.dataset.flipbookInitialized) return;
    root.dataset.flipbookInitialized = 'loading';

    function startWhenReady() {
      loadWebGLLibrary()
        .then(initializeFlipbook)
        .catch(function(error) {
          showLoadError('Không thể tải trình lật trang. Vui lòng tải lại trang.');
          console.error('Magazine Flipbook:', error);
        });
    }

    function loadWebGLLibrary() {
      if (typeof window.HeliosWebGLFlipbook === 'function') {
        return Promise.resolve(window.HeliosWebGLFlipbook);
      }

      if (!window.HeliosMagazineWebGLPromise) {
        window.HeliosMagazineWebGLPromise = new Promise(function(resolve, reject) {
          const existingScript = document.querySelector('script[data-helios-magazine-webgl]');
          const script = existingScript || document.createElement('script');

          function resolveLibrary() {
            if (typeof window.HeliosWebGLFlipbook === 'function') {
              resolve(window.HeliosWebGLFlipbook);
            } else {
              reject(new Error('The WebGL flipbook engine did not initialize.'));
            }
          }

          if (existingScript) {
            existingScript.addEventListener('load', resolveLibrary, { once: true });
            existingScript.addEventListener('error', function() {
              reject(new Error('Unable to load the WebGL flipbook engine.'));
            }, { once: true });
            return;
          }

          script.src = webglAssetUrl;
          script.async = true;
          script.dataset.heliosMagazineWebgl = 'true';
          script.addEventListener('load', resolveLibrary, { once: true });
          script.addEventListener('error', function() {
            reject(new Error('Unable to load the WebGL flipbook engine.'));
          }, { once: true });
          document.head.appendChild(script);
        });
      }

      return window.HeliosMagazineWebGLPromise;
    }

    function initializeFlipbook(WebGLFlipbook) {
      if (!root.isConnected || root.dataset.flipbookInitialized === 'true') return;

      const container = root.querySelector('#magazine-' + flipId);
      const stage = root.querySelector('.magazine-stage');
      const loading = root.querySelector('#loading-' + flipId);
      const loadingText = root.querySelector('#loading-text-' + flipId);
      const progressBar = root.querySelector('#progress-' + flipId);
      const previousButton = root.querySelector('.prev-page');
      const nextButton = root.querySelector('.next-page');
      const toolbarPreviousButton = root.querySelector('.toolbar-prev');
      const toolbarNextButton = root.querySelector('.toolbar-next');
      const thumbnailsButton = root.querySelector('.thumbnails-toggle');
      const thumbnailsPanel = root.querySelector('.magazine-thumbnails');
      const zoomOutButton = root.querySelector('.zoom-out');
      const zoomInButton = root.querySelector('.zoom-in');
      const fullscreenButton = root.querySelector('.fullscreen-toggle');
      const currentPageElement = root.querySelector('#current-page-' + flipId);
      const totalPagesElement = root.querySelector('#total-pages-' + flipId);
      const originalBodyOverflow = document.body.style.overflow;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let viewer = null;
      let currentPage = 1;
      let zoomLevel = 1;
      let resizeFrame = null;
      let resizeObserver = null;
      let destroyed = false;

      if (pages.length === 0) {
        loadingText.textContent = 'Chưa có trang tạp chí.';
        progressBar.parentElement.hidden = true;
        setNavigationDisabled(true, true);
        zoomOutButton.disabled = true;
        zoomInButton.disabled = true;
        thumbnailsButton.disabled = true;
        root.dataset.flipbookInitialized = 'true';
        return;
      }

      pages.forEach(function(pageData, index) {
        const thumbnailButton = document.createElement('button');
        const thumbnailImage = document.createElement('img');
        const thumbnailNumber = document.createElement('span');

        thumbnailButton.type = 'button';
        thumbnailButton.className = 'magazine-thumbnail';
        thumbnailButton.dataset.page = String(index + 1);
        thumbnailButton.setAttribute('aria-label', 'Mở trang ' + (index + 1));
        thumbnailImage.src = pageData.thumb;
        thumbnailImage.alt = '';
        thumbnailImage.loading = 'lazy';
        thumbnailImage.decoding = 'async';
        thumbnailNumber.textContent = String(index + 1);
        thumbnailButton.appendChild(thumbnailImage);
        thumbnailButton.appendChild(thumbnailNumber);
        thumbnailsPanel.appendChild(thumbnailButton);
      });

      const initialSize = calculateBookSize();
      applyBookSize(initialSize);

      try {
        viewer = new WebGLFlipbook(container, {
          pages: pages,
          duration: reducedMotion ? 1 : 640,
          startPage: 1,
          onLoadProgress: function(progress) {
            progressBar.style.width = Math.round(progress * 100) + '%';
          },
          onPageChange: function(page, view) {
            currentPage = page;
            updateControls(page, view);
          },
          onStateChange: function(isTurning) {
            stage.classList.toggle('is-flipping', isTurning);
          },
          onError: function(error) {
            console.warn('Magazine Flipbook WebGL:', error);
          }
        });
      } catch (error) {
        showLoadError('Không thể khởi tạo trình lật trang. Vui lòng tải lại trang.');
        console.error('Magazine Flipbook:', error);
        return;
      }

      previousButton.addEventListener('click', showPreviousPage);
      nextButton.addEventListener('click', showNextPage);
      toolbarPreviousButton.addEventListener('click', showPreviousPage);
      toolbarNextButton.addEventListener('click', showNextPage);
      thumbnailsButton.addEventListener('click', toggleThumbnails);
      thumbnailsPanel.addEventListener('click', handleThumbnailClick);
      zoomOutButton.addEventListener('click', function() { setZoom(zoomLevel - 0.25); });
      zoomInButton.addEventListener('click', function() { setZoom(zoomLevel + 0.25); });
      currentPageElement.addEventListener('change', goToInputPage);
      currentPageElement.addEventListener('keydown', handlePageInputKeydown);
      root.addEventListener('keydown', handleKeyboardNavigation);
      window.addEventListener('resize', scheduleResize, { passive: true });
      document.addEventListener('fullscreenchange', handleFullscreenChange);
      document.addEventListener('webkitfullscreenchange', handleFullscreenChange);
      document.addEventListener('shopify:section:unload', handleSectionUnload);

      if (fullscreenButton) fullscreenButton.addEventListener('click', toggleFullscreen);

      if (window.ResizeObserver) {
        resizeObserver = new ResizeObserver(scheduleResize);
        resizeObserver.observe(stage);
      }

      viewer.ready.then(function() {
        if (destroyed || !root.isConnected) return;
        totalPagesElement.textContent = String(viewer.getPageCount());
        updateControls(viewer.getPage(), viewer.getView());
        loading.hidden = true;
        root.dataset.flipbookInitialized = 'true';
      }).catch(function(error) {
        showLoadError('Không thể tải ảnh tạp chí. Vui lòng tải lại trang.');
        console.error('Magazine Flipbook:', error);
      });

      function updateControls(page, view) {
        if (!viewer) return;
        const totalPages = viewer.getPageCount();
        const safePage = Math.max(1, Math.min(Number(page) || 1, totalPages));
        const visiblePages = Array.isArray(view) ? view.filter(function(pageNumber) {
          return pageNumber > 0;
        }) : viewer.getView(safePage).filter(function(pageNumber) {
          return pageNumber > 0;
        });

        currentPageElement.value = String(safePage);
        currentPageElement.max = String(totalPages);
        setNavigationDisabled(!viewer.canPrevious(), !viewer.canNext());
        zoomOutButton.disabled = zoomLevel <= 1;
        zoomInButton.disabled = zoomLevel >= 2;

        thumbnailsPanel.querySelectorAll('.magazine-thumbnail').forEach(function(thumbnail) {
          const thumbnailPage = Number(thumbnail.dataset.page);
          const active = visiblePages.indexOf(thumbnailPage) !== -1;
          thumbnail.classList.toggle('is-active', active);
          thumbnail.setAttribute('aria-current', active ? 'page' : 'false');
        });
      }

      function setNavigationDisabled(previousDisabled, nextDisabled) {
        previousButton.disabled = previousDisabled;
        nextButton.disabled = nextDisabled;
        toolbarPreviousButton.disabled = previousDisabled;
        toolbarNextButton.disabled = nextDisabled;
      }

      function showPreviousPage() {
        if (viewer) viewer.previous();
      }

      function showNextPage() {
        if (viewer) viewer.next();
      }

      function toggleThumbnails() {
        const open = !thumbnailsPanel.classList.contains('is-open');
        thumbnailsPanel.classList.toggle('is-open', open);
        thumbnailsButton.setAttribute('aria-expanded', String(open));
        thumbnailsButton.setAttribute('aria-label', open ? 'Ẩn ảnh thu nhỏ' : 'Hiện ảnh thu nhỏ');
        if (open) {
          const activeThumbnail = thumbnailsPanel.querySelector('.magazine-thumbnail.is-active');
          if (activeThumbnail) activeThumbnail.scrollIntoView({ block: 'nearest', inline: 'center' });
        }
      }

      function handleThumbnailClick(event) {
        const thumbnail = event.target.closest('.magazine-thumbnail');
        if (!thumbnail || !viewer) return;
        goToPage(Number(thumbnail.dataset.page));
      }

      function goToInputPage() {
        goToPage(Number(currentPageElement.value));
      }

      function goToPage(requestedPage) {
        if (!viewer || !Number.isFinite(requestedPage)) {
          currentPageElement.value = String(currentPage);
          return;
        }
        viewer.goToPage(requestedPage);
      }

      function handlePageInputKeydown(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          goToInputPage();
          currentPageElement.blur();
        }
      }

      function setZoom(nextZoom) {
        if (!viewer || window.matchMedia('(max-width: 767.8px)').matches) return;
        zoomLevel = Math.max(1, Math.min(2, Math.round(nextZoom * 4) / 4));
        stage.classList.toggle('is-zoomed', zoomLevel > 1);
        if (zoomLevel === 1) {
          stage.scrollLeft = 0;
          stage.scrollTop = 0;
        }
        scheduleResize();
        updateControls(currentPage, viewer.getView());
      }

      function handleKeyboardNavigation(event) {
        if (event.target === currentPageElement) return;
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          showNextPage();
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showPreviousPage();
        }
      }

      function calculateBookSize() {
        const stageStyle = window.getComputedStyle(stage);
        const horizontalPadding = parseFloat(stageStyle.paddingLeft) + parseFloat(stageStyle.paddingRight);
        const verticalPadding = parseFloat(stageStyle.paddingTop) + parseFloat(stageStyle.paddingBottom);
        const availableWidth = Math.max(160, stage.clientWidth - horizontalPadding);
        const bookRatio = bookWidth / pageHeight;
        let fittedWidth = Math.min(bookWidth, availableWidth);

        if (isRootFullscreen()) {
          const availableHeight = Math.max(120, stage.clientHeight - verticalPadding);
          fittedWidth = Math.min(fittedWidth, availableHeight * bookRatio);
        }

        return {
          width: Math.max(160, Math.round(fittedWidth * zoomLevel)),
          height: Math.max(100, Math.round((fittedWidth / bookRatio) * zoomLevel))
        };
      }

      function applyBookSize(size) {
        container.style.width = size.width + 'px';
        container.style.height = size.height + 'px';
      }

      function scheduleResize() {
        if (destroyed || !viewer || resizeFrame) return;
        resizeFrame = window.requestAnimationFrame(function() {
          resizeFrame = null;
          if (destroyed || !viewer) return;
          applyBookSize(calculateBookSize());
          viewer.resize();
        });
      }

      function isRootFullscreen() {
        return document.fullscreenElement === root || document.webkitFullscreenElement === root;
      }

      function toggleFullscreen() {
        if (isRootFullscreen()) {
          if (document.exitFullscreen) document.exitFullscreen();
          else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
        } else if (root.requestFullscreen) {
          root.requestFullscreen().catch(function() {});
        } else if (root.webkitRequestFullscreen) {
          root.webkitRequestFullscreen();
        }
      }

      function handleFullscreenChange() {
        const active = isRootFullscreen();
        document.body.style.overflow = active ? 'hidden' : originalBodyOverflow;
        if (fullscreenButton) {
          fullscreenButton.setAttribute('aria-label', active ? 'Thoát toàn màn hình' : 'Xem toàn màn hình');
        }
        scheduleResize();
      }

      function handleSectionUnload(event) {
        if (!event.detail || String(event.detail.sectionId) !== String(flipId)) return;
        cleanup();
      }

      function cleanup() {
        if (destroyed) return;
        destroyed = true;
        if (resizeFrame) window.cancelAnimationFrame(resizeFrame);
        if (resizeObserver) resizeObserver.disconnect();
        window.removeEventListener('resize', scheduleResize);
        document.removeEventListener('fullscreenchange', handleFullscreenChange);
        document.removeEventListener('webkitfullscreenchange', handleFullscreenChange);
        document.removeEventListener('shopify:section:unload', handleSectionUnload);
        document.body.style.overflow = originalBodyOverflow;
        if (viewer) viewer.destroy();
        delete root.dataset.flipbookInitialized;
      }
    }

    function showLoadError(message) {
      const loadingText = root.querySelector('#loading-text-' + flipId);
      const progress = root.querySelector('.progress-bar');
      if (loadingText) loadingText.textContent = message;
      if (progress) progress.hidden = true;
      root.dataset.flipbookInitialized = 'error';
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startWhenReady, { once: true });
    } else {
      startWhenReady();
    }
  })();
</script>

