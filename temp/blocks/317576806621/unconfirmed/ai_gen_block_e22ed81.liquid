{% doc %}
  @prompt
    a section two media with text (Heading, paragraph, button with alignment), two media with text in row , 2 ảnh nằm 1 bên và text 1 bên có thể đổi vị trí giữa text và media
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-media-text-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};padding:{{ block.settings.section_padding }}px}.ai-media-text-{{ ai_gen_id }}__inner{display:grid;grid-template-columns:1fr 1fr;gap:{{ block.settings.media_gap }}px;align-items:{{ block.settings.vertical_alignment }}}.ai-media-text-{{ ai_gen_id }}__media{display:grid;grid-template-columns:1fr 1fr;gap:{{ block.settings.image_gap }}px;min-width:0}.ai-media-text-{{ ai_gen_id }}__image{aspect-ratio:{{ block.settings.image_ratio }};overflow:hidden;background:{{ block.settings.placeholder_color }}}.ai-media-text-{{ ai_gen_id }}__image img,.ai-media-text-{{ ai_gen_id }}__image svg{display:block;width:100%;height:100%;object-fit:cover}.ai-media-text-{{ ai_gen_id }}__image svg{color:{{ block.settings.placeholder_icon_color }}}.ai-media-text-{{ ai_gen_id }}__content{display:flex;flex-direction:column;align-items:{% if block.settings.text_alignment == 'left' %}flex-start{% elsif block.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};text-align:{{ block.settings.text_alignment }};padding:12px}.ai-media-text-{{ ai_gen_id }}__heading{margin:0 0 14px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;line-height:1.15}.ai-media-text-{{ ai_gen_id }}__paragraph{margin:0 0 24px;font-size:{{ block.settings.paragraph_size }}px;line-height:1.6}.ai-media-text-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 24px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};border-radius:{{ block.settings.button_radius }}px;text-decoration:none;font-weight:600}.ai-media-text-{{ ai_gen_id }}__button:hover,.ai-media-text-{{ ai_gen_id }}__button:focus-visible{background:{{ block.settings.button_hover_background }};color:{{ block.settings.button_hover_text_color }}}.ai-media-text-{{ ai_gen_id }}--text-first .ai-media-text-{{ ai_gen_id }}__content{order:-1}@media(max-width:749px){.ai-media-text-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px}.ai-media-text-{{ ai_gen_id }}__inner{grid-template-columns:1fr;gap:{{ block.settings.mobile_gap }}px}.ai-media-text-{{ ai_gen_id }}__content{order:-1!important}.ai-media-text-{{ ai_gen_id }}__heading{font-size:{{ block.settings.mobile_heading_size }}px}}
{% endstyle %}
<div class="ai-media-text-{{ ai_gen_id }} {% if block.settings.text_position == 'first' %}ai-media-text-{{ ai_gen_id }}--text-first{% endif %}" {{ block.shopify_attributes }}><div class="ai-media-text-{{ ai_gen_id }}__inner"><div class="ai-media-text-{{ ai_gen_id }}__media"><div class="ai-media-text-{{ ai_gen_id }}__image">{% if block.settings.image_one %}<img src="{{ block.settings.image_one | image_url: width: 1200 }}" alt="{{ block.settings.image_one.alt | escape }}" loading="lazy">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><div class="ai-media-text-{{ ai_gen_id }}__image">{% if block.settings.image_two %}<img src="{{ block.settings.image_two | image_url: width: 1200 }}" alt="{{ block.settings.image_two.alt | escape }}" loading="lazy">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div></div><div class="ai-media-text-{{ ai_gen_id }}__content">{% if block.settings.heading != blank %}<h2 class="ai-media-text-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.paragraph != blank %}<div class="ai-media-text-{{ ai_gen_id }}__paragraph">{{ block.settings.paragraph | escape | newline_to_br }}</div>{% endif %}{% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-media-text-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}</div></div></div>
{% schema %}{"name":"Two images with text","settings":[{"type":"header","content":"Content"},{"type":"image_picker","id":"image_one","label":"First image"},{"type":"image_picker","id":"image_two","label":"Second image"},{"type":"text","id":"heading","label":"Heading","default":"Designed to be remembered"},{"type":"textarea","id":"paragraph","label":"Paragraph","default":"Discover considered details and timeless materials made for everyday rituals."},{"type":"text","id":"button_label","label":"Button label","default":"Explore collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"text_position","label":"Desktop position","options":[{"value":"first","label":"Text left"},{"value":"last","label":"Media left"}],"default":"last"},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"vertical_alignment","label":"Vertical alignment","options":[{"value":"start","label":"Top"},{"value":"center","label":"Middle"},{"value":"end","label":"Bottom"}],"default":"center"},{"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"1/1","label":"Square"},{"value":"4/5","label":"Portrait"},{"value":"3/2","label":"Landscape"}],"default":"1/1"},{"type":"range","id":"media_gap","label":"Desktop gap","min":0,"max":80,"step":5,"unit":"px","default":25},{"type":"range","id":"image_gap","label":"Image gap","min":0,"max":40,"step":5,"unit":"px","default":10},{"type":"range","id":"mobile_gap","label":"Mobile gap","min":0,"max":50,"step":5,"unit":"px","default":15},{"type":"range","id":"section_padding","label":"Desktop padding","min":0,"max":80,"step":5,"unit":"px","default":25},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":0,"max":40,"step":5,"unit":"px","default":15},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#000000"},{"type":"color","id":"heading_color","label":"Heading","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#d2d2d2"},{"type":"color","id":"placeholder_color","label":"Placeholder","default":"#1a1a1a"},{"type":"color","id":"placeholder_icon_color","label":"Placeholder icon","default":"#d2d2d2"},{"type":"color","id":"button_background","label":"Button background","default":"#fab320"},{"type":"color","id":"button_text_color","label":"Button text","default":"#000000"},{"type":"color","id":"button_hover_background","label":"Button hover background","default":"#ffffff"},{"type":"color","id":"button_hover_text_color","label":"Button hover text","default":"#000000"},{"type":"header","content":"Typography"},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":60,"step":2,"unit":"px","default":36},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":18,"max":40,"step":2,"unit":"px","default":28},{"type":"range","id":"paragraph_size","label":"Paragraph size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":0}],"presets":[{"name":"Two images with text"}],"tag":null,"class":"two-images-with-text"}{% endschema %}