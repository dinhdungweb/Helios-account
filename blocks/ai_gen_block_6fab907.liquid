{% doc %}
  @prompt
    a section image marquee, image marque auto play
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-image-marquee-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; overflow:hidden; background:{{ block.settings.background_color }}; padding:{{ block.settings.vertical_padding }}px 0; }
  .ai-image-marquee-{{ ai_gen_id }}__heading { margin:0 auto {{ block.settings.heading_gap }}px; padding:0 24px; color:{{ block.settings.heading_color }}; font-family:{{ block.settings.heading_font.family }}; font-size:{{ block.settings.heading_size }}px; text-align:center; text-transform:uppercase; letter-spacing:.08em; }
  .ai-image-marquee-{{ ai_gen_id }}__viewport { width:100%; overflow:hidden; }
  .ai-image-marquee-{{ ai_gen_id }}__track { display:flex; width:max-content; gap:{{ block.settings.image_gap }}px; align-items:center; {% if block.settings.autoplay %}animation:ai-image-marquee-{{ ai_gen_id }} {{ block.settings.duration }}s linear infinite;{% endif %} }
  .ai-image-marquee-{{ ai_gen_id }}__item { display:block; flex:0 0 auto; width:{{ block.settings.image_width }}px; aspect-ratio:4/5; overflow:hidden; background:#1b1b1b; }
  .ai-image-marquee-{{ ai_gen_id }}__item img, .ai-image-marquee-{{ ai_gen_id }}__placeholder svg { display:block; width:100%; height:100%; object-fit:cover; }
  .ai-image-marquee-{{ ai_gen_id }}__placeholder { width:100%; height:100%; color:#777; }
  @keyframes ai-image-marquee-{{ ai_gen_id }} { from{transform:translateX(0)} to{transform:translateX(calc(-50% - {{ block.settings.image_gap | divided_by: 2 }}px))} }
  @media screen and (max-width:749px) { .ai-image-marquee-{{ ai_gen_id }} { padding:{{ block.settings.mobile_padding }}px 0; } .ai-image-marquee-{{ ai_gen_id }}__heading { font-size:{{ block.settings.mobile_heading_size }}px; } .ai-image-marquee-{{ ai_gen_id }}__item { width:{{ block.settings.mobile_image_width }}px; } }
  @media (prefers-reduced-motion:reduce) { .ai-image-marquee-{{ ai_gen_id }}__track { animation:none; } }
{% endstyle %}
<image-marquee-{{ ai_gen_id }} class="ai-image-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }} role="region" aria-label="Featured images">
  {% if block.settings.heading != blank %}<h2 class="ai-image-marquee-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  <div class="ai-image-marquee-{{ ai_gen_id }}__viewport"><div class="ai-image-marquee-{{ ai_gen_id }}__track">
    {% for copy in (1..2) %}{% for i in (1..6) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign link_key = 'link_' | append: i
        assign image = block.settings[image_key]
        assign link = block.settings[link_key]
      %}
      {% if image != blank %}
        {% if link != blank %}<a class="ai-image-marquee-{{ ai_gen_id }}__item" href="{{ link }}" aria-label="View featured image {{ i }}">{% else %}<div class="ai-image-marquee-{{ ai_gen_id }}__item">{% endif %}<img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">{% if link != blank %}</a>{% else %}</div>{% endif %}
      {% endif %}
    {% endfor %}{% endfor %}
  </div></div>
</image-marquee-{{ ai_gen_id }}>
<script>(function(){if(!customElements.get('image-marquee-{{ ai_gen_id }}'))customElements.define('image-marquee-{{ ai_gen_id }}',class extends HTMLElement{});})();</script>
{% schema %}
{
  "name":"Image marquee",
  "settings":[
    {"type":"header","content":"Content"},
    {"type":"text","id":"heading","label":"Heading","default":"Featured collection"},
    {"type":"image_picker","id":"image_1","label":"Image 1"},{"type":"url","id":"link_1","label":"Link 1"},
    {"type":"image_picker","id":"image_2","label":"Image 2"},{"type":"url","id":"link_2","label":"Link 2"},
    {"type":"image_picker","id":"image_3","label":"Image 3"},{"type":"url","id":"link_3","label":"Link 3"},
    {"type":"image_picker","id":"image_4","label":"Image 4"},{"type":"url","id":"link_4","label":"Link 4"},
    {"type":"image_picker","id":"image_5","label":"Image 5"},{"type":"url","id":"link_5","label":"Link 5"},
    {"type":"image_picker","id":"image_6","label":"Image 6"},{"type":"url","id":"link_6","label":"Link 6"},
    {"type":"header","content":"Autoplay"},
    {"type":"checkbox","id":"autoplay","label":"Enable autoplay","default":true},
    {"type":"range","id":"duration","label":"Scroll duration","min":10,"max":80,"step":5,"unit":"s","default":35},
    {"type":"header","content":"Style"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"futura_n4"},
    {"type":"color","id":"background_color","label":"Background","default":"#000000"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#f2f2f2"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"image_width","label":"Image width","min":140,"max":420,"step":20,"unit":"px","default":260},
    {"type":"range","id":"mobile_image_width","label":"Mobile image width","min":100,"max":280,"step":20,"unit":"px","default":180},
    {"type":"range","id":"image_gap","label":"Image gap","min":4,"max":40,"step":4,"unit":"px","default":12},
    {"type":"range","id":"heading_size","label":"Heading size","min":12,"max":36,"step":2,"unit":"px","default":18},
    {"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":10,"max":28,"step":2,"unit":"px","default":14},
    {"type":"range","id":"vertical_padding","label":"Vertical padding","min":8,"max":60,"step":4,"unit":"px","default":24},
    {"type":"range","id":"mobile_padding","label":"Mobile padding","min":8,"max":40,"step":4,"unit":"px","default":16},
    {"type":"range","id":"heading_gap","label":"Heading gap","min":8,"max":40,"step":4,"unit":"px","default":16}
  ],
  "presets":[{"name":"Image marquee"}],
  "tag":null,
  "class":"image-marquee-block"
}
{% endschema %}