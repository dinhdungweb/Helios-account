    "something_went_wrong_please_try_again_32c034": "Có lỗi xảy ra. Vui lòng thử lại!",
    "unable_to_create_your_order_please_try_again": "Có lỗi xảy ra khi tạo đơn hàng. Vui lòng thử lại!",
    "select_an_option": "Chọn mục",
    "among_the_four_symbols_the_vermilion_bird_guards_the_south_embod": "Trong Tứ Tượng, Chu Tước trấn giữ phương Nam, gắn với hành Hỏa và hình ảnh của sức sống, chuyển động và nguồn năng lượng mạnh mẽ.",
    "a_fiery_black_opal_sits_on_the_ring_like_an_ember_in_the_night_i": "Trên mặt nhẫn, viên black opal ánh lửa nằm như một đốm cháy trong đêm. Không rực lên một cách ồn ào, mà âm ỉ, sâu và có lực.",
    "wings_clouds_and_movement_shape_the_ring_creating_a_sense_of_ris": "Cấu trúc nhẫn kéo theo nhịp cánh, mây và chuyển động. Tất cả tạo nên cảm giác đang bay lên, nhưng không mất trục.",
    "the_pendant_stretches_like_a_falling_feather_or_a_flame_held_in": "Form mặt dây được kéo dài như một chiếc lông vũ đang rơi, cũng giống một vệt lửa được giữ trong khuôn. Trên thân là lớp cánh, mây và chuyển động; tất cả tạo cảm giác Chu Tước không đứng yên, nhưng cũng không loạn. Nó bay theo trục của mình.",
    "it_embodies_purpose_not_impulse_fire_with_direction": "Không đại diện cho sự bốc đồng. Hỏa có hướng.",
    "enough_heat_to_act_enough_strength_to_transform": "Đủ nhiệt lượng để hành động. đủ mạnh để chuyển hóa",
    "and_enough_clarity_to_leave_an_old_chapter_behind": "và đủ tỉnh táo để bước qua một giai đoạn cũ",
    "while_staying_true_to_yourself": "mà không đánh mất chính mình.",
    "a_unique_flame": "Sắc lửa độc bản",
    "set_between_the_vermilion_bird_s_wings_black_opal_becomes_a_livi": "Đặt giữa đôi cánh Chu Tước, Black Opal trở thành hình ảnh của một ngọn lửa sống: Luôn biến đổi, nhưng không mất phương hướng.",
    "each_ring_carries_its_own_flame_as_unique_as_its_wearer_s_journe": "Mỗi chiếc nhẫn vì thế mang một sắc lửa riêng, độc bản như chính hành trình của người đeo.",
    "no_two_stones_share_the_same_flame_no_two_journeys_leave_the_sam": "Không có hai viên đá cùng một sắc lửa. Cũng không có hai hành trình cùng một dấu ấn.",
    "the_pendant_stretches_like_a_falling_feather_or_a_flame_held_in_36936f": "Form mặt dây được kéo dài như một chiếc lông vũ đang rơi, cũng giống một vệt lửa được giữ trong khuôn. Tất cả tạo cảm giác Chu Tước không đứng yên. Nó bay theo trục của mình.",
    "the_vermilion_bird_s_wings_embrace_the_stone_holding_its_fire_al": "Bao quanh viên đá là lớp cánh Chu Tước ôm lấy phần trung tâm, như cách một người giữ lửa: không để tắt, nhưng cũng không để nó thiêu rụi mọi thứ.",
    "set_between_the_vermilion_bird_s_wings": "Đặt giữa đôi cánh Chu Tước,",
    "black_opal_becomes_a_living_flame_always_changing_yet_never_losi": "Black Opal trở thành hình ảnh của một ngọn lửa sống: Luôn biến đổi, nhưng không mất phương hướng.",
    "we_are_helios": "CHÚNG TÔI LÀ HELIOS!",
    "unique_designs_handcrafted_pieces_each_with_its_own_story": "Thiết kế độc nhất, chế tác thủ công, mỗi tác phẩm là một câu chuyện riêng biệt.",
    "let_your_accessories_complete_your_outfit": "Hãy để phụ kiện là điểm nhấn cuối cùng cho outfit của bạn!",
    "masculine_and_strong": "NAM TÍNH VÀ MẠNH MẼ",
    "bold_and_unique": "TÁO BẠO VÀ ĐỘC NHẤT",
    "composed": "TRẦM ỔN",
    "helios_who_are_we": "HELIOS - CHÚNG TÔI LÀ AI?",
    "founded_in_2016_helios_creates_distinctive_handcrafted_fashion_a": "Thành lập từ năm 2016, Helios là thương hiệu phụ kiện thời trang mang đến những chế tác thủ công độc nhất và khác biệt. Không chỉ đồng hành với người đàn ông trên hành trình khám phá, thể hiện phong cách cá nhân, Helios luôn nỗ lực lan tỏa niềm đam mê và sự yêu thích đối với tác phẩm được làm bởi người Việt, đồng thời đưa tác phẩm ấy vươn ra thế giới một cách mạnh mẽ và đầy tự hào.",
    "strong_bold_unique": "Mạnh mẽ! Táo bạo! Độc nhất!",
    "this_spirit_is_at_the_heart_of_every_helios_product_inspired_by": "Đây là tinh thần cốt lõi Helios luôn hướng đến và thể hiện qua mỗi sản phẩm. Lấy cảm hứng từ những câu chuyện xoay quanh cuộc sống người đàn ông, chúng tôi làm nên các chế tác độc đáo, mang dấu ấn riêng và không thể gặp ở bất cứ đâu.",
    "what_makes_helios": "ĐIỀU GÌ TẠO NÊN HELIOS?",
    "quality": "CHUẨN",
    "driven_by_a_passion_for_handcrafted_jewelry_helios_listens_and_i": "Mang trong mình niềm đam mê với trang sức thủ công, Helios không ngừng lắng nghe và hoàn thiện mình qua từng ngày, từ đó đem tới cho khách hàng trải nghiệm, dịch vụ và sản phẩm CHUẨN cam kết.",
    "character": "CHẤT",
    "drawing_inspiration_from_every_aspect_of_life_we_combine_bold_th": "Khác so với nhiều thương hiệu trên thị trường, chúng tôi lấy cảm hứng từ mọi khía cạnh trong cuộc sống, kết hợp chúng với tư duy táo bạo để tạo nên những sản phẩm độc đáo, mang phong cách mạnh mẽ và chất ngầu.",
    "where_is_helios_heading_in_the_next_five_years": "HÀNH TRÌNH CỦA HELIOS TRONG 5 NĂM TỚI?",
    "devoted_to_pieces_made_by_vietnamese_hands_helios_aims_to_establ": "Tâm huyết với những chế tác được tạo ra từ đôi bàn tay thuần Việt, Helios mong muốn khẳng định giá trị của chúng với cộng đồng quốc tế, đưa mặt hàng vươn ra thế giới một cách mạnh mẽ và đầy tự hào.",
    "inspiration": "NGUỒN CẢM HỨNG",
    "exploring_the_many_facets_of_men_s_lives_helios_seeks_a_symbol_t": "Khai thác những khía cạnh xoay quanh người đàn ông, Helios tìm kiếm một hình ảnh biểu tượng có sự kết nối mạnh mẽ đến câu chuyện của họ.",
    "sketching": "PHÁC THẢO",
    "starting_with_the_central_symbol_our_designers_sketch_the_first": "Dựa trên biểu tượng chủ đạo, đội ngũ thiết kế bắt đầu phác những hình ảnh đầu tiên trên bản vẽ giấy. Đường nét cách điệu cần phải truyền tải đúng tinh thần của ý tưởng, cũng thể hiện dấu ấn đặc trưng chỉ Helios mới có.",
    "3d_modeling": "MÔ HÌNH 3D",
    "our_digital_designers_turn_the_hand_drawn_sketch_into_a_3d_model": "Từ bản phác thảo vẽ tay, nhóm thiết kế kỹ thuật số tạo ra mô hình 3D với sự hỗ trợ của phần mềm đồ họa. Mô hình này sau đó được in phôi 3D với vật liệu lỏng dạng sáp, phục vụ chuyên biệt cho lĩnh vực đúc kim loại. Phôi sáp in xong chính là khuôn mẫu nguyên bản của chế tác.",
    "in_house_silver_workshop": "XƯỞNG BẠC KHÉP KÍN",
    "in_our_workshop_artisans_create_a_mold_from_the_wax_tree_and_pou": "Tại xưởng bạc khép kín, người thợ của Helios tiến hành quy trình tạo khuôn từ cây sáp. Sử dụng bạc S925 cao cấp, đun nóng chảy rồi rót vào khuôn để tạo nên cây bạc, mỗi nhánh tương ứng với một sản phẩm. Khi đã có được cây bạc, lần lượt mỗi nhánh được tách rời,  trải qua các công đoạn mài dũa - đánh bóng - xi đen.",
    "every_step_is_carefully_completed_by_skilled_hands_making_each_p": "Toàn bộ quá trình được thực hiện cẩn thận và tỉ mỉ bằng đôi tay người thợ lành nghề. Vì thế, mỗi sản phẩm là duy nhất, chắc chắn không thể có bản thứ hai giống y hệt.",
    "finishing": "CHẾ TÁC HOÀN THIỆN",
    "once_production_is_complete_our_quality_team_inspects_each_piece": "Khi công đoạn sản xuất đã hoàn thành, bộ phận chất lượng tiến hành kiểm tra và đánh giá từng sản phẩm, đảm bảo cả về mặt nhìn cũng như trải nghiệm thực tế khi sử dụng.",
    "le_thanh_nghi_store": "STORE LÊ THANH NGHỊ",
